<Package xmlns="http://soap.sforce.com/2006/04/metadata">
  <!-- Exists in Production but differs: adds the new design
       (leadSiblingFlags.html/.css) beside the previous one
       (previousDesign.html/.css, unchanged from Production). The "Use new
       design" box on the component in Lightning App Builder picks which one
       everyone sees. It starts unticked, so Production keeps the previous
       design until someone ticks it there. Nothing else is needed: no Apex,
       settings or permissions. Deploys as one bundle. -->
  <types>
    <members>leadSiblingFlags</members>
    <name>LightningComponentBundle</name>
  </types>

  <version>67.0</version>
</Package>
