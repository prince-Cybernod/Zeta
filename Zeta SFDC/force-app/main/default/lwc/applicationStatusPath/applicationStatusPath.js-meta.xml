<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Application Status Path</masterLabel>
    <description
  >Display-only status row for Individual and School Application pages: every status, with the current one lit up in its color (SFR-188).</description>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>IndividualApplication</object>
                <object>AcademicInterest</object>
            </objects>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
