<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Lead Siblings Flags</masterLabel>
    <description
  >Find related Leads, applicants, and enrolled students sharing guardian contact information.</description>
    <targets><target>lightning__RecordPage</target></targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <property
        name="useNewDesign"
        type="Boolean"
        default="false"
        label="Use new design"
        description="Ticked: everyone on this page sees the new design. Unticked: the previous design."
      />
            <objects><object>Lead</object></objects>
            <supportedFormFactors>
                <supportedFormFactor type="Large" />
                <supportedFormFactor type="Small" />
            </supportedFormFactors>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>