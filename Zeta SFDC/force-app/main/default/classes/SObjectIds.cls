/**
 * Utilities for working with {@link SObject} {@link Id}s in Apex.
 */
public with sharing class SObjectIds {
  private static final String FAKE_ID_PATTERN = '000000000000';
  private static Integer fakeIdCount = 0;

  /**
   * Returns the name of the sobject type for the given id.
   *
   * This is intended to be used from a Lightning Web Component that needs to
   * know which type of object is in a variable containing a record id.
   */
  @AuraEnabled(Cacheable=true)
  public static String getSObjectTypeName(Id recordId) {
    if (String.isBlank(recordId)) {
      return null;
    }

    return recordId.getSobjectType().getDescribe().getName();
  }

  /**
   * Collects and returns a list of record ids from the list of sobjects.
   */
  public static List<Id> fromSObjects(List<SObject> sobjects) {
    return fromSObjects(sobjects, SObjectFieldReference.create('Id'));
  }

  /**
   * Collects and returns a list of record ids from the list of sobjects for the given field.
   */
  public static List<Id> fromSObjects(List<SObject> sobjects, SObjectField field) {
    return fromSObjects(sobjects, SObjectFieldReference.create(field));
  }

  /**
   * Collects and returns a list of record ids from the list of sobjects for the given field reference.
   */
  public static List<Id> fromSObjects(List<SObject> sobjects, SObjectFieldReference field) {
    if (SObjectFieldReferenceType.SOBJECT_FIELD.equals(field.getType())) {
      checkIsIdField(field.getSObjectField());
    }

    List<Id> ids = new List<Id>();
    for (SObject sobj : sobjects) {
      Id id = (Id) SObjectFieldPathResolver.getValue(sobj, field.getFieldName());

      if (String.isNotBlank(id)) {
        ids.add(id);
      }
    }

    return ids;
  }

  private static void checkIsIdField(SObjectField field) {
    Set<DisplayType> expectedTypes = new Set<DisplayType>{ DisplayType.ID, DisplayType.REFERENCE };
    DisplayType actualType = field.getDescribe().getType();

    Preconditions.checkArgument(
      expectedTypes.contains(actualType),
      String.format(
        'Expected the field to be of type: {0}. Found: {1}',
        new List<Object>{ expectedTypes, actualType.name() }
      )
    );
  }

  /**
   * Returns a fake id for a specific sobject type.
   *
   * The ids generated by this method will be unique.
   */
  @TestVisible
  private static Id generateFakeId(SObjectType sobjectType) {
    String keyPrefix = SObjectDescribes.get(sobjectType).getKeyPrefix();
    fakeIdCount++;

    String fakeIdBody = FAKE_ID_PATTERN.substring(
      0,
      FAKE_ID_PATTERN.length() - String.valueOf(fakeIdCount).length()
    );

    return Id.valueOf(keyPrefix + fakeIdBody + fakeIdCount);
  }
}