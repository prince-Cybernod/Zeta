    /**
     * Get unique SObjects from Trigger Fields
     * @param triggerFields Comma-separated list of trigger fields
     * @return Set of SObject API names
     */
    public static Set<String> getUniqueSObjectsFromTriggerFields(String triggerFields) {
        Set<String> uniqueSObjects = new Set<String>();

        if (String.isBlank(triggerFields)) {
            return uniqueSObjects;
        }

        // Split the trigger fields by comma
        List<String> fieldPaths = triggerFields.split(',');

        for (String fieldPath : fieldPaths) {
            String trimmedField = fieldPath.trim();

            // Check if the field path contains a dot (indicating a relationship)
            if (trimmedField.contains('.')) {
                List<String> pathParts = trimmedField.split('\\.');
                if (pathParts.size() >= 2) {
                    String objectName = pathParts[0].trim();

                    // Add the object name to the set if it's not empty
                    if (String.isNotBlank(objectName)) {
                        uniqueSObjects.add(objectName);
                    }
                }
            }
        }

        return uniqueSObjects;
    }

    /**
     * Check if a trigger exists for the given SObject
     * @param sObjectName API name of the SObject
     * @return True if a trigger exists, false otherwise
     */
    public static Boolean triggerExists(String sObjectName) {
        if (String.isBlank(sObjectName)) {
            return false;
        }

        // Generate the expected trigger name
        String triggerName = ActionPlanTriggerNameUtil.makeSafeTriggerName(sObjectName);

        // Query for the trigger
        List<ApexTrigger> triggers = [
            SELECT Id, Name
            FROM ApexTrigger
            WHERE Name = :triggerName
            LIMIT 1
        ];

        return !triggers.isEmpty();
    }

    /**
     * Generate trigger code for the given SObject
     * @param sObjectName API name of the SObject
     * @return Generated trigger code
     */
    public static String generateTriggerCode(String sObjectName) {
        if (String.isBlank(sObjectName)) {
            return '';
        }

        // Generate the trigger name
        String triggerName = ActionPlanTriggerNameUtil.makeSafeTriggerName(sObjectName);

        // Instead of using String.format, use direct string replacement
        // to avoid issues with escaping curly braces
        String triggerCode = TRIGGER_TEMPLATE
            .replace('{0}', sObjectName)
            .replace('{1}', triggerName);
        System.debug('triggerCode=' + triggerCode);
        return triggerCode;
    }

    /**
     * Deploy a trigger using the Metadata API
     * This method creates a zip file with the trigger and test class
     * and deploys it using the Metadata API
     * @param sObjectName API name of the SObject
     * @param customTestCode Optional custom test code to use instead of default (can be null)
     * @return MetadataService.AsyncResult The async result of the deployment
     */
    public static MetadataService.AsyncResult deployTriggerWithMetadataApi(String sObjectName, String customTestCode) {
        if (String.isBlank(sObjectName)) {
            return null;
        }

        // Check if the trigger already exists
        if (triggerExists(sObjectName)) {
            return null;
        }

        try {
            // Generate the trigger name and test class name
            String triggerName = ActionPlanTriggerNameUtil.makeSafeTriggerName(sObjectName);
            String testClassName = ActionPlanTriggerNameUtil.makeSafeTestClassName(sObjectName);

            // Generate the trigger code and test class code
            String triggerCode = generateTriggerCode(sObjectName);
            String testClassCode = generateTestClassCode(sObjectName, customTestCode);

            // If user supplied a full custom test class, derive the class name from it
            if (String.isNotBlank(customTestCode) && isFullTestClass(customTestCode)) {
                String declaredClassName = extractClassName(customTestCode);
                if (String.isNotBlank(declaredClassName)) {
                    testClassName = declaredClassName;
                }
            }

            // Generate the package.xml
            String packageXml = generatePackageXml(sObjectName, testClassName);

            // Create a zip file with the trigger and test class
            String zipData = createZipFile(
                triggerName,
                triggerCode,
                TRIGGER_META_TEMPLATE,
                testClassName,
                testClassCode,
                TEST_META_TEMPLATE,
                packageXml
            );

            // Deploy the zip file using the Metadata API
            MetadataService.MetadataPort service = new MetadataService.MetadataPort();
            service.SessionHeader = new MetadataService.SessionHeader_element();
            service.SessionHeader.sessionId = UserInfo.getSessionId();

            MetadataService.DeployOptions deployOptions = new MetadataService.DeployOptions();
            deployOptions.testLevel = 'RunSpecifiedTests';
            deployOptions.runTests = new List<String>{ testClassName };
//            deployOptions.testLevel = 'NoTestRun';
//            deployOptions.runTests = new List<String>{ testClassName };
            deployOptions.allowMissingFiles = false;
            deployOptions.autoUpdatePackage = false;
            deployOptions.checkOnly = false;
            deployOptions.ignoreWarnings = false;
            deployOptions.performRetrieve = false;
            deployOptions.purgeOnDelete = false;
            deployOptions.rollbackOnError = true;
            deployOptions.singlePackage = true;

            return service.deploy(zipData, deployOptions);
        } catch (Exception e) {
            System.debug(LoggingLevel.ERROR, 'Error deploying trigger: ' + e.getMessage());
            return null;
        }
    }


    /**
     * Create a zip file with the trigger and test class
     * @param triggerName Name of the trigger
     * @param triggerCode Trigger code
     * @param triggerMetaXml Trigger meta.xml
     * @param testClassName Name of the test class
     * @param testClassCode Test class code
     * @param testMetaXml Test class meta.xml
     * @param packageXml Package.xml
     * @return String Base64-encoded zip file
     */
    private static String createZipFile(
        String triggerName,
        String triggerCode,
        String triggerMetaXml,
        String testClassName,
        String testClassCode,
        String testMetaXml,
        String packageXml
    ) {
        try {
            // Create a new ZipWriter instance
            Compression.ZipWriter writer = new Compression.ZipWriter();

            // Add package.xml to the zip
            writer.addEntry('package.xml', Blob.valueOf(packageXml));

            // Add trigger file to the zip
            writer.addEntry('triggers/' + triggerName + '.trigger', Blob.valueOf(triggerCode));

            // Add trigger meta.xml to the zip
            writer.addEntry('triggers/' + triggerName + '.trigger-meta.xml', Blob.valueOf(triggerMetaXml));

            // Add test class file to the zip
            writer.addEntry('classes/' + testClassName + '.cls', Blob.valueOf(testClassCode));

            // Add test class meta.xml to the zip
            writer.addEntry('classes/' + testClassName + '.cls-meta.xml', Blob.valueOf(testMetaXml));

            // Generate the zip archive
            Blob zipArchive = writer.getArchive();

            // Return base64 encoded zip file
            return EncodingUtil.base64Encode(zipArchive);
        } catch (Exception e) {
            System.debug(LoggingLevel.ERROR, 'Error creating zip file: ' + e.getMessage());
            return null;
        }
    }

    /**
     * Create and deploy a trigger for the given SObject
     * This method creates a trigger and test class and deploys them using the Metadata API
     * @param sObjectName API name of the SObject
     * @param customTestCode Optional custom test code to use instead of default (can be null)
     * @return Deployment result message
     */
    @AuraEnabled
    @RemoteAction
    public static String createAndDeployTrigger(String sObjectName, String customTestCode) {
        if (String.isBlank(sObjectName)) {
            return 'Error: SObject name is required';
        }

        // Check if the trigger already exists
        if (triggerExists(sObjectName)) {
            return 'Trigger already exists for ' + sObjectName;
        }

        try {
            // Deploy the trigger using the Metadata API
            MetadataService.AsyncResult asyncResult = deployTriggerWithMetadataApi(sObjectName, customTestCode);

            if (asyncResult != null) {
                // Store the async result ID in a custom setting or custom metadata type
                // so we can check the status later

                // Return a success message with the async result ID
                Map<String, Object> response = new Map<String, Object>{
                    'status' => 'deploying',
                    'message' => 'Deploying trigger for ' + sObjectName,
                    'asyncResultId' => asyncResult.id
                };

                return JSON.serialize(response);
            } else {
                // If deployment fails, return an error message
                Map<String, Object> response = new Map<String, Object>{
                    'status' => 'error',
                    'message' => 'Error deploying trigger for ' + sObjectName
                };

                return JSON.serialize(response);
            }
        } catch (Exception e) {
            // If an exception occurs, return an error message
            Map<String, Object> response = new Map<String, Object>{
                'status' => 'error',
                'message' => 'Error deploying trigger: ' + e.getMessage()
            };

            return JSON.serialize(response);
        }
    }

    /**
     * Check the status of a deployment
     * @param asyncResultId ID of the async result
     * @return Deployment status message
     */
    @AuraEnabled
    @RemoteAction
    public static String checkDeployStatus(String asyncResultId) {
        if (String.isBlank(asyncResultId)) {
            return 'Error: Async result ID is required';
        }

        try {
            // Check the deployment status using the Metadata API
            MetadataService.MetadataPort service = new MetadataService.MetadataPort();
            service.SessionHeader = new MetadataService.SessionHeader_element();
            service.SessionHeader.sessionId = UserInfo.getSessionId();

            MetadataService.DeployResult deployResult = service.checkDeployStatus(asyncResultId, true);

            if (deployResult.done) {
                if (deployResult.success) {
                    // If deployment is successful, return a success message
                    Map<String, Object> response = new Map<String, Object>{
                        'status' => 'success',
                        'message' => 'Successfully deployed trigger'
                    };

                    return JSON.serialize(response);
                } else {
                    // If deployment failed, return an error message with comprehensive details
                    List<String> errorMessages = new List<String>();
                    
                    // Extract detailed error information from deployment result
                    if (deployResult.details != null) {
                        // Process component failures
                        if (deployResult.details.componentFailures != null) {
                            for (MetadataService.DeployMessage deployMessage : deployResult.details.componentFailures) {
                                String errorDetail = '';
                                
                                if (String.isNotBlank(deployMessage.componentType)) {
                                    errorDetail += deployMessage.componentType + ' ';
                                }
                                if (String.isNotBlank(deployMessage.fileName)) {
                                    errorDetail += '(' + deployMessage.fileName + ')';
                                }
                                if (deployMessage.lineNumber != null && deployMessage.lineNumber > 0) {
                                    errorDetail += ' Line ' + deployMessage.lineNumber;
                                }
                                if (deployMessage.columnNumber != null && deployMessage.columnNumber > 0) {
                                    errorDetail += ':' + deployMessage.columnNumber;
                                }
                                if (String.isNotBlank(deployMessage.problem)) {
                                    if (String.isNotBlank(errorDetail)) {
                                        errorDetail += ': ';
                                    }
                                    errorDetail += deployMessage.problem;
                                }
                                
                                if (String.isNotBlank(errorDetail)) {
                                    errorMessages.add(errorDetail);
                                }
                            }
                        }
                        
                        // Process run test failures if present
                        if (deployResult.details.runTestResult != null && 
                            deployResult.details.runTestResult.failures != null) {
                            for (MetadataService.RunTestFailure testFailure : deployResult.details.runTestResult.failures) {
                                String testError = 'Test Failure';
                                if (String.isNotBlank(testFailure.name)) {
                                    testError += ' in ' + testFailure.name;
                                }
                                if (String.isNotBlank(testFailure.methodName)) {
                                    testError += '.' + testFailure.methodName + '()';
                                }
                                if (String.isNotBlank(testFailure.message)) {
                                    testError += ': ' + testFailure.message;
                                }
                                if (String.isNotBlank(testFailure.stackTrace)) {
                                    testError += ' | Stack: ' + testFailure.stackTrace;
                                }
                                errorMessages.add(testError);
                            }
                        }
                    }
                    
                    // Build comprehensive error message
                    String finalErrorMessage = 'Deployment failed';
                    if (!errorMessages.isEmpty()) {
                        finalErrorMessage += ':\n• ' + String.join(errorMessages, '\n• ');
                    }
                    
                    // Add additional deployment info if available
                    if (deployResult.id != null) {
                        finalErrorMessage += '\nDeployment ID: ' + deployResult.id;
                    }

                    Map<String, Object> response = new Map<String, Object>{
                        'status' => 'error',
                        'message' => finalErrorMessage
                    };

                    return JSON.serialize(response);
                }
            } else {
                // If deployment is still in progress, return a status message
                Map<String, Object> response = new Map<String, Object>{
                    'status' => 'deploying',
                    'message' => 'Deploying trigger...',
                    'asyncResultId' => asyncResultId
                };

                return JSON.serialize(response);
            }
        } catch (Exception e) {
            // If an exception occurs, return an error message
            Map<String, Object> response = new Map<String, Object>{
                'status' => 'error',
                'message' => 'Error checking deployment status: ' + e.getMessage()
            };

            return JSON.serialize(response);
        }
    }

    /**
     * Generate the package.xml file for deployment
     * @param sObjectName API name of the SObject
     * @return Package.xml content
     */
    public static String generatePackageXml(String sObjectName) {
        if (String.isBlank(sObjectName)) {
            return '';
        }

        String triggerName = ActionPlanTriggerNameUtil.makeSafeTriggerName(sObjectName);
        String testClassName = ActionPlanTriggerNameUtil.makeSafeTestClassName(sObjectName);
        return generatePackageXml(sObjectName, testClassName);
    }

    /**
     * Generate the package.xml file for deployment with an explicit test class name
     * @param sObjectName API name of the SObject
     * @param testClassName The name of the Apex test class to include
     * @return Package.xml content
     */
    public static String generatePackageXml(String sObjectName, String testClassName) {
        if (String.isBlank(sObjectName)) {
            return '';
        }
        String triggerName = ActionPlanTriggerNameUtil.makeSafeTriggerName(sObjectName);

        String packageXml =
            '<?xml version="1.0" encoding="UTF-8"?>\n' +
            '<Package xmlns="http://soap.sforce.com/2006/04/metadata">\n' +
            '    <types>\n' +
            '        <members>' + triggerName + '</members>\n' +
            '        <name>ApexTrigger</name>\n' +
            '    </types>\n' +
            '    <types>\n' +
            '        <members>' + testClassName + '</members>\n' +
            '        <name>ApexClass</name>\n' +
            '    </types>\n' +
            '    <version>59.0</version>\n' +
            '</Package>';

        return packageXml;
    }

