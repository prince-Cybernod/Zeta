    /**
     * Generate the test class code for the trigger with optional custom test code
     * @param sObjectName API name of the SObject
     * @param customTestCode Optional custom test code to include (if null, uses default TestDataFactory approach)
     * @return Test class code
     */
    public static String generateTestClassCode(String sObjectName, String customTestCode) {
        if (String.isBlank(sObjectName)) {
            return '';
        }

        String triggerName = ActionPlanTriggerNameUtil.makeSafeTriggerName(sObjectName);
        String safeClassName = ActionPlanTriggerNameUtil.makeSafeTestClassName(sObjectName);
        String testClassCode;
        
        if (String.isNotBlank(customTestCode)) {
            // Check if customTestCode is a full class or just method body code
            if (isFullTestClass(customTestCode)) {
                // User provided a complete test class, use it directly
                testClassCode = customTestCode;
            } else {
                // Use custom test code template with provided method body code
                String insertTestCode = customTestCode;
                String deleteTestCode = customTestCode;
                
                testClassCode = CUSTOM_TRIGGER_TEST_TEMPLATE
                    .replace('{0}', sObjectName)
                    .replace('{1}', triggerName)
                    .replace('{2}', insertTestCode)
                    .replace('{3}', deleteTestCode)
                    .replace('{className}', safeClassName);
            }
        } else {
            // Use default template with basic SObject placeholder
            String basicPlaceholder = generateBasicSObjectPlaceholder(sObjectName);
            
            testClassCode = TRIGGER_TEST_TEMPLATE
                .replace('{0}', sObjectName)
                .replace('{1}', triggerName)
                .replace('{className}', safeClassName);
        }
        
        System.debug('testClassCode=' + testClassCode);
        return testClassCode;
    }

    /**
     * Check if the provided custom test code is a full test class or just method body code
     * @param customTestCode The custom test code to analyze
     * @return True if it's a full test class, false if it's just method body code
     */
    private static Boolean isFullTestClass(String customTestCode) {
        if (String.isBlank(customTestCode)) {
            return false;
        }
        
        String trimmedCode = customTestCode.trim();
        
        // A more robust check for a full class declaration:
        // Must contain 'class ' and '{', and should ideally contain an access modifier or @isTest
        // We also want to make sure 'class' is not just in a comment.
        Boolean hasClassKeyword = Pattern.compile('(?i)\\bclass\\b').matcher(trimmedCode).find();
        Boolean hasOpeningBrace = trimmedCode.contains('{');
        Boolean hasClassDeclaration = hasClassKeyword && hasOpeningBrace;
        
        // Look for method declarations or class-level indicators
        Boolean hasMethodDeclarations = Pattern.compile('(?i)\\bvoid\\b').matcher(trimmedCode).find();
        
        // If it has extractable class name using our improved regex, it's definitely a full class
        if (extractClassName(customTestCode) != null && hasOpeningBrace) {
            return true;
        }
        
        // Fallback for very simple classes
        if (hasClassDeclaration && hasMethodDeclarations) {
            return true;
        }
        
        return false;
    }

    /**
     * Extract the declared class name from Apex source code.
     * Returns null if not found.
     */
    private static String extractClassName(String apexCode) {
        if (String.isBlank(apexCode)) {
            return null;
        }
        try {
            // Use a regex that specifically looks for class declarations, ignoring comments.
            // We look for optional modifiers followed by 'class' and the class name.
            // Using (?m) for multiline mode to allow anchoring if needed, but here we focus on
            // ensuring we don't match 'class' inside a comment like '/* class for ... */'
            // We'll search for the first occurrence of 'class' that isn't preceded by common comment markers on the same line,
            // but a better way in Apex is to look for modifiers.
            String regex = '(?i)(?:public|private|global|virtual|abstract|@isTest)\\s+(?:(?:public|private|global|virtual|abstract|@isTest)\\s+)*class\\s+([A-Za-z_][A-Za-z0-9_]*)';
            Pattern p = Pattern.compile(regex);
            Matcher m = p.matcher(apexCode);
            if (m.find()) {
                return m.group(1);
            }
            
            // Fallback to simpler regex if no modifiers found, but try to avoid comments by ensuring it's at start of line
            Pattern pFallback = Pattern.compile('(?m)^\\s*class\\s+([A-Za-z_][A-Za-z0-9_]*)');
            Matcher mFallback = pFallback.matcher(apexCode);
            if (mFallback.find()) {
                return mFallback.group(1);
            }
        } catch (Exception e) {
            // Swallow and return null; parsing is best-effort.
            return null;
        }
        return null;
    }

