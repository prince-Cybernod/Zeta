        }
        
        return placeholder;
    }

    /**
     * Get SObject information for display
     * @param sObjectName API name of the SObject
     * @return Map with SObject information
     */
    public static Map<String, Object> getSObjectInfo(String sObjectName) {
        Map<String, Object> result = new Map<String, Object>{
            'name' => sObjectName,
            'label' => '',
            'triggerExists' => false,
            'triggerStatus' => 'Missing',
            'safeTriggerName' => ActionPlanTriggerNameUtil.makeSafeTriggerName(sObjectName),
            'safeTestClassName' => ActionPlanTriggerNameUtil.makeSafeTestClassName(sObjectName)
        };

        if (String.isBlank(sObjectName)) {
            return result;
        }

        try {
            // Get the SObject describe result
            Schema.DescribeSObjectResult describeResult = Schema.getGlobalDescribe().get(sObjectName).getDescribe();

            // Update the result with the SObject information
            result.put('label', describeResult.getLabel());
            
            // Check for the trigger and get its status
            String expectedName = ActionPlanTriggerNameUtil.makeSafeTriggerName(sObjectName);
            List<ApexTrigger> triggers = [SELECT Id, Name, Status FROM ApexTrigger WHERE Name = :expectedName LIMIT 1];
            
            if (!triggers.isEmpty()) {
                result.put('triggerExists', true);
                result.put('triggerStatus', triggers[0].Status);
            } else {
                result.put('triggerExists', false);
                result.put('triggerStatus', 'Missing');
            }

            return result;
        } catch (Exception e) {
            // If the SObject doesn't exist, return the default result
            return result;
        }
    }
}