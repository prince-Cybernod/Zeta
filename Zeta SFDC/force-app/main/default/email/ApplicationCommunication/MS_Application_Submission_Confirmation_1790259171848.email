                   <tbody>
                    <tr>
                     <td style="font-family: Arial, Helvetica, sans-serif;"><p style="line-height:1.38; margin-top:16px; margin-bottom:16px"><span style="font-family:Tahoma,Arial,Helvetica,sans-serif;"><a href="https://zetaschools.org/events-for-prospective-families/" style="text-decoration:none"><span style="font-size:11pt; font-variant:normal; white-space:pre-wrap"><span style="color:#1155cc"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:underline"><span style="text-decoration-skip-ink:none">Come visit us at Zeta</span></span></span></span></span></span></a><span style="font-size:11pt; font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none"> and experience what could be possible for your student here.&nbsp;</span></span></span></span></span></span></p><p style="line-height:1.38; margin-bottom:16px"><span style="font-family:Tahoma,Arial,Helvetica,sans-serif;"><span style="font-size:11pt; font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">Thank you again for your interest in Zeta Middle School. We look forward to continuing this journey with you and your family.</span></span></span></span></span></span></p><p style="line-height:1.38; margin-bottom:32px"><span style="font-family:Tahoma,Arial,Helvetica,sans-serif;"><span style="font-size:11pt; font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">Warmly,</span></span></span></span></span><br /><span style="font-size:11pt; font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:700"><span style="font-style:normal"><span style="text-decoration:none">The Zeta Enrollment Team</span></span></span></span></span><br /><span style="font-size:11pt; font-variant:normal; white-space:pre-wrap"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">Zeta Charter Schools</span></span></span></span></span></span></p></td>
