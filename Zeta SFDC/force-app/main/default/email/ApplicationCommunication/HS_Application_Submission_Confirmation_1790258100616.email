                   <tbody>
                    <tr>
                     <td style="font-family: Arial, Helvetica, sans-serif;"><p style="line-height:1.38; margin-top:16px; margin-bottom:16px"><span style="font-size:14px;"><span style="font-family:Tahoma,Arial,Helvetica,sans-serif;"><a href="https://zetaschools.org/events-for-prospective-families/" style="text-decoration:none"><span style="font-variant: normal; white-space: pre-wrap;"><span style="color:#1155cc"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:underline"><span style="text-decoration-skip-ink:none">Sign up for a tour</span></span></span></span></span></span></a><span style="font-variant: normal; white-space: pre-wrap;"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none"> to experience Zeta High yourself.&nbsp;</span></span></span></span></span></span></span></p><p style="line-height:1.38; margin-top:16px; margin-bottom:16px"><span style="font-size:14px;"><span style="font-family:Tahoma,Arial,Helvetica,sans-serif;"><span style="font-variant: normal; white-space: pre-wrap;"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">🎥 </span></span></span></span></span><a href="https://www.instagram.com/reels/DS5uEsjDBg0/" style="text-decoration:none"><span style="color:#8e44ad;"><span style="font-variant: normal; white-space: pre-wrap;"><span style="font-weight:700"><span style="font-style:normal"><span style="text-decoration:underline"><span style="text-decoration-skip-ink:none">Our students are waiting for you!</span></span></span></span></span></span></a></span></span></p><p style="line-height:1.38; margin-top:16px; margin-bottom:16px"><span style="font-size:14px;"><span style="font-family:Tahoma,Arial,Helvetica,sans-serif;"><span style="font-variant: normal; white-space: pre-wrap;"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">We can't wait to continue this journey with you and your family.&nbsp;</span></span></span></span></span></span></span></p><p style="line-height:1.38; margin-bottom:32px"><span style="font-size:14px;"><span style="font-family:Tahoma,Arial,Helvetica,sans-serif;"><span style="font-variant: normal; white-space: pre-wrap;"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">Warmly,</span></span></span></span></span><br /><span style="font-variant: normal; white-space: pre-wrap;"><span style="color:#000000"><span style="font-weight:700"><span style="font-style:normal"><span style="text-decoration:none">The Zeta Enrollment Team</span></span></span></span></span><br /><span style="font-variant: normal; white-space: pre-wrap;"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">Zeta Charter Schools</span></span></span></span></span></span></span></p></td>
