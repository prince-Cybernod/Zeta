<?xml version="1.0" encoding="UTF-8"?>
<UserAccessPolicy xmlns="http://soap.sforce.com/2006/04/metadata">
    <booleanFilter>1</booleanFilter>
    <description>Auto-assign the “Zeta System Admins” Permission Set Group when a user’s profile is System Administrator. Revoke the PSG if the profile changes.</description>
    <masterLabel>Zeta — Assign System Admin PSG</masterLabel>
    <order>1</order>
    <status>Active</status>
    <triggerType>CreateAndUpdate</triggerType>
    <userAccessPolicyActions>
        <action>Grant</action>
        <target>Zeta_System_Admins</target>
        <type>PermissionSetGroup</type>
    </userAccessPolicyActions>
    <userAccessPolicyFilters>
        <operation>equals</operation>
        <sortOrder>1</sortOrder>
        <target>admin</target>
        <type>Profile</type>
    </userAccessPolicyFilters>
</UserAccessPolicy>
