    <description>All leads (open and closed) by owner and source</description>
    <filter>
        <booleanFilter>2 AND (1 OR 3)</booleanFilter>
        <criteriaItems>
            <column>STATUS</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>,Closed – Converted,&quot;Closed – Not Converted, Next Year&quot;,&quot;Closed – Not Converted, Archived&quot;,&quot;Closed – Duplicate, Archived&quot;</value>
        </criteriaItems>
        <criteriaItems>
            <column>Lead.Lead_Source__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value>Outreach – Community Event (We Host),Outreach – Community Event (We Attend),Outreach – Pizza Party,Outreach – CBO Tabling,Outreach – School/ After-School Dismissal,Outreach – Hotspot,Outreach – Sign Up Sheet,Account Created – No Application,Call Campaign – Former Waitlisted,Call Campaign – Former Rescinded,Call Campaign – Former Withdrawn/Declined</value>
        </criteriaItems>
        <criteriaItems>
            <column>Lead.Email_Only_Lead__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>1</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>OWNER</field>
