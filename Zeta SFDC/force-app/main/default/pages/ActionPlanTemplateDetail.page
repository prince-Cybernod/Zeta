<apex:page id="thePage"
	tabStyle="ActionPlanTemplate__c"
	standardController="ActionPlanTemplate__c"
	extensions="ActionPlanTemplateDetailController"
	lightningStylesheets="true"
	docType="html-5.0"
	action="{!onLoad}"
	contentType="text/html">
	<apex:includeScript value="{!URLFOR($Resource.ActionPlan_Resources, 'js/jquery.min.js')}" />
	<apex:includeScript value="{!URLFOR($Resource.ActionPlan_Resources, 'js/ActionPlans_Scripts.js')}" />
	<apex:includeScript value="{!URLFOR($Resource.ActionPlan_Resources, 'js/jquery.tablesorter.min.js')}" />
	<script type="text/javascript">
		var j$ = jQuery.noConflict();
		j$(document).ready(function () {
			j$('[Id$=theTable]').tablesorter({ headerTemplate: '{content}' });
			j$('.helpOrb').css('width', '12px').css('height', '12px');
			console.log('document ready');
		});
	</script>
	<!-- 	<style>
	.helpOrb{
			width: 12px;
			height: 12px;
		}
		</style> -->

	<c:APSectionHeader sObjType="ActionPlanTemplate__c" subtitle="{!$ObjectType.ActionPlanTemplate__c.label}" title="{!ActionPlanTemplate__c.Name}" />

	<apex:form id="detailForm">
		<apex:pageBlock id="templateDetail" title="" mode="detail">
			<apex:pageBlockButtons id="buttons" location="top">
				<apex:commandButton id="edit"
					action="{!$Page.ActionPlanTemplateCreation}?id={!ActionPlanTemplate__c.Id}&retURL={!$CurrentPage.URL}"
					value="{!$Label.ap_Edit}"
					rendered="{!$ObjectType.ActionPlanTemplate__c.updateable}" />
				<apex:commandButton id="delete"
					action="{!deleteTemplate}"
					value="Delete"
					onclick="return confirm('{!$Label.ap_AreYouSureAsk}');"
					rendered="{!$ObjectType.ActionPlanTemplate__c.deletable}" />
				<apex:commandButton id="clone"
					action="{!$Page.ActionPlanTemplateCreation}?clone=1&templateId={!ActionPlanTemplate__c.Id}"
					value="{!$Label.ap_Clone}"
					rendered="{!$ObjectType.ActionPlanTemplate__c.createable}" />
				<apex:commandButton id="share"
					action="/p/share/CustomObjectSharingDetail?parentId={!ActionPlanTemplate__c.Id}"
					value="{!$Label.ap_Sharing}"
					rendered="{!$ObjectType.ActionPlanTemplate__c.updateable && canShare}" />
				<apex:commandButton id="newActionPlan"
					action="{!$Page.ActionPlanCreation}?templateId={!ActionPlanTemplate__c.Id}"
					value="{!$Label.ap_New} {!$ObjectType.ActionPlan__c.label}"
					rendered="{!$ObjectType.ActionPlan__c.createable}" />
				<apex:commandButton id="export"
					action="{!$Page.ActionPlanTemplateExport}?Id={!ActionPlanTemplate__c.Id}"
					value="{!$Label.ap_Export}"
					rendered="{!$Permission.Action_Plan_Template_Export}" />
			</apex:pageBlockButtons>

				<apex:pageBlockSection columns="2" collapsible="false">
					<apex:outputField value="{!ActionPlanTemplate__c.Name}" />
					<apex:pageBlockSectionItem >
						<apex:outputLabel value="{!$Label.ap_Owner}" />
						<apex:outputPanel >
							<apex:outputField value="{!ActionPlanTemplate__c.OwnerId}" />
							<apex:outputPanel rendered="{!$ObjectType.ActionPlanTemplate__c.updateable && canTransfer}">
								&nbsp;[
								<apex:commandLink action="{!$Page.ActionPlanAPTOwnerChange}?id={!ActionPlanTemplate__c.Id}">{!$Label.ap_Change}</apex:commandLink>
							</apex:outputPanel>
						</apex:outputPanel>
					</apex:pageBlockSectionItem>
					
					<apex:outputField value="{!ActionPlanTemplate__c.Description__c}" />
					<apex:outputField value="{!ActionPlanTemplate__c.Type__c}" />

					
					<apex:pageBlockSectionItem >
						<apex:outputLabel value="{!$ObjectType.ActionPlanTemplate__c.fields.Fallback_Queue__c.label}" />
						<apex:outputPanel >
							<apex:outputPanel rendered="{!NOT(ISBLANK(fallbackQueueName))}">
								<apex:outputLink value="/lightning/setup/Queues/page?address=%2Fp%2Fown%2FQueue%2Fd%3Fid%3D{!ActionPlanTemplate__c.Fallback_Queue__c}" target="_blank">
									{!fallbackQueueName}
								</apex:outputLink>
							</apex:outputPanel>
							<apex:outputPanel rendered="{!ISBLANK(fallbackQueueName)}">
								<apex:outputText value="--None--" />
							</apex:outputPanel>
						</apex:outputPanel>
					</apex:pageBlockSectionItem>
					
					<apex:outputField value="{!ActionPlanTemplate__c.TaskRecordTypeID__c}" rendered="false" />
					<!-- <apex:pageBlockSectionItem /> -->
					<apex:outputField value="{!ActionPlanTemplate__c.Archived__c}" />

				<apex:outputField value="{!ActionPlanTemplate__c.SkipWeekends__c}" />
				<apex:pageBlockSectionItem rendered="{!taskHasRecordType}">
					<apex:outputLabel value="{!$ObjectType.ActionPlanTemplate__c.fields.TaskRecordTypeID__c.label}" />
					<apex:outputText value="{!recordTypeName}" />
				</apex:pageBlockSectionItem>
				<apex:pageBlockSectionItem rendered="{!NOT(taskHasRecordType)}" />

				<apex:outputField value="{!ActionPlanTemplate__c.SkipDay__c}" rendered="{!ActionPlanTemplate__c.SkipWeekends__c}" />
			</apex:pageBlockSection>
            
            <apex:pageBlockSection title="Dynamic Record Selection" columns="1" collapsible="false" 
                rendered="{!NOT(ISBLANK(ActionPlanTemplate__c.Target_Object_API_Name__c)) || NOT(ISBLANK(ActionPlanTemplate__c.Where_Clause__c))}">
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="{!$ObjectType.ActionPlanTemplate__c.fields.Target_Object_API_Name__c.label}" />
                    <apex:outputField value="{!ActionPlanTemplate__c.Target_Object_API_Name__c}" />
                </apex:pageBlockSectionItem>
                
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="{!$ObjectType.ActionPlanTemplate__c.fields.Where_Clause__c.label}" />
                    <apex:outputField value="{!ActionPlanTemplate__c.Where_Clause__c}" />
                </apex:pageBlockSectionItem>
                
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="{!$ObjectType.ActionPlanTemplate__c.fields.Trigger_Fields__c.label}" />
                    <apex:outputField value="{!ActionPlanTemplate__c.Trigger_Fields__c}" />
                </apex:pageBlockSectionItem>
                
            </apex:pageBlockSection>
            
            <!-- Trigger Handlers Section -->
            <apex:pageBlockSection title="Trigger Handlers" columns="1" collapsible="false" 
                rendered="{!triggerFieldSObjects.size > 0}">
                
                <apex:pageBlockTable value="{!triggerFieldSObjects}" var="sObj" styleClass="slds-table slds-table_bordered" style="width: 100%">
                    <apex:column headerValue="SObject" style="width: 30%">
                        <apex:outputText value="{!sObj['label']} ({!sObj['name']})" />
                        <div style="font-size: 10px; color: #706e6b;">
                            Trigger: {!sObj['safeTriggerName']}<br/>
                            Test: {!sObj['safeTestClassName']}
                        </div>
                    </apex:column>
                    
                    <apex:column headerValue="Trigger Status" style="width: 30%">
                        <apex:outputPanel rendered="{!sObj['triggerExists']}">
                            <span style="color: {!IF(sObj['triggerStatus'] == 'Active', 'green', 'orange')}; font-weight: bold;">
                                <apex:outputText value="✓ Trigger Exists ({!sObj['triggerStatus']})" />
                            </span>
                        </apex:outputPanel>
                        <apex:outputPanel rendered="{!!sObj['triggerExists']}">
                            <span style="color: red; font-weight: bold;">
                                <apex:outputText value="✗ {!sObj['triggerStatus']}" />
                            </span>
                        </apex:outputPanel>
                    </apex:column>
                    
                    <apex:column headerValue="Actions" style="width: 40%">
                        <apex:outputPanel rendered="{!!sObj['triggerExists']}">
                            <apex:commandButton value="Deploy Trigger"
                                onclick="generateTrigger('{!sObj['name']}'); return false;" 
                                styleClass="slds-button slds-button_brand" 
                                style="margin-right: 10px;" />
                            <br/>
                            <div style="margin-top: 8px;">
                                <apex:inputCheckbox onchange="toggleCustomTestArea('{!sObj['name']}', this, '{!sObj['safeTriggerName']}', '{!sObj['safeTestClassName']}');" />
                                <apex:outputLabel value=" Use custom test class" style="margin-left: 5px; font-size: 12px;" />
                            </div>
                            
                            <!-- Per-row Custom Test Code Area -->
                            <div id="customTestArea_{!sObj['name']}" style="display: none; margin-top: 10px; padding: 8px; background-color: #f8f9fa; border: 1px solid #e1e5e9; border-radius: 4px;">
                                <apex:outputLabel value="Custom Test Code:" style="font-weight: bold; display: block; margin-bottom: 5px; font-size: 11px;" />
                                <apex:inputTextarea rows="10" 
                                    cols="60" 
                                    style="width: 100%; font-family: 'Courier New', monospace; font-size: 11px;" />
                                <div style="font-size: 10px; color: #666; margin-top: 3px;">
                                    Provide a <strong>full test class</strong> (including <code>@IsTest</code>, <code>private class...</code>). 
                                    The class MUST be named <code>{!sObj['safeTestClassName']}</code>.
                                </div>
                            </div>
                        </apex:outputPanel>
                    </apex:column>
                </apex:pageBlockTable>
                
                <!-- Trigger Deployment Information -->
                <apex:pageBlockSectionItem >
                    <apex:outputPanel >
                        <div style="background-color: #f4f6f9; border: 1px solid #d8dde6; border-radius: 4px; padding: 12px; margin-top: 10px;">
                            <div id="triggerDeploymentHeader" onclick="toggleTriggerDeploymentInfo()" style="cursor: pointer; display: flex; align-items: center; justify-content: space-between;">
                                <h3 style="margin: 0; font-size: 14px; font-weight: bold; color: #16325c;">About Trigger Deployment</h3>
                                <span id="triggerDeploymentChevron" style="font-size: 12px; color: #16325c; transform: rotate(0deg); transition: transform 0.2s;">▼</span>
                            </div>
                            <div id="triggerDeploymentContent" style="display: none; font-size: 13px; line-height: 1.5; color: #3e3e3c; margin-top: 8px;">
                                <p><strong>Automatic Testing:</strong> When you deploy a trigger, the system will automatically attempt to test it using generated test classes. If automatic testing fails, you'll need to create and run tests manually.</p>
                                
                                <p><strong>Generated Trigger Example:</strong></p>
                                <pre style="background-color: #f8f9fa; border: 1px solid #e1e5e9; padding: 8px; font-size: 12px; margin: 4px 0;">trigger APAccount on Account (after insert, after update) {
    // Call the Action Plan Trigger Utility to handle action plan creation
    ActionPlanTriggerUtility.invoke(Account.SObjectType);
}</pre>
                                
                                <p><strong>Manual Test Class Example:</strong></p>
                                <pre style="background-color: #f8f9fa; border: 1px solid #e1e5e9; padding: 8px; font-size: 12px; margin: 4px 0;">@IsTest
private class APAccountT {
    @IsTest
    private static void insertAndUpdate_bulk_doesNotError() {
        List&lt;SObject&gt; records = TestDataFactory.makeList('Account', 5, new Map&lt;String, Object&gt;());
        
        Test.startTest();
        // Perform a benign update to exercise update trigger
        update records;
        Test.stopTest();
        
        System.assert(true, 'Trigger executed without unhandled exceptions.');
    }
}</pre>
                                
                                <p><strong>Key Considerations:</strong></p>
                                <ul style="margin: 4px 0; padding-left: 20px;">
                                    <li>Generated triggers use ActionPlanTriggerUtility.invoke() to handle action plan creation</li>
                                    <li>Test classes use TestDataFactory for data creation - ensure your org has sufficient test data setup</li>
                                    <li>If TestDataFactory fails to create required fields, you may need to customize the test class</li>
                                    <li>Triggers are deployed to after insert and after update events only</li>
                                    <li>Manual deployment via Salesforce CLI may be required if automatic deployment fails</li>
                                    <li>Ensure proper code coverage (75%+) for production deployments</li>
                                </ul>
                            </div>
                        </div>
                    </apex:outputPanel>
                </apex:pageBlockSectionItem>
                
                <script type="text/javascript">
                    // Global variable to store the async result ID
                    var deploymentAsyncResultId = null;
                    // Global variable to store the interval ID for polling
                    var deploymentStatusInterval = null;
                    // Global variable to store the sObject name being deployed
                    var currentDeployingSObject = null;
                    
                    // Function to toggle the trigger deployment information section
                    function toggleTriggerDeploymentInfo() {
                        var content = document.getElementById('triggerDeploymentContent');
                        var chevron = document.getElementById('triggerDeploymentChevron');
                        
                        if (content.style.display === 'none' || content.style.display === '') {
                            content.style.display = 'block';
                            chevron.style.transform = 'rotate(180deg)';
                        } else {
                            content.style.display = 'none';
                            chevron.style.transform = 'rotate(0deg)';
                        }
                    }
                    
                    // Function to toggle the custom test area visibility for specific SObject
                    function toggleCustomTestArea(sObjectName, checkbox, safeTriggerName, safeTestClassName) {
                        // Find the custom test area div by looking for the one with the sObjectName in the id
                        var customTestArea = document.getElementById('customTestArea_' + sObjectName);
                        
                        // Find the textarea within the custom test area
                        var customTestCode = null;
                        if (customTestArea) {
                            customTestCode = customTestArea.querySelector('textarea');
                        }
                        
                        if (checkbox && customTestArea) {
                            if (checkbox.checked) {
                                customTestArea.style.display = 'block';
                                
                                // Populate with SObject-specific placeholder code if empty
                                if (customTestCode && (!customTestCode.value || customTestCode.value.trim() === '')) {
                                    customTestCode.value = generatePlaceholderCode(sObjectName, safeTriggerName, safeTestClassName);
                                }
                            } else {
                                customTestArea.style.display = 'none';
                            }
                        }
                    }
                    
                    // Function to generate SObject-specific placeholder code - Full Test Class
                    function generatePlaceholderCode(sObjectName, safeTriggerName, safeTestClassName) {
                        var testClassName = safeTestClassName || (sObjectName + 'ActionPlanTrigger_T');
                        var triggerName = safeTriggerName || (sObjectName + 'ActionPlanTrigger');
                        var placeholder = '/**\n' +
                                        ' * Test class for ' + triggerName + '\n' +
                                        ' * Auto-generated by Action Plans with custom test code\n' +
                                        ' */\n' +
                                        '@IsTest\n' +
                                        'private class ' + testClassName + ' {\n' +
                                        '  @TestSetup\n' +
                                        '  static void setup() {\n' +
                                        '    // Setup test data if needed\n' +
                                        '  }\n' +
                                        '\n' +
                                        '  @IsTest\n' +
                                        '  private static void insertAndUpdate_bulk_doesNotError() {\n';
                        
                        if (sObjectName === 'Account') {
                            placeholder += '    // Create test Account records\n' +
                                         '    List<SObject> records = new List<Account>{\n' +
                                         '        new Account(Name = \'Test Account 1\'),\n' +
                                         '        new Account(Name = \'Test Account 2\'),\n' +
                                         '        new Account(Name = \'Test Account 3\')\n' +
                                         '    };\n' +
                                         '    insert records;\n';
                        } else if (sObjectName === 'Contact') {
                            placeholder += '    // Create test Contact records\n' +
                                         '    List<SObject> records = new List<Contact>{\n' +
                                         '        new Contact(FirstName = \'Test\', LastName = \'Contact 1\'),\n' +
                                         '        new Contact(FirstName = \'Test\', LastName = \'Contact 2\'),\n' +
                                         '        new Contact(FirstName = \'Test\', LastName = \'Contact 3\')\n' +
                                         '    };\n' +
                                         '    insert records;\n';
                        } else if (sObjectName === 'Opportunity') {
                            placeholder += '    // Create test Opportunity records\n' +
                                         '    List<SObject> records = new List<Opportunity>{\n' +
                                         '        new Opportunity(Name = \'Test Opp 1\', StageName = \'Prospecting\', CloseDate = Date.today()),\n' +
                                         '        new Opportunity(Name = \'Test Opp 2\', StageName = \'Prospecting\', CloseDate = Date.today()),\n' +
                                         '        new Opportunity(Name = \'Test Opp 3\', StageName = \'Prospecting\', CloseDate = Date.today())\n' +
                                         '    };\n' +
                                         '    insert records;\n';
                        } else if (sObjectName === 'Case') {
                            placeholder += '    // Create test Case records\n' +
                                         '    List<SObject> records = new List<Case>{\n' +
                                         '        new Case(Subject = \'Test Case 1\', Origin = \'Phone\'),\n' +
                                         '        new Case(Subject = \'Test Case 2\', Origin = \'Email\'),\n' +
                                         '        new Case(Subject = \'Test Case 3\', Origin = \'Web\')\n' +
                                         '    };\n' +
                                         '    insert records;\n';
                        } else {
                            // Generic placeholder for other SObjects
                            placeholder += '    // Create test ' + sObjectName + ' records\n' +
                                         '    List<SObject> records = new List<' + sObjectName + '>{\n' +
                                         '        new ' + sObjectName + '(),\n' +
                                         '        new ' + sObjectName + '(),\n' +
                                         '        new ' + sObjectName + '()\n' +
                                         '    };\n' +
                                         '    // TODO: Set required fields for ' + sObjectName + '\n' +
                                         '    insert records;\n';
                        }
                        
                        placeholder += '\n' +
                                     '    Test.startTest();\n' +
                                     '    // Perform a benign update to exercise update trigger\n' +
                                     '    update records;\n' +
                                     '    Test.stopTest();\n' +
                                     '\n' +
                                     '    System.assert(true, \'Trigger executed without unhandled exceptions.\');\n' +
                                     '  }\n' +
                                     '\n' +
                                     '  @IsTest\n' +
                                     '  private static void delete_bulk_doesNotError() {\n';
                        
                        if (sObjectName === 'Account') {
                            placeholder += '    // Create test Account records for deletion\n' +
                                         '    List<SObject> records = new List<Account>{\n' +
                                         '        new Account(Name = \'Test Account 1\'),\n' +
                                         '        new Account(Name = \'Test Account 2\'),\n' +
                                         '        new Account(Name = \'Test Account 3\')\n' +
                                         '    };\n' +
                                         '    insert records;\n';
                        } else if (sObjectName === 'Contact') {
                            placeholder += '    // Create test Contact records for deletion\n' +
                                         '    List<SObject> records = new List<Contact>{\n' +
                                         '        new Contact(FirstName = \'Test\', LastName = \'Contact 1\'),\n' +
                                         '        new Contact(FirstName = \'Test\', LastName = \'Contact 2\'),\n' +
                                         '        new Contact(FirstName = \'Test\', LastName = \'Contact 3\')\n' +
                                         '    };\n' +
                                         '    insert records;\n';
                        } else if (sObjectName === 'Opportunity') {
                            placeholder += '    // Create test Opportunity records for deletion\n' +
                                         '    List<SObject> records = new List<Opportunity>{\n' +
                                         '        new Opportunity(Name = \'Test Opp 1\', StageName = \'Prospecting\', CloseDate = Date.today()),\n' +
                                         '        new Opportunity(Name = \'Test Opp 2\', StageName = \'Prospecting\', CloseDate = Date.today()),\n' +
                                         '        new Opportunity(Name = \'Test Opp 3\', StageName = \'Prospecting\', CloseDate = Date.today())\n' +
                                         '    };\n' +
                                         '    insert records;\n';
                        } else if (sObjectName === 'Case') {
                            placeholder += '    // Create test Case records for deletion\n' +
                                         '    List<SObject> records = new List<Case>{\n' +
                                         '        new Case(Subject = \'Test Case 1\', Origin = \'Phone\'),\n' +
                                         '        new Case(Subject = \'Test Case 2\', Origin = \'Email\'),\n' +
                                         '        new Case(Subject = \'Test Case 3\', Origin = \'Web\')\n' +
                                         '    };\n' +
                                         '    insert records;\n';
                        } else {
                            // Generic placeholder for other SObjects
                            placeholder += '    // Create test ' + sObjectName + ' records for deletion\n' +
                                         '    List<SObject> records = new List<' + sObjectName + '>{\n' +
                                         '        new ' + sObjectName + '(),\n' +
                                         '        new ' + sObjectName + '(),\n' +
                                         '        new ' + sObjectName + '()\n' +
                                         '    };\n' +
                                         '    // TODO: Set required fields for ' + sObjectName + '\n' +
                                         '    insert records;\n';
                        }
                        
                        placeholder += '\n' +
                                     '    Test.startTest();\n' +
                                     '    delete records;\n' +
                                     '    Test.stopTest();\n' +
                                     '\n' +
                                     '    System.assert(true, \'Delete trigger executed without unhandled exceptions.\');\n' +
                                     '  }\n' +
                                     '}';
                        
                        return placeholder;
                    }
                    
                    function generateTrigger(sObjectName) {
                        // Store the sObject name
                        currentDeployingSObject = sObjectName;
                        
                        // Check if custom test code should be used
                        var customTestCode = null;
                        var customTestArea = document.getElementById('customTestArea_' + sObjectName);
                        if (customTestArea && customTestArea.style.display === 'block') {
                            var customTestCodeTextarea = customTestArea.querySelector('textarea');
                            if (customTestCodeTextarea && customTestCodeTextarea.value && customTestCodeTextarea.value.trim() !== '') {
                                customTestCode = customTestCodeTextarea.value;
                            }
                        }
                        
                        // Show loading message
                        var loadingMsg = document.createElement('div');
                        loadingMsg.id = 'loadingMsg';
                        var deploymentType = customTestCode ? 'with custom test class' : 'with default test class';
                        loadingMsg.innerHTML = 'Generating and deploying trigger for ' + sObjectName + ' ' + deploymentType + '...';
                        loadingMsg.style.padding = '10px';
                        loadingMsg.style.backgroundColor = '#f8f8f8';
                        loadingMsg.style.border = '1px solid #ddd';
                        loadingMsg.style.marginTop = '10px';
                        
                        // Find the trigger table and insert the loading message after it
                        var triggerTable = document.querySelector('.slds-table');
                        triggerTable.parentNode.insertBefore(loadingMsg, triggerTable.nextSibling);
                        
                        // Call the controller method to generate and deploy the trigger
                        Visualforce.remoting.Manager.invokeAction(
                            '{!$RemoteAction.ActionPlanTemplateDetailController.generateAndDeployTrigger}',
                            sObjectName,
                            customTestCode,
                            function(result, event) {
                                // Remove the loading message
                                var loadingMsg = document.getElementById('loadingMsg');
                                if (loadingMsg) {
                                    loadingMsg.parentNode.removeChild(loadingMsg);
                                }
                                
                                // Parse the JSON response
                                var response;
                                try {
                                    response = JSON.parse(result);
                                } catch (e) {
                                    // If parsing fails, treat it as a simple string response
                                    response = {
                                        status: result.indexOf('Error') !== -1 ? 'error' : 'success',
                                        message: result
                                    };
                                }
                                
                                // Create result message container
                                var resultMsg = document.createElement('div');
                                resultMsg.id = 'resultMsg';
                                resultMsg.style.padding = '10px';
                                resultMsg.style.marginTop = '10px';
                                
                                // Set background color based on status
                                if (response.status === 'error') {
                                    resultMsg.style.backgroundColor = '#ffebee';
                                    resultMsg.style.border = '1px solid #ffcdd2';
                                } else if (response.status === 'deploying') {
                                    resultMsg.style.backgroundColor = '#e3f2fd';
                                    resultMsg.style.border = '1px solid #bbdefb';
                                    
                                    // Store the async result ID for polling
                                    deploymentAsyncResultId = response.asyncResultId;
                                    
                                    // Start polling for deployment status
                                    startDeploymentStatusPolling();
                                } else {
                                    resultMsg.style.backgroundColor = '#e8f5e9';
                                    resultMsg.style.border = '1px solid #c8e6c9';
                                }
                                
                                // Create message content
                                var messageDiv = document.createElement('div');
                                messageDiv.innerHTML = response.message || result;
                                resultMsg.appendChild(messageDiv);
                                
                                // Add a progress indicator if deploying
                                if (response.status === 'deploying') {
                                    var progressDiv = document.createElement('div');
                                    progressDiv.id = 'deploymentProgress';
                                    progressDiv.style.marginTop = '10px';
                                    progressDiv.innerHTML = '<div class="slds-spinner slds-spinner_small" role="status">' +
                                        '<span class="slds-assistive-text">Loading</span>' +
                                        '<div class="slds-spinner__dot-a"></div>' +
                                        '<div class="slds-spinner__dot-b"></div>' +
                                        '</div>' +
                                        '<div style="margin-left: 30px; display: inline-block;">Deploying trigger... This may take a few moments.</div>';
                                    resultMsg.appendChild(progressDiv);
                                }
                                
                                // Insert the result message after the trigger table
                                var triggerTable = document.querySelector('.slds-table');
                                triggerTable.parentNode.insertBefore(resultMsg, triggerTable.nextSibling);
                                
                                // Reload the page after 5 seconds if successful
                                if (response.status === 'success') {
                                    setTimeout(function() {
                                        window.location.reload();
                                    }, 5000);
                                }
                            },
                            { escape: false }
                        );
                    }
                    
                    // Function to start polling for deployment status
                    function startDeploymentStatusPolling() {
                        // Clear any existing interval
                        if (deploymentStatusInterval) {
                            clearInterval(deploymentStatusInterval);
                        }
                        
                        // Set up polling every 3 seconds
                        deploymentStatusInterval = setInterval(checkDeploymentStatus, 3000);
                    }
                    
                    // Function to check deployment status
                    function checkDeploymentStatus() {
                        if (!deploymentAsyncResultId) {
                            clearInterval(deploymentStatusInterval);
                            return;
                        }
                        
                        Visualforce.remoting.Manager.invokeAction(
                            '{!$RemoteAction.ActionPlanTemplateDetailController.checkDeployStatus}',
                            deploymentAsyncResultId,
                            function(result, event) {
                                // Parse the JSON response
                                var response;
                                try {
                                    response = JSON.parse(result);
                                } catch (e) {
                                    // If parsing fails, treat it as a simple string response
                                    response = {
                                        status: result.indexOf('Error') !== -1 ? 'error' : 'success',
                                        message: result
                                    };
                                }
                                
                                // Get the result message container
                                var resultMsg = document.getElementById('resultMsg');
                                if (!resultMsg) {
                                    clearInterval(deploymentStatusInterval);
                                    return;
                                }
                                
                                // If deployment is complete (success or error), update the UI
                                if (response.status === 'success' || response.status === 'error') {
                                    // Clear the interval
                                    clearInterval(deploymentStatusInterval);
                                    deploymentAsyncResultId = null;
                                    
                                    // Update the result message container
                                    if (response.status === 'success') {
                                        resultMsg.style.backgroundColor = '#e8f5e9';
                                        resultMsg.style.border = '1px solid #c8e6c9';
                                        
                                        // Reload the page after 3 seconds
                                        setTimeout(function() {
                                            window.location.reload();
                                        }, 3000);
                                    } else {
                                        resultMsg.style.backgroundColor = '#ffebee';
                                        resultMsg.style.border = '1px solid #ffcdd2';
                                    }
                                    
                                    // Remove the progress indicator
                                    var progressDiv = document.getElementById('deploymentProgress');
                                    if (progressDiv) {
                                        progressDiv.parentNode.removeChild(progressDiv);
                                    }
                                    
                                    // Update the message
                                    var messageDiv = resultMsg.querySelector('div');
                                    if (messageDiv) {
                                        messageDiv.innerHTML = response.message;
                                    }
                                }
                                // If still deploying, update the dots in the message
                                else if (response.status === 'deploying') {
                                    // Update the dots in the message to show progress
                                    var progressDiv = document.getElementById('deploymentProgress');
                                    if (progressDiv) {
                                        var dotsSpan = progressDiv.querySelector('.slds-assistive-text');
                                        if (dotsSpan) {
                                            var dots = dotsSpan.innerHTML.split('.').length - 1;
                                            dots = (dots + 1) % 4;
                                            dotsSpan.innerHTML = 'Loading' + '.'.repeat(dots);
                                        }
                                    }
                                }
                            },
                            { escape: false }
                        );
                    }
                </script>
                
            </apex:pageBlockSection>

