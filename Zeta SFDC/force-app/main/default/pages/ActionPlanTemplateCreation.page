<apex:page id="thePage"
	tabStyle="ActionPlanTemplate__c"
	standardController="ActionPlanTemplate__c"
	extensions="ActionPlanTemplateCreationController"
	lightningStylesheets="true"
	docType="html-5.0"
	contentType="text/html"
	applyBodyTag="false"
	action="{!onLoad}">
	<html xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" lang="en">
	<head>
		<title>
			<apex:outputText value="{!$ObjectType.ActionPlanTemplate__c.label} - {!$Label.ap_New}" rendered="{!ActionPlanTemplate__c.Id == null}"
			/> <apex:outputText value="{!ActionPlanTemplate__c.Name} - {!$Label.ap_Edit}" rendered="{!ActionPlanTemplate__c.Id != null}" />
		</title>
		<meta charset="utf-8" />
		<meta http-equiv="x-ua-compatible" content="ie=edge" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<apex:includeScript value="{!URLFOR($Resource.ActionPlan_Resources, 'js/jquery.min.js')}" />
		<apex:includeScript value="{!URLFOR($Resource.ActionPlan_Resources, 'js/ActionPlans_Scripts.js')}" />
		<script type="module">
			// Import the necessary functions from the soql-module.js
			import { parseQuery } from '{!URLFOR($Resource.ActionPlan_Resources, "js/soql-parser.js")}';
			// Make the imported functions available to the global scope for use in other scripts
			window.soqlModule = {
				parse: parseQuery,
			};
		</script>

		<script>
			var j$ = jQuery.noConflict();
			j$(document).ready(function() {
				onLoad();
			});

			function onLoad() {
				checkSkipWeekend(j$('[id$=skipWeekendCheckbox]').attr('id'), j$('[id$=skipDayPicklist]').attr('id'));
				checkAllDependent('{!$Label.ap_ItselfDependencyError}', '{!$Label.ap_Errors_Cyclic_Dependency_Found}');
				showErrors();
				j$('.helpOrb').css({ width: '12px', height: '12px' });
				j$('td [Id*=taskTable]').css('vertical-align', 'middle');
				//checkReminderPicklists();
				initializeDueDatePanels();
				initializeFieldPathFinders();
			}

			// Initialize all field path finders
			function initializeFieldPathFinders() {
				console.log('Initializing field path finders');
				var targetObject = j$('[id$=targetObject]').val();

				// Update help text and enable/disable field path finders based on target object
				j$('[id^=searchInput]').each(function() {
					var inputId = j$(this).attr('id');
					var idLower = inputId ? inputId.toLowerCase() : '';
					if (inputId && (idLower.indexOf('userfield') !== -1 || idLower.indexOf('datefield') !== -1)) {
						var helpTextId = 'searchHelp' + inputId.replace('searchInput', '');

						if (targetObject) {
							// Enable the input
							j$(this).prop('disabled', false);

							// Update help text
							if (idLower.indexOf('userfield') !== -1) {
								j$('#' + helpTextId).text('Search for a User or a User lookup field (up to 5 levels deep)');
							} else {
								j$('#' + helpTextId).text('Search for a date field on the target object');
							}
						} else {
							// Disable the input
							j$(this).prop('disabled', true);

							// Update help text
							j$('#' + helpTextId).text('Add target object to see fields');
						}
					}
				});
			}

			// Initialize due date panels based on selected values
			function initializeDueDatePanels() {
				j$('[id$=dueDateType]').each(function() {
					var position = j$(this).attr('id').match(/\d+/);
					if (position) {
						handleDueDateTypeChange(this, position[0]);
					}
				});
			}

			// Handle due date type change
			function handleDueDateTypeChange(selectElement, position) {
				var selectedValue = j$(selectElement).val();
				var targetObject = j$('[id$=targetObject]').val();

				// Hide all panels first
				j$('.dateSearchPanel-' + position).hide();
				j$('.staticDatePanel-' + position).hide();
				j$('.dayOffsetPanel-' + position).hide();

				// Show the appropriate panel based on selection
				if (selectedValue === 'DateField') {
					j$('.dateSearchPanel-' + position).show();
					j$('.dayOffsetPanel-' + position).show();

					// Set placeholder for the date field search
					var placeholder = 'Search for a date field';

					j$('#searchInputdateField' + position).attr('placeholder', placeholder);

					// If target object is not set, show a message
					if (!targetObject) {
						// The help text will already be set by initializeFieldPathFinders()
						console.log('Target object not set, date field path finder will be disabled');
					}
				} else if (selectedValue === 'StaticDate') {
					j$('.staticDatePanel-' + position).show();
				} else {
					// For all other due date types (AssignedDate, DependentDueDate)
					j$('.dayOffsetPanel-' + position).show();
				}

				// Only clear the field value if not selecting DateField
				if (selectedValue !== 'DateField') {
					// Clear the search input and hidden field only when changing away from DateField
					j$('#searchInputdateField' + position).val('');
					j$('.dueDateRelatedField-' + position).find('input').val('');
				} else {
					// When selecting DateField, only clear the search input if it doesn't already have a value
					// This preserves the field path during initialization
					if (!j$('#searchInputdateField' + position).val()) {
						j$('#searchInputdateField' + position).val('');
					}
				}
			}

			// Function to update fields when target object changes
			function updateFieldsForTargetObject() {
				var objectName = j$('[id$=targetObject]').val();
				if (objectName) {
					updateFieldsForTargetObjectJS();
				}
			}
		</script>
		<style>
        input.errorBorder {
            border: 2px solid #cc0000;
        }
		</style>
		<apex:variable value="{!$User.UIThemeDisplayed == 'Theme4d' || $User.UIThemeDisplayed == 'Theme4u'}" var="lex" />
		<apex:slds rendered="{!lex}" />
	</head>

	<body>
	<c:APSectionHeader sObjType="ActionPlanTemplate__c" subtitle="{!$ObjectType.ActionPlanTemplate__c.label}" title="{!subtitle}" />

	<apex:pageMessages id="pageMessages" />

	<apex:form id="templateForm" html-novalidate="novalidate">
		<apex:actionFunction name="validateWhereClauseJS"
			action="{!validateWhereClause}"
			rerender="validationResults,pageMessages,whereClauseDisplay"
			status="validationStatus">
		</apex:actionFunction>

		<apex:actionFunction name="updateFieldsForTargetObjectJS"
			action="{!updateFieldsForTargetObject}"
			rerender="userLookupPanel,dueDatePanel"
			status="fieldUpdateStatus"
			oncomplete="initializeFieldPathFinders();">
		</apex:actionFunction>

		<apex:actionStatus id="fieldUpdateStatus">
			<apex:facet name="start">
				<div class="slds-scope">
					<div class="slds-spinner_container slds-is-fixed" style="position: fixed">
						<div role="status" class="slds-spinner slds-spinner_medium slds-spinner_brand">
							<span class="slds-assistive-text">Loading</span>
							<div class="slds-spinner__dot-a"></div>
							<div class="slds-spinner__dot-b"></div>
						</div>
					</div>
				</div>
			</apex:facet>
		</apex:actionStatus>

		<input type="hidden" id="whereClauseRecordCount" value="0" />

		<apex:pageBlock id="editBlock" mode="edit">
			<apex:pageBlockButtons id="buttons">
				<apex:commandButton id="save" action="{!checkCycleDependent}" value="{!$Label.ap_Save}" reRender="" />
				<apex:commandButton id="saveandnew" action="{!saveAndNew}" value="{!$Label.ap_SaveAndNew}" reRender="" />
				<apex:actionRegion >
					<apex:commandButton id="cancel" action="{!cancelTemplate}" value="{!$Label.ap_Cancel}" html-formnovalidate="novalidate"
					                    immediate="true" />
				</apex:actionRegion>
			</apex:pageBlockButtons>

			<!-- Information Section -->
				<apex:pageBlockSection id="informationSection" columns="1" collapsible="false">
				<apex:pageBlockSectionItem >
					<apex:outputLabel value="{!$ObjectType.ActionPlanTemplate__c.fields.Name.label}" />
					<apex:inputField required="true" id="name" value="{!ActionPlanTemplate__c.Name}" style="width: 300px" />
				</apex:pageBlockSectionItem>

				<apex:pageBlockSectionItem >
					<apex:outputLabel value="{!$ObjectType.ActionPlanTemplate__c.fields.Description__c.label}" />
					<apex:inputField id="description" value="{!ActionPlanTemplate__c.Description__c}" style="width: 300px" />
				</apex:pageBlockSectionItem>

				<apex:pageBlockSectionItem >
					<apex:outputLabel value="{!$ObjectType.ActionPlanTemplate__c.fields.Type__c.label}" />
					<apex:inputField id="type" value="{!ActionPlanTemplate__c.Type__c}" style="width: 300px" />
				</apex:pageBlockSectionItem>


				<apex:pageBlockSectionItem >
					<apex:outputLabel value="{!$ObjectType.ActionPlanTemplate__c.fields.Fallback_Queue__c.label}" />
					<apex:outputPanel styleClass="requiredInput" layout="block">
						<apex:outputPanel styleClass="requiredBlock" layout="block" />
						<apex:selectList value="{!ActionPlanTemplate__c.Fallback_Queue__c}"
							styleclass="slds-select"
							required="true"
							size="1"
							id="fallbackQueue"
							style="width: 300px"
							disabled="{!!$ObjectType.ActionPlanTemplate__c.updateable}">
							<apex:selectOptions value="{!TaskQueueOptions}" />
						</apex:selectList>
					</apex:outputPanel>
				</apex:pageBlockSectionItem>

			</apex:pageBlockSection>
			<!-- End Information Section -->

			<!-- Tasks Section -->
			<apex:pageBlockSection columns="2" collapsible="false" id="taskDetails">
				<apex:inputField value="{!ActionPlanTemplate__c.SkipWeekends__c}"
					id="skipWeekendCheckbox"
					onclick="checkSkipWeekend('{!$Component.skipWeekendCheckbox}','{!$Component.taskDetails.skipDayPicklist}');" />
				<apex:inputField id="archived" value="{!ActionPlanTemplate__c.Archived__c}" />

				<apex:inputField id="skipDayPicklist" styleclass="slds-select" value="{!ActionPlanTemplate__c.SkipDay__c}" />

				<apex:pageBlockSectionItem rendered="{!taskHasRecordType}">
					<apex:outputLabel >{!$ObjectType.Task.Label}&nbsp;Record Type&nbsp;</apex:outputLabel>
					<apex:actionRegion >
						<apex:selectList value="{!ActionPlanTemplate__c.TaskRecordTypeID__c}"
							styleclass="slds-select"
							required="{!taskHasRecordType}"
							size="1"
							disabled="{!!$ObjectType.ActionPlanTemplate__c.updateable}">
							<apex:actionSupport event="onchange" reRender="taskSection" />
							<apex:selectOptions value="{!TaskRTPicklistValues}" />
						</apex:selectList>
					</apex:actionRegion>
				</apex:pageBlockSectionItem>
				<apex:outputPanel rendered="{!!taskHasRecordType}" />
			</apex:pageBlockSection>

			<apex:pageBlockSection id="dynamicQuerySection" title="Dynamic Record Selection" columns="1" collapsible="false">
				<apex:pageBlockSectionItem >
					<apex:outputLabel value="{!$ObjectType.ActionPlanTemplate__c.fields.Target_Object_API_Name__c.label}" />
					<apex:outputPanel >
						<!-- Hidden input to maintain compatibility with existing JavaScript -->
						<apex:inputHidden id="targetObject" value="{!ActionPlanTemplate__c.Target_Object_API_Name__c}" />

						<!-- APObjectLookup component -->
						<c:APObjectLookup sObj="{!ActionPlanTemplate__c}"
							field="Target_Object_API_Name__c"
							recordname="{!ActionPlanTemplate__c.Target_Object_API_Name__c}"
							for="targetObjectLookup"
							required="false"
							fieldStyle="width: 300px"
							placeholder="Search for an object" />
						<img class="helpOrb" title="{!$ObjectType.ActionPlanTemplate__c.fields.Target_Object_API_Name__c.inlineHelpText}"
						     src="/s.gif" />

						<!-- Script to update hidden field and trigger necessary functions -->
						<script>
							j$(document).ready(function() {
								// When the APObjectLookup value changes, update the hidden field and trigger necessary functions
								j$('#targetObjectLookupsldsscopediv [id$=searchInput]').on('parentchange', function(event, label, directApiName) {
									console.log('parentchange event triggered with label:', label, 'directApiName:', directApiName);

									// If we have a direct API name from the event, use it
									var apiName = directApiName;

									if (!apiName) {
										console.log('No direct API name provided, trying to find it from hidden inputs');

										// Get all hidden inputs to debug
										console.log('All hidden inputs:', j$('input[type="hidden"]').length);
										j$('input[type="hidden"]').each(function() {
											console.log('Hidden input id:', j$(this).attr('id'), 'value:', j$(this).val());
										});

										// Try multiple selector approaches to find the hidden input
										var hiddenInput = j$('#targetObjectLookupsldsscopediv [id$=hiddenInput]');
										console.log('Hidden input using #targetObjectLookupsldsscopediv selector:', hiddenInput.length, 'value:', hiddenInput.val());

										// Get the value directly from the component's hidden input
										apiName = hiddenInput.val();
										if (!apiName) {
											// Try alternative selectors if the first one didn't work
											apiName = j$('[id$=targetObjectLookup] [id$=hiddenInput]').val();
											console.log('Hidden input using [id$=targetObjectLookup] selector:', apiName);

											if (!apiName) {
												// Try to get from data attribute on the search input
												var searchInput = j$('#targetObjectLookupsldsscopediv [id$=searchInput]');
												apiName = searchInput.attr('data-api-name');
												console.log('API name from data attribute:', apiName);

												if (!apiName) {
													// Last resort - try to find by proximity to the search input
													var closestHidden = searchInput.closest('form').find('[id$=hiddenInput]').first();
													apiName = closestHidden.val();
													console.log('Hidden input using closest form approach:', apiName);
												}
											}
										}
									}

									// If we still don't have an API name but have a label, try to use the label as a last resort
									if (!apiName && label) {
										console.log('No API name found, using label as last resort:', label);
										// This is not ideal but better than nothing
										apiName = label;
									}

									if (apiName) {
										// Update our compatibility hidden field
										j$('[id$=targetObject]').val(apiName);
										console.log('Updated targetObject value:', j$('[id$=targetObject]').val());

										// Force the value into the field directly as well
										var targetObjectField = document.querySelector('[id$=targetObject]');
										if (targetObjectField) {
											targetObjectField.value = apiName;
											console.log('Directly set targetObject value:', targetObjectField.value);
										}

										// Store in localStorage as a backup
										try {
											localStorage.setItem('lastSelectedObjectApiName', apiName);
											console.log('Stored API name in localStorage:', apiName);
										} catch (e) {
											console.log('Could not store in localStorage:', e);
										}
									} else {
										console.error('Could not find API name after all attempts');
									}

 								// Trigger the necessary functions
 								try {
 									// First update fields to ensure they're properly initialized
 									console.log('Calling updateFieldsForTargetObjectJS');
 									updateFieldsForTargetObjectJS();

 									// Refresh field path finders so help text clears when an object is selected
 									try {
 										initializeFieldPathFinders();
 									} catch (innerErr) {
 										console.warn('initializeFieldPathFinders not available:', innerErr);
 									}

 									// Then validate the WHERE clause if it exists
 									if (j$('[id$=whereClause]').val()) {
 										console.log('Calling validateWhereClauseAsync');
 										setTimeout(function() {
 											validateWhereClauseAsync();
 										}, 500); // Slight delay to ensure fields are updated first
 									}
 								} catch (e) {
 									console.error('Error triggering functions:', e);
 								}
 							});
							});
						</script>
					</apex:outputPanel>
				</apex:pageBlockSectionItem>

				<apex:pageBlockSectionItem >
					<apex:outputLabel value="{!$ObjectType.ActionPlanTemplate__c.fields.Where_Clause__c.label}" />
					<apex:outputPanel id="whereClauseDisplay">
						<apex:inputField id="whereClause" value="{!ActionPlanTemplate__c.Where_Clause__c}" style="width: 500px; height: 80px"
						                 onkeyup="clearTimeout(window.whereClauseTimeout); window.whereClauseTimeout = setTimeout(validateWhereClauseAsync, 800);"
						                 onblur="validateWhereClauseAsync();" />
						<img class="helpOrb" title="{!$ObjectType.ActionPlanTemplate__c.fields.Where_Clause__c.inlineHelpText}" src="/s.gif" />

						<div id="validationStatusContainer" class="slds-m-top_small" style="display: none;">
							<div class="slds-is-relative">
								<div class="slds-text-body_small">Validating where clause...</div>
							</div>
						</div>
						<div id="validationResultsContainer" class="slds-m-top_small">
							<div id="whereClauseSuccess" class="slds-box slds-theme_success" style="display: none;">
								<strong><span id="recordCountText">0</span> records</strong> will be returned
							</div>
							<div id="whereClauseError" class="slds-box slds-theme_error" style="display: none;">
								<span id="errorMessageText"></span>
							</div>
						</div>

						<apex:actionStatus id="validationStatus">
							<apex:facet name="start">
								<div style="position: relative; display: inline-block; margin: 0px 10px;">
									<img src="/img/loading.gif" style="vertical-align: middle;" />
								</div>
							</apex:facet>
						</apex:actionStatus>
						<div id="validationResults"></div>

						<script>
							function validateWhereClauseAsync() {
								var whereClause = j$('[id$=whereClause]').val();

								// Try multiple approaches to get the object name
								var objectName = j$('[id$=targetObject]').val();
								console.log('validateWhereClauseAsync called, whereClause:', whereClause);
								console.log('validateWhereClauseAsync initial objectName from targetObject field:', objectName);

								// Debug all form elements to find the target object field
								console.log('All form elements:');
								j$('form').find('input, select, textarea').each(function() {
									var id = j$(this).attr('id');
									if (id && (id.indexOf('target') !== -1 || id.indexOf('Target') !== -1 || id.indexOf('Object') !== -1)) {
										console.log('Potential target field - id:', id, 'value:', j$(this).val());
									}
								});

								// If objectName is empty, try to get it from the APObjectLookup component
								if (!objectName) {
									// Try to get from the hidden input in the APObjectLookup component
									var hiddenInput = j$('#targetObjectLookupsldsscopediv [id$=hiddenInput]');
									if (hiddenInput.length > 0) {
										objectName = hiddenInput.val();
										console.log('Got objectName from hidden input:', objectName);
									}

									// If still empty, try to get from the search input data attribute
									if (!objectName) {
										var searchInput = j$('#targetObjectLookupsldsscopediv [id$=searchInput]');
										if (searchInput.length > 0) {
											objectName = searchInput.attr('data-api-name');
											console.log('Got objectName from search input data attribute:', objectName);

											// If still empty, try to get from the search input display value
											if (!objectName && searchInput.val()) {
												// We have a display value but no API name, log it for debugging
												console.log('Search input has display value but no API name:', searchInput.val());
											}
										}
									}

									// If still empty, try to get from localStorage
									if (!objectName) {
										try {
											objectName = localStorage.getItem('lastSelectedObjectApiName');
											console.log('Got objectName from localStorage:', objectName);
										} catch (e) {
											console.log('Could not get from localStorage:', e);
										}
									}

									// If we found an objectName, update the hidden field
									if (objectName) {
										j$('[id$=targetObject]').val(objectName);
										console.log('Updated targetObject field with value:', objectName);

										// Also update the data attribute on the search input
										var searchInput = j$('#targetObjectLookupsldsscopediv [id$=searchInput]');
										if (searchInput.length > 0) {
											searchInput.attr('data-api-name', objectName);
											console.log('Updated search input data attribute with value:', objectName);
										}
									}
								}

								// Check if we have a search input with a value but no API name
								var searchInput = j$('#targetObjectLookupsldsscopediv [id$=searchInput]');
								if (searchInput.length > 0 && searchInput.val() && !objectName) {
									console.log('Search input has value but no API name was found:', searchInput.val());
									// This indicates the user has entered something but the API name wasn't properly set
								}

								if (!whereClause) {
									console.log('No where clause provided, hiding messages and clearing trigger fields');
									j$('#whereClauseSuccess').hide();
									j$('#whereClauseError').hide();
									
									// Clear trigger fields when where clause is removed
									j$('[id$=triggerFields]').val('');
									console.log('Cleared Trigger_Fields__c because where clause is empty');
									
									return;
								}

								// Final check for object name
								if (!objectName) {
									// Last resort - check if there's a visible display value in the search input
									var searchInput = j$('#targetObjectLookupsldsscopediv [id$=searchInput]');
									if (searchInput.length > 0 && searchInput.val()) {
										// The user has entered something in the search input, but we couldn't get the API name
										// This is a special case - we'll show a different error message
										console.log('Search input has a value but no API name could be found:', searchInput.val());
										j$('#errorMessageText').html('Object lookup is not properly selected. Please try selecting the object again from the dropdown.');
										j$('#whereClauseError').show();
										j$('#whereClauseSuccess').hide();

										// Add a special class to highlight the object lookup field
										searchInput.addClass('errorBorder');

										// Add a click handler to clear the error when the user clicks on the field
										searchInput.one('click', function() {
											j$(this).removeClass('errorBorder');
											// Clear the dropdown to force the user to select again
											j$(this).val('');
											j$('[id$=targetObject]').val('');
											// Hide the error message
											j$('#whereClauseError').hide();
										});

										return;
									}

									// No object name and no search input value
									console.log('No object name found after all attempts, showing error');
									j$('#errorMessageText').text('Target Object API Name is required');
									j$('#whereClauseError').show();
									j$('#whereClauseSuccess').hide();
									return;
								}

								j$('#validationStatusContainer').show();
								j$('#whereClauseSuccess').hide();
								j$('#whereClauseError').hide();

								console.log('Validating WHERE clause: ' + whereClause + ' for object: ' + objectName);

								try {
									// Parse the WHERE clause using soql-parser-cjs.js
									var cleanWhereClause = whereClause.trim();
									if (cleanWhereClause.toLowerCase().startsWith('where')) {
										cleanWhereClause = cleanWhereClause.substring(5).trim();
									}

									// Create a dummy SOQL query to parse
									var dummyQuery = 'SELECT Id FROM ' + objectName + ' WHERE ' + cleanWhereClause;

									// Parse the query
									var parsedQuery;
									try {
										// Check if soqlModule object exists
										if (typeof window.soqlModule !== 'undefined' && window.soqlModule && typeof window.soqlModule.parse === 'function') {
											// Use the debug function if available for better error reporting
											if (typeof window.soqlModule.debug === 'function') {
												parsedQuery = window.soqlModule.debug(dummyQuery);
												console.log('Parsed query using debug:', parsedQuery);
											} else {
												parsedQuery = window.soqlModule.parse(dummyQuery);
												console.log('Parsed query:', parsedQuery);
											}

											// Check if there was an error during parsing
											if (parsedQuery.error) {
												throw new Error(parsedQuery.error);
											}
										} else {
											console.warn('soql-module.js not loaded or soqlModule.parse not available. Using fallback implementation.');
											// Create a simple object with a where property to allow the rest of the function to work
											parsedQuery = {
												where: {
													// Simple extraction of field names from the WHERE clause
													// This is a basic fallback that won't handle all cases but will work for simple WHERE clauses
													field: cleanWhereClause.split(/\s+/)[0]
												}
											};
										}
									} catch (parseError) {
										console.error('Error parsing WHERE clause:', parseError);
										j$('#validationStatusContainer').hide();
										j$('#errorMessageText').html('Invalid WHERE clause: ' + parseError.message);
										j$('#whereClauseError').show();
										return;
									}

									// Extract fields from the WHERE clause
									var extractedFields = [];
									if (parsedQuery && parsedQuery.where) {
										extractFieldsFromWhereClause(parsedQuery.where, extractedFields);
									}

									// Convert fields from relationship notation to SObject notation
									var convertedFields = [];
									for (var i = 0; i < extractedFields.length; i++) {
										var field = extractedFields[i];
										var convertedField = convertFieldNotation(field);
										if (convertedField) {
											convertedFields.push(convertedField);
										}
									}

									// Remove duplicates
									var uniqueFields = [];
									for (var i = 0; i < convertedFields.length; i++) {
										if (uniqueFields.indexOf(convertedFields[i]) === -1) {
											uniqueFields.push(convertedFields[i]);
										}
									}

									// Join fields with commas
									var fieldsString = uniqueFields.join(', ');
									console.log('Extracted fields:', fieldsString);

									// Log the extracted fields for debugging
									console.log('Extracted fields before server call:', fieldsString);

									// If we couldn't extract any fields but have a WHERE clause, try a simple fallback
									if (!fieldsString && cleanWhereClause) {
										console.log('No fields extracted, trying simple fallback');
										// Simple fallback: split by operators and take the first part as a field
										var parts = cleanWhereClause.split(/\s+(=|!=|<>|>|<|>=|<=|LIKE|IN|NOT IN)\s+/);
										if (parts.length > 0) {
											fieldsString = parts[0].trim();
											console.log('Fallback extracted field:', fieldsString);
										}
									}

									// Call the server to validate the WHERE clause
									try {
										Visualforce.remoting.Manager.invokeAction(
											'{!$RemoteAction.ActionPlanTemplateCreationController.validateWhereClauseRemote}',
											whereClause,
											objectName,
											fieldsString, // Pass the extracted fields to the server
											function(result, event) {
												j$('#validationStatusContainer').hide();

												if (event.status) {
													console.log('Validation result:', result);

													if (result.success) {
														j$('#recordCountText').text(result.count);
														j$('#whereClauseSuccess').show();
														j$('#whereClauseError').hide();

														// Store for later submission
														j$('#whereClauseRecordCount').val(result.count);

														// Update the Trigger_Fields__c field with converted fields from server
														if (result.convertedFields) {
															j$('[id$=triggerFields]').val(result.convertedFields);
															console.log('Updated Trigger_Fields__c with converted fields:', result.convertedFields);
														} else if (fieldsString) {
															j$('[id$=triggerFields]').val(fieldsString);
															console.log('No converted fields returned from server, using extracted fields:', fieldsString);
														}
													} else {
														j$('#errorMessageText').html(result.message);
														j$('#whereClauseError').show();
														j$('#whereClauseSuccess').hide();
													}
												} else {
													console.error('Remote call failed:', event);
													j$('#errorMessageText').html('Error validating WHERE clause: ' + event.message);
													j$('#whereClauseError').show();
													j$('#whereClauseSuccess').hide();
												}
											},
											{ escape: true }
										);
									} catch (remoteCallError) {
										console.error('Error making remote call:', remoteCallError);
										j$('#validationStatusContainer').hide();
										j$('#errorMessageText').html('Error validating WHERE clause: ' + remoteCallError.message);
										j$('#whereClauseError').show();
									}
								} catch (error) {
									console.error('Error in validateWhereClauseAsync:', error);
									j$('#validationStatusContainer').hide();
									j$('#errorMessageText').html('Error processing WHERE clause: ' + error.message);
									j$('#whereClauseError').show();
								}
							}

							// Helper function to extract fields from WHERE clause
							function extractFieldsFromWhereClause(whereClause, fields) {
								if (!whereClause) return;

								// Handle conditions
								if (whereClause.field) {
									// For the fallback case, the field might be a simple string from the WHERE clause
									// Try to extract field names more intelligently
									if (typeof window.soqlModule === 'undefined' || !window.soqlModule) {
										// This is our fallback case - try to extract field names from the raw WHERE clause
										var rawClause = j$('[id$=whereClause]').val().trim();
										if (rawClause.toLowerCase().startsWith('where')) {
											rawClause = rawClause.substring(5).trim();
										}

										// Simple regex to extract potential field names
										// This won't handle all cases but should work for common WHERE clauses
										var fieldRegex = /([a-zA-Z0-9_\.]+)\s*(=|!=|<>|>|<|>=|<=|LIKE|IN|NOT IN)/g;
										var match;
										while ((match = fieldRegex.exec(rawClause)) !== null) {
											fields.push(match[1].trim());
										}

										// If we couldn't extract any fields with regex, fall back to the simple approach
										if (fields.length === 0 && whereClause.field) {
											fields.push(whereClause.field);
										}

										return;
									} else {
										// Normal case with soql parser
										fields.push(whereClause.field);
										return;
									}
								}

								// Handle left side
								if (whereClause.left) {
									if (whereClause.left.field) {
										fields.push(whereClause.left.field);
									} else if (typeof whereClause.left === 'object') {
										extractFieldsFromWhereClause(whereClause.left, fields);
									}
								}

								// Handle right side
								if (whereClause.right) {
									if (whereClause.right.field) {
										fields.push(whereClause.right.field);
									} else if (typeof whereClause.right === 'object') {
										extractFieldsFromWhereClause(whereClause.right, fields);
									}
								}

								// Handle conditions array (for complex WHERE clauses)
								if (whereClause.conditions && Array.isArray(whereClause.conditions)) {
									for (var i = 0; i < whereClause.conditions.length; i++) {
										var condition = whereClause.conditions[i];
										if (condition.field) {
											fields.push(condition.field);
										} else if (typeof condition === 'object') {
											extractFieldsFromWhereClause(condition, fields);
										}
									}
								}
							}

							// Helper function to convert field notation
							function convertFieldNotation(fieldName) {
								if (!fieldName) return '';

								// Clean the field name (remove parentheses)
								var cleanedField = fieldName.trim();
								while (cleanedField.startsWith('(')) {
									cleanedField = cleanedField.substring(1).trim();
								}
								while (cleanedField.endsWith(')')) {
									cleanedField = cleanedField.substring(0, cleanedField.length - 1).trim();
								}

								// Convert relationship notation to SObject notation
								if (cleanedField.includes('__r.')) {
									return cleanedField.replace('__r.', '__c.');
								}

								return cleanedField;
							}

							// Initialize - validate if values already exist
							j$(document).ready(function() {
								console.log('Document ready - initializing WHERE clause validation');

								// Check for existing values
								var whereClause = j$('[id$=whereClause]').val();
								var objectName = j$('[id$=targetObject]').val();
								console.log('Initial values - whereClause:', whereClause, 'objectName:', objectName);

								// If we don't have an objectName, try to get it from localStorage
								if (!objectName) {
									try {
										var storedObjectName = localStorage.getItem('lastSelectedObjectApiName');
										if (storedObjectName) {
											console.log('Found stored objectName in localStorage:', storedObjectName);

											// Update the hidden field
											j$('[id$=targetObject]').val(storedObjectName);
											console.log('Updated targetObject field with stored value:', storedObjectName);

											// Update the data attribute on the search input
											var searchInput = j$('#targetObjectLookupsldsscopediv [id$=searchInput]');
											if (searchInput.length > 0) {
												searchInput.attr('data-api-name', storedObjectName);
												console.log('Updated search input data attribute with stored value:', storedObjectName);

												// If the search input doesn't have a display value, try to get the label
												if (!searchInput.val()) {
													console.log('Search input has no display value, will try to get label for:', storedObjectName);
													// This will trigger a server call to get the label for the API name
													// The APObjectLookup component has similar code that will run
												}
											}

											// Update objectName for the validation check
											objectName = storedObjectName;
										}
									} catch (e) {
										console.log('Error getting stored objectName from localStorage:', e);
									}
								}

								// Validate if we have both whereClause and objectName
								if (whereClause && objectName) {
									console.log('Both whereClause and objectName exist, validating...');
									setTimeout(validateWhereClauseAsync, 500);
								} else {
									console.log('Missing whereClause or objectName, skipping validation');
								}
							});
						</script>
					</apex:outputPanel>
				</apex:pageBlockSectionItem>

				<apex:pageBlockSectionItem >
					<apex:outputLabel value="{!$ObjectType.ActionPlanTemplate__c.fields.Trigger_Fields__c.label}" />
					<apex:outputPanel id="triggerFieldsDisplay">
						<apex:inputField id="triggerFields" value="{!ActionPlanTemplate__c.Trigger_Fields__c}" style="width: 500px; height: 80px" />
						<img class="helpOrb" title="{!$ObjectType.ActionPlanTemplate__c.fields.Trigger_Fields__c.inlineHelpText}" src="/s.gif" />
					</apex:outputPanel>
				</apex:pageBlockSectionItem>

			</apex:pageBlockSection>

			<apex:pageBlockSection id="taskSection" title="{!$ObjectType.Task.labelPlural}" columns="1" collapsible="false">
				<apex:outputPanel id="taskList" styleClass="slds-scope" layout="inline">
