									{!$ObjectType.APTemplateTask__c.fields.DaysFromStart__c.label}
									<img class="helpOrb" title="{!$ObjectType.APTemplateTask__c.fields.DaysFromStart__c.inlineHelpText}" src="/s.gif" />
								</span>
							</apex:facet>
							<apex:inputField value="{!wrapTask.task.DaysFromStart__c}" required="true" id="daysInput" style="width: 50%" />
						</apex:column> -->

						<apex:column id="userLookup">
							<apex:facet name="header">
										<span
										>{!$ObjectType.APTemplateTask__c.fields.User__c.label}
											<img class="helpOrb" title="{!$ObjectType.APTemplateTask__c.fields.User__c.inlineHelpText}" src="/s.gif" />
										</span>
							</apex:facet>
							<apex:outputPanel layout="block" id="userLookupPanel" style="z-index: 9999">
								<div class="slds-form-element">
									<div class="slds-form-element__control">
										<div class="slds-select_container" style="margin-bottom: 5px;">
											<select id="userLookupType{!wrapTask.position}" class="slds-select"
											        onchange="handleUserLookupTypeChange(this, '{!wrapTask.position}');">
												<option value="USER">Standard User</option>
												<option value="FIELD">User Field Path</option>
											</select>
										</div>
									</div>
								</div>

								<!-- Field Path Finder (initially hidden) -->
								<div id="userFieldPathPanel{!wrapTask.position}" style="display: none;">
									<c:APFieldPathFinder objectName="{!actionPlanTemplate.Target_Object_API_Name__c}"
										fieldType="user"
										for="userField{!wrapTask.position}"
										required="false"
										fieldStyle="width:100%;"
										placeholder="Search for User lookup field"
										disabled="{!ISBLANK(actionPlanTemplate.Target_Object_API_Name__c)}"
										selectedValue="{!wrapTask.task.UserRelatedField__c}"
									/>
								</div>

								<!-- Standard user lookup -->
								<apex:outputPanel id="standardUserLookup">
									<div id="standardUserPanel{!wrapTask.position}">
										<apex:inputField value="{!wrapTask.task.User__c}" rendered="{!!lex}" styleClass="userLookupField" />
										<c:APLightningLookup field="User__c"
											sObj="{!wrapTask.task}"
											sObjType="User"
											required="false"
											where="AND IsActive = true AND ProfileId != null"
											rendered="{!lex}"
											recordname="{!wrapTask.task.User__r.Name}"
											fieldStyle="width:100%;"
											for="userLookup{!wrapTask.position}" />
									</div>
								</apex:outputPanel>

								<!-- Hidden fields for user assignment -->
								<!-- Use standard HTML inputs with unique IDs based on position -->
												<apex:outputPanel layout="none">
													<div id="userHidden{!wrapTask.position}">
									<input type="hidden" id="userTypeField{!wrapTask.position}" name="userTypeField{!wrapTask.position}"
									       value="{!wrapTask.task.UserType__c}" />
									<apex:inputHidden value="{!wrapTask.task.UserType__c}" id="userTypeField" />

									<input type="hidden" id="userRelatedField{!wrapTask.position}" name="userRelatedField{!wrapTask.position}"
									       value="{!wrapTask.task.UserRelatedField__c}" />
									<apex:inputHidden value="{!wrapTask.task.UserRelatedField__c}" id="userRelatedField" />

									<input type="hidden" id="userField{!wrapTask.position}" name="userField{!wrapTask.position}"
											       value="{!wrapTask.task.User__c}" />
											</div>
								</apex:outputPanel>

								<script>

									function handleUserLookupTypeChange(selectElement, position) {
										var selectedValue = j$(selectElement).val();
										var targetObject = j$('[id$=targetObject]').val();

										// Hide both panels first
										j$('#userFieldPathPanel' + position).hide();
										j$('#standardUserPanel' + position).hide();

										// Set the UserType__c field
										j$('#userTypeField' + position).val(selectedValue);
										// Update the specific apex:inputHidden field for this row
												j$('#userHidden' + position + ' [id$=userTypeField]').val(selectedValue);

										// Show the appropriate panel based on selection
										if (selectedValue === 'FIELD') {
											j$('#userFieldPathPanel' + position).show();

											// If target object is not set, show a message
											if (!targetObject) {
												// The help text will already be set by initializeFieldPathFinders()
												console.log('Target object not set, field path finder will be disabled');
											}

											// Set the task's User__c field to null to prevent conflicts
											var userLookup = j$('[id$=userLookup' + position + ']').closest('.lookupInput');
											if (userLookup.length > 0) {
															userLookup.find('input').val('');
															// Also clear the hidden input within the Lightning lookup component
															var compScope = j$('[id$=userLookup' + position + 'sldsscopediv]');
															if (compScope.length > 0) {
																var hiddenInput = compScope.parent().find('[id$=hiddenInput]').first();
																if (hiddenInput.length > 0) {
																	hiddenInput.val('');
																}
															}
											}
										} else {
											j$('#standardUserPanel' + position).show();

											// Clear the UserRelatedField__c field
											j$('#userRelatedField' + position).val('');
											// Update the specific apex:inputHidden field for this row
												j$('#userHidden' + position + ' [id$=userRelatedField]').val('');
										}
									}

									// Initialize the panels based on existing data
									j$(document).ready(function() {
										// Check if we have a field path value
										var userRelatedField = j$('#userRelatedField{!wrapTask.position}').val();
										var userValue = '{!JSENCODE(wrapTask.task.User__c)}';

										console.log('Task {!wrapTask.position} - UserRelatedField value:', userRelatedField);
										console.log('Task {!wrapTask.position} - User__c value:', userValue);

										// If we have a field path value or the User__c field starts with FIELD:, select the FIELD option
										if (userRelatedField || (userValue && userValue.indexOf('FIELD:') === 0)) {
											j$('#userLookupType{!wrapTask.position}').val('FIELD');
											console.log('Setting user lookup type to FIELD based on existing data');

											// If we have a User__c value that starts with FIELD: but no UserRelatedField value,
											// extract the field path and set it in the UserRelatedField__c field
											if (!userRelatedField && userValue && userValue.indexOf('FIELD:') === 0) {
												var extractedFieldPath = userValue.substring(6); // 'FIELD:'.length() = 6
												j$('#userRelatedField{!wrapTask.position}').val(extractedFieldPath);
												// Update the specific apex:inputHidden field for this row
												j$('#userHidden{!wrapTask.position} [id$=userRelatedField]').val(extractedFieldPath);
												console.log('Extracted field path from User__c and set UserRelatedField__c to:', extractedFieldPath);
											}
										}

										// Initialize the panels
										j$('#userLookupType{!wrapTask.position}').each(function() {
											handleUserLookupTypeChange(this, '{!wrapTask.position}');
										});

										// Listen for field path selection events
										j$('#searchInputuserField{!wrapTask.position}').on('fieldpathselected', function(event, value, label, fieldType) {
											var position = '{!wrapTask.position}';

											// Set the UserRelatedField__c field
											j$('#userRelatedField' + position).val(value);
											// Update the specific apex:inputHidden field for this row
												j$('#userHidden' + position + ' [id$=userRelatedField]').val(value);
											console.log('Set UserRelatedField__c field for task ' + position + ' to ' + value);

											// Clear the User__c field when using field paths to avoid validation errors
											// The UserRelatedField__c field will store the actual field path

											// Try multiple approaches to find the User__c input field
											var userInput = null;

											// Approach 1: Try to find the input in the Lightning lookup component
											var lookupInput = j$('[id$=userLookup' + position + ']').closest('.lookupInput').find('input');
											if (lookupInput.length > 0) {
												userInput = lookupInput;
												console.log('Found User__c input using Lightning lookup approach');
											}

											// Approach 2: Try to find the direct inputField
											if (!userInput || userInput.length === 0) {
												var directInput = j$('[id$=userLookupPanel' + position + ']').find('input[id$=User__c]');
												if (directInput.length > 0) {
													userInput = directInput;
													console.log('Found User__c input using direct input approach');
												}
											}

											// Approach 3: Try to find the hidden input in the APLightningLookup component
												if (!userInput || userInput.length === 0) {
													var compScope = j$('[id$=userLookup' + position + 'sldsscopediv]');
													if (compScope.length > 0) {
														var hiddenInput = compScope.parent().find('[id$=hiddenInput]').first();
														if (hiddenInput.length > 0) {
															userInput = hiddenInput;
															console.log('Found User__c input using hidden input approach (sibling of sldsscopediv)');
														}
													}
												}

											// Approach 4: Try to find any input related to User__c
											if (!userInput || userInput.length === 0) {
												var anyUserInput = j$('input[name*=User__c]');
												if (anyUserInput.length > 0) {
													userInput = anyUserInput;
													console.log('Found User__c input using any input approach');
												}
											}

											// Clear the User__c field to avoid validation errors with field paths
											if (userInput && userInput.length > 0) {
												userInput.val('');
												console.log('Cleared User__c field for task ' + position + ' when using field path');

												// Force a change event to ensure the value is recognized
												userInput.trigger('change');
											} else {
												console.error('Could not find User__c field for task ' + position);
											}
										});
									});
 							</script>
							</apex:outputPanel>
						</apex:column>

						<!-- Fallback Assigned To (persisted to APTemplateTask__c) -->
						<apex:column id="fallbackUserLookup">
							<apex:facet name="header">
								<span>Fallback Assigned To</span>
							</apex:facet>
							<apex:outputPanel layout="block" id="fallbackUserLookupPanel" style="z-index: 9999">
								<div class="slds-form-element">
									<div class="slds-form-element__control">
										<div class="slds-select_container" style="margin-bottom: 5px;">
											<select id="fallbackUserLookupType{!wrapTask.position}" class="slds-select"
											        onchange="handleFallbackTypeChange(this, '{!wrapTask.position}');">
												<option value="USER">Standard User</option>
												<option value="FIELD">User Field Path</option>
											</select>
										</div>
									</div>
								</div>

								<!-- Field Path Finder -->
								<div id="fallbackUserFieldPathPanel{!wrapTask.position}" style="display: none;">
									<c:APFieldPathFinder objectName="{!actionPlanTemplate.Target_Object_API_Name__c}"
											fieldType="user"
											for="fallbackUserField{!wrapTask.position}"
											required="false"
											fieldStyle="width:100%;"
											placeholder="Search for User lookup field"
											disabled="{!ISBLANK(actionPlanTemplate.Target_Object_API_Name__c)}"
											selectedValue="{!wrapTask.task.FallbackUserRelatedField__c}"
										/>
								</div>

								<!-- Standard user lookup bound to FallbackUser__c -->
								<apex:outputPanel >
									<div id="fallbackStandardUserPanel{!wrapTask.position}">
										<apex:inputField value="{!wrapTask.task.FallbackUser__c}" rendered="{!!lex}" styleClass="userLookupField" />
										<c:APLightningLookup field="FallbackUser__c"
											sObj="{!wrapTask.task}"
											sObjType="User"
											required="false"
											where="AND IsActive = true AND ProfileId != null"
											rendered="{!lex}"
											recordname="{!wrapTask.task.FallbackUser__r.Name}"
											fieldStyle="width:100%;"
											for="fallbackUserLookup{!wrapTask.position}" />
									</div>
								</apex:outputPanel>

								<!-- Hidden fields bound to persist type and field path -->
								<apex:outputPanel layout="none">
									<div id="fallbackUserHidden{!wrapTask.position}">
										<input type="hidden" id="fallbackUserTypeField{!wrapTask.position}" name="fallbackUserTypeField{!wrapTask.position}"
										       value="{!wrapTask.task.FallbackUserType__c}" />
										<apex:inputHidden value="{!wrapTask.task.FallbackUserType__c}" id="fallbackUserTypeField" />
										<input type="hidden" id="fallbackUserRelatedField{!wrapTask.position}" name="fallbackUserRelatedField{!wrapTask.position}"
										       value="{!wrapTask.task.FallbackUserRelatedField__c}" />
										<apex:inputHidden value="{!wrapTask.task.FallbackUserRelatedField__c}" id="fallbackUserRelatedField" />
									</div>
								</apex:outputPanel>

								<script>
									function handleFallbackTypeChange(selectElement, position) {
										var selectedValue = j$(selectElement).val();
										var targetObject = j$('[id$=targetObject]').val();

										// Hide both panels first
										j$('#fallbackUserFieldPathPanel' + position).hide();
										j$('#fallbackStandardUserPanel' + position).hide();

										// Persist the type to hidden + apex:inputHidden
										j$('#fallbackUserTypeField' + position).val(selectedValue);
										j$('#fallbackUserHidden' + position + ' [id$=fallbackUserTypeField]').val(selectedValue);

										if (selectedValue === 'FIELD') {
											j$('#fallbackUserFieldPathPanel' + position).show();
											// Clear lookup value bound to FallbackUser__c
											var scope = j$('#fallbackUserLookup' + position + 'sldsscopediv');
											if (scope.length > 0) {
												var hiddenInput = scope.parent().find('[id$=hiddenInput]').first();
												if (hiddenInput.length > 0) {
													hiddenInput.val('');
													hiddenInput.trigger('change');
												}
											}
										} else {
											j$('#fallbackStandardUserPanel' + position).show();
											// Clear field path
											j$('#fallbackUserRelatedField' + position).val('');
											j$('#fallbackUserHidden' + position + ' [id$=fallbackUserRelatedField]').val('');
										}
									}

									j$(document).ready(function() {
										// Initialize selection from existing values
										var typeVal = '{!JSENCODE(wrapTask.task.FallbackUserType__c)}';
										var fieldPathVal = '{!JSENCODE(wrapTask.task.FallbackUserRelatedField__c)}';
										if (fieldPathVal && (!typeVal || typeVal !== 'FIELD')) {
											j$('#fallbackUserLookupType{!wrapTask.position}').val('FIELD');
										} else if (typeVal) {
											j$('#fallbackUserLookupType{!wrapTask.position}').val(typeVal);
										}
										j$('#fallbackUserLookupType{!wrapTask.position}').each(function() {
											handleFallbackTypeChange(this, '{!wrapTask.position}');
										});

										// Wire field path selection to persist value
										j$('#searchInputfallbackUserField{!wrapTask.position}').on('fieldpathselected', function(event, value, label, fieldType) {
											j$('#fallbackUserRelatedField{!wrapTask.position}').val(value);
											j$('#fallbackUserHidden{!wrapTask.position} [id$=fallbackUserRelatedField]').val(value);
										});
									});
								</script>
							</apex:outputPanel>
						</apex:column>

						<apex:column headerValue="{!$ObjectType.Task.fields.Type.label}" rendered="{!$ObjectType.Task.fields.Type.accessible}">
							<apex:selectList value="{!wrapTask.task.Type__c}" size="1" styleclass="slds-input slds-select">
								<apex:selectOptions value="{!TaskTypes}" />
							</apex:selectList>
						</apex:column>

						<apex:column headerValue="{!$ObjectType.APTemplateTask__c.fields.Priority__c.label}">
							<apex:selectList required="true" value="{!wrapTask.task.Priority__c}" size="1" styleclass="slds-input slds-select">
								<apex:selectOptions value="{!TaskPriorities}" />
							</apex:selectList>
						</apex:column>

						<apex:column style="vertical-align: middle">
							<apex:facet name="header">
								{!$ObjectType.APTemplateTask__c.fields.SendEmail__c.label}
								<br />
								<a id="all" onclick="javascript:checkEmail(1);" class="all-none">{!$Label.ap_All}</a> |
								<a id="none" onclick="javascript:checkEmail(0);" class="all-none">{!$Label.ap_None}</a>
							</apex:facet>
							<apex:inputField id="sendEmailCheckbox" value="{!wrapTask.task.SendEmail__c}" style="vertical-align: middle" />
						</apex:column>

						<!-- Due Date Column -->
						<apex:column id="dueDateCol">
							<apex:facet name="header">
										<span>Due Date
											<img class="helpOrb" title="Select how the due date for this task will be calculated" src="/s.gif" />
										</span>
							</apex:facet>
							<apex:outputPanel layout="block" id="dueDatePanel" style="z-index: 9999">
								<!-- Due Date Type Selection -->
								<div class="slds-form-element">
									<div class="slds-form-element__control">
										<div class="slds-select_container" style="margin-bottom: 5px;">
											<apex:selectList value="{!wrapTask.task.DueDateType__c}" size="1" styleClass="slds-select" id="dueDateType"
											                 onchange="handleDueDateTypeChange(this, '{!wrapTask.position}');">
												<apex:selectOptions value="{!dueDateTypeOptions}" />
											</apex:selectList>
										</div>
									</div>
								</div>

								<!-- Date field search panel -->
								<apex:outputPanel id="dateSearchPanel" layout="block"
								                  styleClass="slds-m-top_x-small dateSearchPanel dateSearchPanel-{!wrapTask.position}"
								                  style="display: {!IF(wrapTask.task.DueDateType__c == 'DateField', 'block', 'none')};">
									<c:APFieldPathFinder objectName="{!actionPlanTemplate.Target_Object_API_Name__c}"
										fieldType="date"
										for="dateField{!wrapTask.position}"
										required="false"
										fieldStyle="width:100%;"
										placeholder="Search for a date field"
										disabled="{!ISBLANK(actionPlanTemplate.Target_Object_API_Name__c)}"
										selectedValue="{!wrapTask.task.DueDateRelatedField__c}"
									/>

									<script>
										// Listen for field path selection events
										j$(document).ready(function() {
											j$('#searchInputdateField{!wrapTask.position}').on('fieldpathselected', function(event, value, label, fieldType) {
												// Store the field path in the hidden field for this specific task
												j$('.dueDateRelatedField-{!wrapTask.position}').find('input').val(value);
											});
										});
									</script>
								</apex:outputPanel>

								<!-- Static date -->
								<apex:outputPanel id="staticDatePanel" layout="block" styleClass="slds-m-top_x-small staticDatePanel-{!wrapTask.position}"
								                  style="display: {!IF(wrapTask.task.DueDateType__c == 'StaticDate', 'block', 'none')};">
									<div class="slds-form-element">
										<div class="slds-form-element__control">
											<apex:inputField value="{!wrapTask.task.StaticDueDate__c}" styleClass="slds-input" />
										</div>
									</div>
								</apex:outputPanel>

								<!-- Day offset panel (for all types except StaticDate) -->
								<apex:outputPanel id="dayOffsetPanel" layout="block" styleClass="slds-m-top_x-small dayOffsetPanel-{!wrapTask.position}"
								                  style="display: {!IF(wrapTask.task.DueDateType__c != 'StaticDate', 'block', 'none')};">
									<div class="slds-form-element">
										<div class="slds-form-element__label">
											<span>Add or subtract days</span>
											<img class="helpOrb"
											     title="Enter a positive number to add days or a negative number to subtract days from the due date"
											     src="/s.gif" />
										</div>
										<div class="slds-form-element__control">
											<apex:inputField value="{!wrapTask.task.DaysFromStart__c}" styleClass="slds-input" style="width: 100px" />
										</div>
									</div>
								</apex:outputPanel>

								<!-- Store the field path in a hidden field -->
								<apex:outputPanel styleClass="dueDateRelatedField-{!wrapTask.position}">
									<apex:inputHidden value="{!wrapTask.task.DueDateRelatedField__c}" id="dueDateRelatedField" />
								</apex:outputPanel>
							</apex:outputPanel>
						</apex:column>

						<apex:column rendered="{!canDisplayReminder}" style="vertical-align: middle" id="reminderCol">
							<apex:facet name="header">
								{!$ObjectType.APTemplateTask__c.fields.Reminder__c.label}
								<br />
								<a id="reminderAll" onclick="javascript:checkReminder(1);" class="all-none">{!$Label.ap_All}</a> |
								<a id="reminderNone" onclick="javascript:checkReminder(0);" class="all-none">{!$Label.ap_None}</a>
							</apex:facet>
							<apex:outputPanel styleClass="reminderColumn" id="reminderCell" style="vertical-align: middle">
								<apex:inputCheckbox id="reminder"
									value="{!wrapTask.task.Reminder__c}"
									style="float: left; display: inline-block; vertical-align: middle"
									onclick="javascript:enableDisableReminderPicklist(this, '{!$Component.reminderPickList}');" />
								<apex:selectList id="reminderPickList" size="1" value="{!wrapTask.task.Minutes_Reminder__c}" style="float: left"
								                 disabled="{!!wrapTask.task.Reminder__c}">
									<apex:selectOptions value="{!hoursOption}" />
								</apex:selectList>
							</apex:outputPanel>
						</apex:column>

						<apex:column headerValue="{!$ObjectType.APTemplateTask__c.fields.Comments__c.label}" id="commentCol">
							<apex:inputField id="commentPanel" style="width: 250px; display: none" value="{!wrapTask.task.Comments__c}" />
							<div style="clear: left">
								(&nbsp;
								<a
									id="{!wrapTask.position}commentLink"
									onclick="toggleComments('{!$Component.commentPanel}', '{!$Component.actionLinks}', '{!$Label.ap_Add}', '{!$Label.ap_Edit}','{!$Label.ap_Close}');"
									style="text-decoration: underline; clear: left">
									<apex:outputPanel id="actionLinks">
										<apex:outputText rendered="{!wrapTask.task.Comments__c != null}">{!$Label.ap_Edit}</apex:outputText>
										<apex:outputText rendered="{!wrapTask.task.Comments__c == null}">{!$Label.ap_Add}</apex:outputText>
									</apex:outputPanel>
								</a
								>&nbsp;)
							</div>
						</apex:column>
					</apex:pageBlockTable>
				</apex:outputPanel>

				<apex:panelGrid columns="2">
					<apex:commandLink action="{!addTemplateTask}"
						id="addLink"
						immediate="false"
						onclick=""
						oncomplete="checkReminderPicklists();"
						rendered="{!$ObjectType.APTemplateTask__c.createable}"
						rerender="taskList, pageMessages"
						status="taskStatus"
						style="font-weight: bold">
						<apex:outputText value="{!$Label.ap_AddNewTask}" />
					</apex:commandLink>
					<apex:actionStatus id="taskStatus">
						<apex:facet name="start">
							<div class="slds-scope">
								<div class="slds-spinner_container slds-is-fixed" style="position: fixed">
									<div role="status" class="slds-spinner slds-spinner_medium slds-spinner_brand">
										<span class="slds-assistive-text">Loading</span>
										<div class="slds-spinner__dot-a"></div>
										<div class="slds-spinner__dot-b"></div>
									</div>
								</div>
							</div>
						</apex:facet>
						<apex:facet name="stop">
							<apex:outputText value="{!$Label.ap_Error}: {!ErrorMsg}" styleClass="errorMessage" rendered="{!(ErrorMsg != null)}" />
						</apex:facet>
					</apex:actionStatus>
				</apex:panelGrid>
			</apex:pageBlockSection>

			<!-- End Tasks Section -->
			<div id="error" style="text-align: center">
				<span class="pbError">{!$Label.ap_Errors_Review_Errors}</span>
			</div>
		</apex:pageBlock>
	</apex:form>
	</body>
	</html>
</apex:page>