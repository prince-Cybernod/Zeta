    <decisions>
        <description>Determines whether the Individual Application meets all eligibility prerequisites (District set, Age/Grade appropriate, no Priority Items pending review). Routes to the Eligible path when met; otherwise routes to the Not Completed path.</description>
        <name>Decision_Eligibility_Prereqs_Met</name>
        <label>Decision | Eligibility | Prereqs Met?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Screen_Eligibility_Not_Completed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_prereqsmet</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fxPrereq_DistrictMet</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>fxPrereq_AgeGradeMet</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Individual_Application.Priority_Items_Pending_Review__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Individual_Application.Residency_Restriction__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assignment_Eligibility_Stamp_Eligible_Values</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
