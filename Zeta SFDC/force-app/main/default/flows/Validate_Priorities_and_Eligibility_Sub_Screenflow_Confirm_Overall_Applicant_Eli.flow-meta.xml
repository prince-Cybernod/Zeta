    <description>Created by: Elevation Solutions

Sub-screenflow that supports the Validate Priorities and Eligibility process by confirming overall applicant eligibility for an Individual Application. Pulls Priority Items, evaluates prerequisite completion (age/grade, district, priority item review/verification, special character review, residency restriction as applicable), and controls outcomes: allow marking Eligible (stamping reviewer date/time) or allow cancel/withdraw with reason. DML occurs outside of screens.`</description>
    <environments>Default</environments>
    <formulas>
        <description>Human-readable list of unmet eligibility prerequisites for display on the Not Completed screen.</description>
        <name>fxEligibility_Blocking_Reasons</name>
        <dataType>String</dataType>
        <expression>IF(
  NOT({!fxPrereq_DistrictMet}),
  &quot;• Student District is missing&lt;br/&gt;&quot;,
  &quot;&quot;
) &amp;
IF(
 {!Get_Individual_Application.Residency_Restriction__c},
  &quot;• Residency requirement is not met (Pre-K must be New York City; K–12 must be NY State)&lt;br/&gt;&quot;,
  &quot;&quot;
) &amp;
IF(
  NOT({!fxPrereq_AgeGradeMet}),
  &quot;• Age / Grade eligibility has not been approved&lt;br/&gt;&quot;,
  &quot;&quot;
) &amp;
IF(
  {!varPriorityItemCountNotVerified} &gt; 0,
  &quot;• &quot; &amp; TEXT({!varPriorityItemCountNotVerified}) &amp; &quot; Priority Item(s) are still pending review&lt;br/&gt;&quot;,
  &quot;&quot;
)</expression>
    </formulas>
    <formulas>
        <description>Builds Applicant full name for the header card from the Individual Application’s related Student Account, including optional middle name.</description>
        <name>fxHeaderApplicantName</name>
        <dataType>String</dataType>
        <expression>{!Get_Individual_Application.Account.FirstName} &amp;
IF(
  ISBLANK({!Get_Individual_Application.Account.MiddleName}),
  &quot; &quot;,
  &quot; &quot; &amp; {!Get_Individual_Application.Account.MiddleName} &amp; &quot; &quot;
) &amp;
{!Get_Individual_Application.Account.LastName}</expression>
    </formulas>
    <formulas>
        <description>Returns TRUE when age/grade prerequisite is satisfied: either no age inconsistency exists, or an exception has been approved (Age Inconsistency Review Status = Exception Made).</description>
        <name>fxPrereq_AgeGradeMet</name>
        <dataType>Boolean</dataType>
        <expression>OR(
  NOT({!Get_Individual_Application.Age_Inconsistency_Flag_c__c}),
  ISPICKVAL({!Get_Individual_Application.Age_Inconsistency_Review_Status__c}, &quot;Exception Made&quot;)
)</expression>
    </formulas>
    <formulas>
        <description>Returns TRUE when the district prerequisite is satisfied: Student District is populated on the Individual Application.</description>
        <name>fxPrereq_DistrictMet</name>
        <dataType>Boolean</dataType>
        <expression>NOT(
  ISBLANK({!Get_Individual_Application.Student_District_Id__c})
)</expression>
    </formulas>
