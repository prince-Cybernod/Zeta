    <description>Logic to flag Leads (via Potential_Age_Restriction__c) where none of the Grades Interested In correspond to the Birth Date
Created by: Elevation Solutions</description>
    <environments>Default</environments>
    <formulas>
        <description>Returns TRUE if the Age does not meet the Grade Level</description>
        <name>fx_AgeInconsistency</name>
        <dataType>Boolean</dataType>
        <expression>IF(
   {!Loop_Grades_Interested} = &quot;PK&quot;,
    /* PK: must be 4 by Dec 31 AND NOT 5+ by Dec 31 (birthday-accurate) */
    OR(
      /* too young: 4th birthday is AFTER cutoff */
      ADDMONTHS({!input_rec_Lead.Date_of_Birth__c}, 48) &gt;
      DATE(
        YEAR(DATEVALUE({!Get_Academic_Term.StartDate})),
        12,
        31
      ),
      /* too old: 5th birthday is ON or BEFORE cutoff */
      ADDMONTHS({!input_rec_Lead.Date_of_Birth__c}, 60) &lt;=
      DATE(
        YEAR(DATEVALUE({!Get_Academic_Term.StartDate})),
        12,
        31
      )
    ),
    IF(
      OR(
       {!Loop_Grades_Interested} = &quot;K&quot;,
        {!Loop_Grades_Interested} = &quot;TK&quot;
      ),
      /* K/TK: must be 5 by Dec 31 AND NOT 6+ by Dec 31 (birthday-accurate) */
      OR(
        /* too young: 5th birthday is AFTER cutoff */
        ADDMONTHS({!input_rec_Lead.Date_of_Birth__c}, 60) &gt;
        DATE(
          YEAR(DATEVALUE({!Get_Academic_Term.StartDate})),
          12,
          31
        ),
        /* too old: 6th birthday is ON or BEFORE cutoff */
        ADDMONTHS({!input_rec_Lead.Date_of_Birth__c}, 72) &lt;=
        DATE(
          YEAR(DATEVALUE({!Get_Academic_Term.StartDate})),
          12,
          31
        )
      ),
      /* Grades 1–12: stored picklist values are &quot;1&quot;..&quot;12&quot; */
      IF(
        ISNUMBER({!Loop_Grades_Interested}),
        OR(
          /* too young: age at cutoff &lt; grade + 4 */
          (
            (
              DATE(
                YEAR(DATEVALUE({!Get_Academic_Term.StartDate})),
                12,
                31
              )
              - {!input_rec_Lead.Date_of_Birth__c}
            ) / 365.2425
          ) &lt; (VALUE({!Loop_Grades_Interested}) + 4),
          /* too old: age at cutoff &gt; grade + 6 */
          (
            (
              DATE(
                YEAR(DATEVALUE({!Get_Academic_Term.StartDate})),
                12,
                31
              )
              - {!input_rec_Lead.Date_of_Birth__c}
            ) / 365.2425
          ) &gt; (VALUE({!Loop_Grades_Interested}) + 6)
        ),
        FALSE
      )
    )
  )</expression>
    </formulas>
    <formulas>
        <name>fx_ageToday</name>
        <dataType>Number</dataType>
        <expression>({!$Flow.CurrentDate}-{!input_rec_Lead.Date_of_Birth__c})/365</expression>
        <scale>2</scale>
    </formulas>
