        <label>Update Related ATE</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Individual_Application__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.IndividualApplicationId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>EnrollmentStatus</field>
            <value>
                <elementReference>vStatus</elementReference>
            </value>
        </inputAssignments>
        <object>AcademicTermEnrollment</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Status</targetReference>
        </connector>
        <filterFormula>AND(ISPICKVAL(PRIORVALUE({!$Record.Status}), &quot;Seat Offered&quot;), 
OR(ISPICKVAL({!$Record.Status}, &quot;Withdrawn/Declined&quot;), 
ISPICKVAL({!$Record.Status}, &quot;Rescinded&quot;))
)</filterFormula>
        <object>AcademicInterest</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
