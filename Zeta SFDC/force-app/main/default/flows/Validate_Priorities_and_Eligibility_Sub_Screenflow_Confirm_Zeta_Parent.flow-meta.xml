    <decisions>
        <description>Determines whether any Pending Zeta Parent Priority Item records were found for the selected Individual Application. This controls whether the user is shown a blocked informational screen (nothing to review) or allowed to proceed to the review screen.</description>
        <name>Decision_Priority_Item_Pending_Zeta_Parent_Exists</name>
        <label>Decision | Priority Item | Pending Zeta Parent Exists?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Screen_Priority_Item_Review_Zeta_Parent</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Priority Item Found</defaultConnectorLabel>
        <rules>
            <name>Priority_Item_not_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Record_Priority_Item</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>NoItemstoReview</targetReference>
            </connector>
            <label>Priority Item not Found</label>
        </rules>
    </decisions>
    <decisions>
        <description>Evaluates the value returned by the custom Flow Button component to determine whether the user selected Validate or Deny, and routes the flow to the appropriate assignment path. No updates occur here.</description>
        <name>Decision_Priority_Item_User_Chose_Validate_or_Deny</name>
        <label>Decision | Priority Item | User Chose Validate or Deny</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>nochoiceselected</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No choice selected</defaultConnectorLabel>
        <rules>
            <name>Approve</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>verifystatusbutton.value</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approve</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assignment_VarReviewAction_set_Approved</targetReference>
            </connector>
            <label>Approve</label>
        </rules>
        <rules>
            <name>Deny</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>verifystatusbutton.value</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Deny</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assignment_VarReviewAction_set_Deny</targetReference>
            </connector>
            <label>Deny</label>
        </rules>
    </decisions>
    <description>Manual, user-invoked Screen Flow that lets staff review Priority Item records where Type = “Zeta Parent” and update the Priority Item Status to Verified or Denied. The flow enforces the existing validation requirement by ensuring Verified By and Verified On are populated whenever the record is updated.</description>
    <environments>Default</environments>
    <formulas>
        <description>Builds a display-friendly applicant name for screen headers using the Individual Application record context. Designed for reuse across Zeta Screen Flows without additional record queries.</description>
        <name>fxHeaderApplicantName</name>
        <dataType>String</dataType>
        <expression>TRIM(
  {!Get_Individual_Application.Account.FirstName}
  &amp; &quot; &quot;
  &amp; {!Get_Individual_Application.Account.LastName}
)</expression>
    </formulas>
    <interviewLabel>Validate Priorities and Eligibility (Sub-Screenflow) Confirm Zeta Parent {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Validate Priorities and Eligibility (Sub-Screenflow) Verify Zeta Staff Priority</label>
    <loops>
        <description>Iterates through the multi-selected Priority Items so each record can be prepared in memory for the Denied outcome (set Review Status = Denied and set Validated By/On). No DML occurs during this loop.</description>
        <name>Loop_Priority_Item_Selected_Items_Deny_Path</name>
        <label>Loop | Priority Item | Selected Items (Deny Path)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>priorityItems.outputSelectedRows</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assignment_Priority_Item_Set_Denied_Fields_Loop_Item</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Screen_Priority_Item_Confirm_Validate_Zeta_Parent</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <description>Iterates through the multi-selected Priority Items from the Data Table so each record can be prepared for update in memory (set Review Status = Verified, set Validated By/On). No DML occurs during this loop.</description>
        <name>Loop_Priority_Item_Selected_Items_Validate_Path</name>
        <label>Loop | Priority Item | Selected Items (Approve Path)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>priorityItems.outputSelectedRows</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assignment_Priority_Item_Prepare_Verified_Update</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Screen_Priority_Item_Confirm_Validate_Zeta_Parent</targetReference>
        </noMoreValuesConnector>
    </loops>
