    <status>Active</status>
    <textTemplates>
        <description>Clearly states the action the user chose</description>
        <name>TT_Confirm_Action_Summary</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;div style=&quot;width:100%;border:2px solid #F2C94C;border-radius:10px;padding:16px;background-color:#FFF8E1;text-align:center;&quot;&gt;&lt;strong&gt;Confirm {!varReviewAction}&lt;/strong&gt;&lt;br/&gt;You are about to mark the selected Zeta Parent priority item(s) as &lt;strong&gt;{!varReviewAction}&lt;/strong&gt;.&lt;/div&gt;</text>
    </textTemplates>
    <textTemplates>
        <description>Reinforces finality and provides a clear opt-out.</description>
        <name>TT_Confirm_Action_Warning</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;div style=&quot;width:100%;border:2px solid #4F497A;border-radius:10px;padding:12px;background-color:#F6F5FB;text-align:center;font-size:13px;line-height:18px;&quot;&gt;&lt;strong&gt;Select Confirm to apply these changes.&lt;/strong&gt;&lt;br/&gt;Select Previous to return and make adjustments.&lt;/div&gt;</text>
    </textTemplates>
    <textTemplates>
        <description>Red blocked-state message shown when the user attempts to proceed without selecting a required review action (Validate or Deny).</description>
        <name>TT_Error_Action_Required</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;div style=&quot;width:100%;border:2px solid #EB5757;border-radius:10px;padding:16px;background-color:#FDEDEC;text-align:center;&quot;&gt;&lt;strong&gt;Action Required&lt;/strong&gt;&lt;br/&gt;&lt;strong&gt;Please return and select either Validate or Deny&lt;/strong&gt; using the action buttons provided before continuing.&lt;/div&gt;</text>
    </textTemplates>
    <textTemplates>
        <description>Informs the user that changes will be applied after confirmation.</description>
        <name>TT_Footer_ConfirmationNotice</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;div style=&quot;width:100%;text-align:center;border:2px solid #F2C94C;border-radius:10px;padding:12px;background-color:#FFF8E1;&quot;&gt;You will be asked to confirm before any updates are saved.&lt;/div&gt;</text>
    </textTemplates>
    <textTemplates>
        <description>Introduces the review purpose and instructions.</description>
        <name>TT_Header_ZetaParentReview</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;div style=&quot;width:100%;text-align:center;border:2px solid #F2C94C;border-radius:10px;padding:14px;background-color:#FFF8E1;&quot;&gt;&lt;div&gt;&lt;strong&gt;Zeta Parent Priority Review&lt;/strong&gt;&lt;br/&gt;Review the pending Zeta Parent priority item(s) below and select an outcome.&lt;/div&gt;&lt;div style=&quot;height:10px;&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:20px;&quot;&gt;• &lt;strong&gt;Parent / Staff Name:&lt;/strong&gt; {!Get_Individual_Application.Employee_First_Name__c} {!Get_Individual_Application.Employee_Last_Name__c}&lt;br/&gt;• &lt;strong&gt;Workplace:&lt;/strong&gt; {!Get_Individual_Application.Employee_Workplace__c}&lt;/div&gt;&lt;/div&gt;</text>
    </textTemplates>
    <textTemplates>
        <description>Standard Zeta master header used across Screen Flows to display applicant context (Applicant Name, Grade Applying To, Birthdate). This template is display-only and relies on header variables populated upstream via Assignment.</description>
        <name>TT_Master_Header_ApplicantContext</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;div style=&quot;width:100%;border:2px solid #4F497A;border-radius:10px;padding:18px;background-color:#F6F5FB;text-align:center;&quot;&gt;&lt;div style=&quot;font-size:14px;line-height:20px;&quot;&gt;&lt;strong&gt;Applicant:&lt;/strong&gt; {!fxHeaderApplicantName}&lt;br/&gt;&lt;strong&gt;Grade Applying To:&lt;/strong&gt; {!varHeaderGradeApplyingTo}&lt;br/&gt;&lt;strong&gt;Birthdate:&lt;/strong&gt; {!varHeaderBirthdate}&lt;br/&gt;&lt;strong&gt;School Start Age:&lt;/strong&gt; {!Get_Individual_Application.School_Start_Age__c}&lt;br/&gt;&lt;strong&gt;Address:&lt;/strong&gt; {!Get_Individual_Application.Account.PersonMailingStreet}, {!Get_Individual_Application.Account.PersonMailingCity}, {!Get_Individual_Application.Account.PersonMailingState} {!Get_Individual_Application.Account.PersonMailingPostalCode}&lt;/div&gt;&lt;/div&gt;</text>
    </textTemplates>
    <textTemplates>
        <description>Green status message indicating there are no Zeta Parent Priority Items requiring review for the selected application.</description>
        <name>TT_Status_No_Priority_Items</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;div style=&quot;width:100%;border:2px solid #27AE60;border-radius:10px;padding:16px;background-color:#E9F7EF;text-align:center;&quot;&gt;&lt;strong&gt;No Priority Items to Review&lt;/strong&gt;&lt;br/&gt;There are currently no Zeta Parent priority items that require review for this application.&lt;/div&gt;</text>
    </textTemplates>
    <textTemplates>
        <description>Green success message shown after Priority Item review updates have been successfully applied.</description>
        <name>TT_Success_Priority_Items_Updated</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;div style=&quot;width:100%;border:2px solid #27AE60;border-radius:10px;padding:16px;background-color:#E9F7EF;text-align:center;&quot;&gt;&lt;strong&gt;Updates Complete&lt;/strong&gt;&lt;br/&gt;The selected Zeta Parent priority item(s) have been successfully updated.&lt;/div&gt;</text>
    </textTemplates>
