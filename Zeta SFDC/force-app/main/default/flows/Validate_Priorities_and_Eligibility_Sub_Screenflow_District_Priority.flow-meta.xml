    <description>Created by: Elevation Solutions

Manual review subflow for Zeta staff to determine the student’s district using the student’s address (Google Maps link) and to apply In-District Priority on selected School Applications for the current Individual Application. Intended to be launched from the Master Eligibility Review screen flow and return control back to that flow on Finish.</description>
    <environments>Default</environments>
    <formulas>
        <name>fx_GoogleMapsCSDUrl</name>
        <dataType>String</dataType>
        <expression>&quot;https://www.google.com/maps/d/embed?mid=1ygG3l1c60y44FEjrjHWmJVAefFyOqL0&amp;ehbc=2E312F&amp;ll=40.84058589050526%2C-73.87117008508005&amp;z=13&quot;</expression>
    </formulas>
    <formulas>
        <description>Google Maps search URL built from the student’s mailing address on the Individual Application. Used on the district validation screen as a clickable link.</description>
        <name>fx_GoogleMapsUrl</name>
        <dataType>String</dataType>
        <expression>&quot;https://www.google.com/maps/search/?api=1&amp;query=&quot;
&amp;
SUBSTITUTE(
  {!Get_Records_Individual_Application_Current_Record.Account.PersonMailingStreet},
  &quot; &quot;,
  &quot;+&quot;
)
&amp; &quot;+&quot;
&amp;
SUBSTITUTE(
  {!Get_Records_Individual_Application_Current_Record.Account.PersonMailingCity},
  &quot; &quot;,
  &quot;+&quot;
)
&amp; &quot;+&quot;
&amp;
SUBSTITUTE(
  {!Get_Records_Individual_Application_Current_Record.Account.PersonMailingState},
  &quot; &quot;,
  &quot;+&quot;
)
&amp; &quot;+&quot;
&amp;
SUBSTITUTE(
  {!Get_Records_Individual_Application_Current_Record.Account.PersonMailingPostalCode},
  &quot; &quot;,
  &quot;+&quot;
)</expression>
    </formulas>
    <formulas>
        <name>fxAddress</name>
        <dataType>String</dataType>
        <expression>TRIM(
    BLANKVALUE({!Get_Account.PersonMailingStreet}, &apos;&apos;) &amp;
    IF(NOT(ISBLANK({!Get_Account.PersonMailingStreet})), &apos;, &apos;, &apos;&apos;) &amp;
    BLANKVALUE({!Get_Account.PersonMailingCity}, &apos;&apos;) &amp;
    IF(NOT(ISBLANK({!Get_Account.PersonMailingCity})), &apos;, &apos;, &apos;&apos;) &amp;
    BLANKVALUE({!Get_Account.PersonMailingState}, &apos;&apos;) &amp;
    IF(NOT(ISBLANK({!Get_Account.PersonMailingPostalCode})), &apos; &apos;, &apos;&apos;) &amp;
    BLANKVALUE({!Get_Account.PersonMailingPostalCode}, &apos;&apos;) &amp;
    IF(NOT(ISBLANK({!Get_Account.PersonMailingCountry})), &apos;, &apos;, &apos;&apos;) &amp;
    BLANKVALUE({!Get_Account.PersonMailingCountry}, &apos;&apos;)
)</expression>
    </formulas>
    <formulas>
        <name>fxDistrcitId</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Records_Individual_Application_Current_Record.Student_District_Id__c}), 
{!varStudentDistrictId}, 
{!Get_Records_Individual_Application_Current_Record.Student_District_Id__c})</expression>
    </formulas>
