    <decisions>
        <description>Checks whether the current Individual Application record has a usable primary parent email.</description>
        <name>Decision_Parent_Email_Found_IA</name>
        <label>Decision | Parent Email Found? | IA</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_Add_Skipped_Record_IA</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Parent Email, IA</defaultConnectorLabel>
        <rules>
            <name>Has_Parent_Email_IA</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Individual_Applications.Parent_Guardian_1_Email__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Add_Valid_Recipient_IA</targetReference>
            </connector>
            <label>Has Parent Email, IA</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks whether the current School Application record has a usable primary parent email.</description>
        <name>Decision_Parent_Email_Found_SA</name>
