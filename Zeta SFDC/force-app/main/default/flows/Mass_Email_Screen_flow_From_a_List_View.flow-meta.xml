                <targetReference>Copy_1_of_Assign_Add_Valid_Recipient_IA</targetReference>
            </connector>
            <label>Has Parent Email, SA</label>
        </rules>
    </decisions>
    <decisions>
        <description>Routes the flow to the correct record retrieval and recipient resolution path based on the source object.</description>
        <name>Decision_Source_Object</name>
        <label>Decision | Source Object</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Unsupported_Object</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Unsupported Object</defaultConnectorLabel>
        <rules>
            <name>Individual_Application</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>in_sourceObjectApiName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>IndividualApplication</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Individual_Applications_Selected</targetReference>
            </connector>
            <label>Individual Application</label>
        </rules>
        <rules>
            <name>School_Application</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>in_sourceObjectApiName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>AcademicInterest</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_School_Applications_Selected</targetReference>
            </connector>
            <label>School Application</label>
        </rules>
        <rules>
            <name>Academic_Term_Enrollment</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>in_sourceObjectApiName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>AcademicTermEnrollment</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_ATE_Records_Selected</targetReference>
            </connector>
            <label>Academic Term Enrollment</label>
        </rules>
    </decisions>
    <description>Launched from list views on Individual Application, School Application, or Academic Term Enrollment. Resolves parent recipients, filters templates by action, previews email content, sends communications, and stamps outreach fields.</description>
    <environments>Default</environments>
    <interviewLabel>Mass Email (Screen flow) From a List View {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Mass Email (Screen flow) From a List View</label>
    <loops>
        <description>Loops through the selected Individual Application records one at a time so the flow can resolve the parent email and categorize each record as valid or skipped.</description>
        <name>Loop_Individual_Applications</name>
        <label>Loop | Individual Applications</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Individual_Applications_Selected</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Decision_Parent_Email_Found_IA</targetReference>
        </nextValueConnector>
    </loops>
    <loops>
        <description>Loops through selected School Application records to evaluate whether a valid parent email exists for each record.</description>
        <name>Loop_School_Applications</name>
        <label>Loop | School Applications</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_School_Applications_Selected</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Decision_Parent_Email_Found_SA</targetReference>
        </nextValueConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
