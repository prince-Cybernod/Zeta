    <decisions>
        <description>If an ATE exists with a Status other than &apos;1. Welcome Phase&apos;, another seat cannot be accepted without Zeta staff assistance.</description>
        <name>ATE_found</name>
        <label>ATE found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_School_Apps_to_Decline</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>ATE_exists_and_EnrollmentStatus_1_Welcome_Phase</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_ATE_related_to_this_Individual_App.EnrollmentStatus</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>1. Welcome Phase</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_ATE_related_to_this_Individual_App</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_FALSE_var_bool_SchoolAcceptSuccess</targetReference>
            </connector>
            <label>ATE exists and EnrollmentStatus != &apos;1. Welcome Phase&apos;</label>
        </rules>
        <rules>
            <name>ATE_Exists_and_EnrollmentStatus_1_Welcome_Phase1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_ATE_related_to_this_Individual_App</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_ATE_related_to_this_Individual_App.EnrollmentStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>1. Welcome Phase</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_School_Apps_to_Decline</targetReference>
            </connector>
            <label>ATE Exists and EnrollmentStatus = &apos;1. Welcome Phase&apos;</label>
        </rules>
    </decisions>
    <decisions>
        <name>Records_to_Decline_Found</name>
        <label>Records to Decline Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_School_App_to_be_accepted</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_School_Apps_to_Decline</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_through_School_Apps_to_Decline</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Before updating the Status to &apos;Seat Accepted&apos;, review School Apps related to the same Individual Application to ensure there is only a single School App with Status &apos;Accepted&apos;.</description>
    <environments>Default</environments>
    <interviewLabel>Seat Acceptance Review (Autolaunched) {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Seat Acceptance Review (Autolaunched)</label>
    <loops>
        <name>Loop_through_School_Apps_to_Decline</name>
        <label>Loop through School Apps to Decline</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_School_Apps_to_Decline</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_values</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_School_App_to_be_accepted</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
