    <decisions>
        <name>Intent_to_Return_Task_Created</name>
        <label>Intent to Return Task Created?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Stage_Task_for_Creation</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Task_Created</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Academic_Term_Enrollment.Intent_to_Return_Task_Creation_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Cannot_Proceed_Screen</targetReference>
            </connector>
            <label>Yes, Task Created</label>
        </rules>
    </decisions>
