    <decisions>
        <description>Check if AAR record has an inverse relationship record.</description>
        <name>Does_PRR_have_an_inverse</name>
        <label>Does PRR have an inverse?</label>
        <locationX>182</locationX>
        <locationY>566</locationY>
        <defaultConnector>
            <targetReference>No_Inverse_Relationship_Role_Found</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Inverse_exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Related_Inverse_Party_Relationship_Role.RelatedInverseRecordId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_AAR2</targetReference>
            </connector>
            <label>Yes, Inverse exists</label>
        </rules>
    </decisions>
