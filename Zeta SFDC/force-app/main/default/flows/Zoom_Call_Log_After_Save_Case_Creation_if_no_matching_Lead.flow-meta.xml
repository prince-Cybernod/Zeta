<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>If a Zoom Caller leaves a voicemail, create a Case for them. Triggered for Call Result = &apos;no_answer&apos; and &apos;rejected&apos;</description>
    <environments>Default</environments>
    <formulas>
        <name>fx_CalleeUser</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISNULL({!Get_Callee_User.Id})), {!Get_Callee_User.Id}, &apos;&apos;)</expression>
    </formulas>
    <formulas>
        <description>Return WhatId from Task if it&apos;s an Account, else leave blank</description>
        <name>fx_TaskWhatId_ifAccount</name>
        <dataType>String</dataType>
        <expression>IF(LEFT({!Get_Related_Task.WhatId}, 3) = &quot;001&quot;, {!Get_Related_Task.WhatId}, null)</expression>
    </formulas>
    <formulas>
        <description>Return WhoId from Task if Contact, else leave blank</description>
        <name>fx_TaskWhoId_ifContact</name>
        <dataType>String</dataType>
        <expression>IF(LEFT({!Get_Related_Task.WhoId}, 3) = &quot;003&quot;, {!Get_Related_Task.WhoId}, null)</expression>
    </formulas>
    <interviewLabel>Zoom Call Log (After Save) | Case Creation if no matching Lead {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Zoom Call Log (After Save) | Case Creation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Case</name>
        <label>Create Case</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Task_with_this_Case</targetReference>
        </connector>
        <inputAssignments>
            <field>AccountId</field>
            <value>
                <elementReference>fx_TaskWhatId_ifAccount</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ContactId</field>
            <value>
                <elementReference>fx_TaskWhoId_ifContact</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Origin</field>
            <value>
                <stringValue>Zoom Voicemail</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>SuppliedPhone</field>
            <value>
                <elementReference>$Record.ZVC__Caller_Phone_Number__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Zoom_Call_Log__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Case</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Callee_User</name>
        <label>Get Callee User</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Create_Case</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Zoom_Phone_Number__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ZVC__Callee_Phone_Number__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>User</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Related_Task</name>
        <label>Get Related Task</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Callee_User</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ZVC__Task_Id__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Populate_Call_To_User</name>
        <label>Populate Call To User</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Call_To_User__c</field>
            <value>
                <elementReference>fx_CalleeUser</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Task_with_this_Case</name>
        <label>Update Task with this Case</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Populate_Call_To_User</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ZVC__Task_Id__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>Create_Case.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Related_Task</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>1 AND (2 OR 3 OR 4 OR 5)</filterLogic>
        <filters>
            <field>ZVC__Call_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>inbound</stringValue>
            </value>
        </filters>
        <filters>
            <field>ZVC__Call_Result__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>rejected</stringValue>
            </value>
        </filters>
        <filters>
            <field>ZVC__Call_Result__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>no_answer</stringValue>
            </value>
        </filters>
        <filters>
            <field>ZVC__Call_Result__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>ring_timeout</stringValue>
            </value>
        </filters>
        <filters>
            <field>ZVC__Call_Result__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>abandoned</stringValue>
            </value>
        </filters>
        <object>ZVC__Zoom_Call_Log__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
