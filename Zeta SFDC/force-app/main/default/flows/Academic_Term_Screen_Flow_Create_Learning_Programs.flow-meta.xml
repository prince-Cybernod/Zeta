<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_School_ID_to_txt_col_Schools_to_create_LPs_for</name>
        <label>Add School ID to txt_col_Schools_to_create_LPs_for</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>txt_col_Schools_to_create_LPs_for</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Selected_Schools_Learning_Program_Assignment.ProviderId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Selected_Schools_Learning_Program_Assignment</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Add_to_Collection</name>
        <label>Add to Collection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>var_col_PreviousYear_LearningPrograms</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>var_rec_previous_LearningProgram</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_created_Learning_Programs</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Learning_Program_record_values</name>
        <label>Assign Learning Program record values</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>var_rec_LearningProgram</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_rec_LearningProgram.LearningId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Selected_Schools_Learning_Program_Assignment.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_rec_LearningProgram.School__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Selected_Schools_Learning_Program_Assignment.ProviderId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_rec_LearningProgram.Academic_Term__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Academic_Term.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_rec_LearningProgram.Program_Type__c</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_rec_LearningProgram.Name</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Selected_Schools_Learning_Program_Assignment.Name</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_col_LearningPrograms</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>var_rec_LearningProgram</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_School_ID_to_txt_col_Schools_to_create_LPs_for</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Learning_record_values</name>
        <label>Assign Learning record values</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>var_rec_Learning</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_rec_Learning.ProviderId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Selected_Schools_Learning_Assignment.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_rec_Learning.Type</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>LearningProgram</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_rec_Learning.IsActive</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fx_Active</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_rec_Learning.Name</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fx_Learning_LearningProgramName</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_col_Learning</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>var_rec_Learning</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Selected_Schools_Learning_Assignment</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Values_to_Previous_Year_Learning_Program</name>
        <label>Assign Values to Previous Year Learning Program</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>var_rec_previous_LearningProgram</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_rec_previous_LearningProgram.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>var_txt_LearningProgram</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_rec_previous_LearningProgram.Learning_Program_for_Upcoming_Year__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_created_Learning_Programs.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_to_Collection</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_var_txt_LearningProgram</name>
        <label>Assign var_txt_LearningProgram</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>var_txt_LearningProgram</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_to_Convert_the_Found_Learning_Program_to_NOT_Collection.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_to_Convert_the_Found_Learning_Program_to_NOT_Collection</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Count_found_school_Accounts</name>
        <label>Count found school Accounts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>cnt_schoolAccounts</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>var_col_SchoolAccounts</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Select_Schools</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Clear var_txt_LearningProgram for every loop iteration</description>
        <name>Null_var_txt_LearningProgram</name>
        <label>Null var_txt_LearningProgram</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>var_txt_LearningProgram</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <connector>
            <targetReference>Filter_to_previous_year_s_Learning_Program_for_the_same_School</targetReference>
        </connector>
    </assignments>
    <collectionProcessors>
        <name>Filter_to_previous_year_s_Learning_Program_for_the_same_School</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>Filter to previous year&apos;s Learning Program for the same School</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>currentItem_Filter_to_previous_year_s_Learning_Program_for_the_same_School</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>Get_Learning_Programs_for_Previous_Year</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_Filter_to_previous_year_s_Learning_Program_for_the_same_School.School__c</leftValueReference>
            <operator>EqualTo</operator>
            <rightValue>
                <elementReference>Loop_created_Learning_Programs.School__c</elementReference>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>Previous_Year_Learning_Program_for_this_school_found</targetReference>
        </connector>
    </collectionProcessors>
    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <decisions>
        <name>Is_this_Academic_Term_listed_as_an_Upcoming_Term</name>
        <label>Is this Academic Term listed as an Upcoming Term?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Academic_Term_is_not_listed_as_Upcoming_Term</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_listed_as_an_upcoming_Term</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Academic_Term_where_recordId_Academic_Term_for_Upcoming_Year_c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Learning_Programs_related_to_this_Academic_Term</targetReference>
            </connector>
            <label>Yes, listed as an upcoming Term</label>
        </rules>
    </decisions>
    <decisions>
        <name>Learning_Programs_for_the_Previous_Year_School_found</name>
        <label>Learning Programs for the Previous Year + School found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Success</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Learning_Programs_for_Previous_Year</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_created_Learning_Programs</targetReference>
            </connector>
            <label>Yes, Found</label>
        </rules>
    </decisions>
    <decisions>
        <description>If Learning Programs found, review them to filter out any schools that already have a Learning Program for this Academic Term.</description>
        <name>Learning_Programs_found</name>
        <label>Learning Programs found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_school_Accounts</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Learning_Programs_found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Learning_Programs_related_to_this_Academic_Term</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_School_ID_text_collection</targetReference>
            </connector>
            <label>Yes Learning Programs found</label>
        </rules>
    </decisions>
    <decisions>
        <description>Assign values to update the previous year&apos;s Learning Program if one is found. Otherwise do nothing.</description>
        <name>Previous_Year_Learning_Program_for_this_school_found</name>
        <label>Previous Year Learning Program for this school found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_created_Learning_Programs</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Found0</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Filter_to_previous_year_s_Learning_Program_for_the_same_School</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_to_Convert_the_Found_Learning_Program_to_NOT_Collection</targetReference>
            </connector>
            <label>Yes, Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Values_in_var_col_PreviousYear_LearningPrograms_to_update</name>
        <label>Values in var_col_PreviousYear_LearningPrograms to update?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Success</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_col_PreviousYear_LearningPrograms</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Previous_Year_Learning_Programs</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>From an Academic Term, select school Accounts to create Learning Programs for that are related to the Academic Term this flow is launched from.

Created By: Elevation Solutions</description>
    <environments>Default</environments>
    <formulas>
        <name>fx_Active</name>
        <dataType>Boolean</dataType>
        <expression>AND(
DATEVALUE({!Get_Academic_Term.StartDate})     &lt;= TODAY(),
    OR(
        ISBLANK({!Get_Academic_Term.EndDate}),
DATEVALUE({!Get_Academic_Term.EndDate}) 
        &lt;= TODAY()
    )
)</expression>
    </formulas>
    <formulas>
        <name>fx_Learning_LearningProgramName</name>
        <dataType>String</dataType>
        <expression>{!Loop_Selected_Schools_Learning_Assignment.Zeta_School_Name__c}+&apos; &apos;+{!Get_Academic_Term.Name}</expression>
    </formulas>
    <interviewLabel>Academic Term (Screen Flow): Create Future Learning Programs {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Academic Term (Screen Flow): Create Learning Programs</label>
    <loops>
        <description>Now with the records in this collection having IDs (they&apos;ve been created), identify their previous year counterpart and update the field Learning_Program_for_Upcoming_Year__c if one exists</description>
        <name>Loop_created_Learning_Programs</name>
        <label>Loop created Learning Programs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>var_col_LearningPrograms</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Null_var_txt_LearningProgram</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Values_in_var_col_PreviousYear_LearningPrograms_to_update</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Selected_Schools_Learning_Assignment</name>
        <label>Loop Selected Schools - Learning Assignment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>dt_School.selectedRows</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Learning_record_values</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Create_Learning_records</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Selected_Schools_Learning_Program_Assignment</name>
        <label>Loop Selected Schools - Learning Program Assignment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>var_col_Learning</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Learning_Program_record_values</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Create_Learning_Program_records</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <description>There will only ever be a max of 1 record returned but necessary to loop so that is in the right format for assignment in the following steps.</description>
        <name>Loop_to_Convert_the_Found_Learning_Program_to_NOT_Collection</name>
        <label>Loop to Convert the Found Learning Program to NOT Collection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Filter_to_previous_year_s_Learning_Program_for_the_same_School</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_var_txt_LearningProgram</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Assign_Values_to_Previous_Year_Learning_Program</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Learning_Program_records</name>
        <label>Create Learning Program records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Learning_Programs_for_Previous_Year</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Copy_1_of_Flow_Error_on_Create</targetReference>
        </faultConnector>
        <inputReference>var_col_LearningPrograms</inputReference>
    </recordCreates>
    <recordCreates>
        <name>Create_Learning_records</name>
        <label>Create Learning records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Loop_Selected_Schools_Learning_Program_Assignment</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Flow_Error_on_Create</targetReference>
        </faultConnector>
        <inputReference>var_col_Learning</inputReference>
    </recordCreates>
    <recordLookups>
        <name>Get_Academic_Term</name>
        <label>Get Academic Term</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Academic_Term_where_recordId_Academic_Term_for_Upcoming_Year_c</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>AcademicTerm</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>In order to continue the flow, we require the Academic Term the user is on is listed as Academic_Term_for_Upcoming_Year__c for a single other Academic Term. This is to enable updating the previous years&apos; Learning Programs</description>
        <name>Get_Academic_Term_where_recordId_Academic_Term_for_Upcoming_Year_c</name>
        <label>Get Academic Term where recordId = Academic_Term_for_Upcoming_Year__c</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_this_Academic_Term_listed_as_an_Upcoming_Term</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Academic_Term_for_Upcoming_Year__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>AcademicTerm</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>For previous year AND schools that upcoming year Learning Programs were just created for</description>
        <name>Get_Learning_Programs_for_Previous_Year</name>
        <label>Get Learning Programs for Previous Year + School</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Learning_Programs_for_the_Previous_Year_School_found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>School__c</field>
            <operator>In</operator>
            <value>
                <elementReference>txt_col_Schools_to_create_LPs_for</elementReference>
            </value>
        </filters>
        <filters>
            <field>Academic_Term__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Academic_Term_where_recordId_Academic_Term_for_Upcoming_Year_c.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>LearningProgram</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>These will be used to ensure we do not display school Accounts that already have a Learning Program related to this Academic Term</description>
        <name>Get_Learning_Programs_related_to_this_Academic_Term</name>
        <label>Get Learning Programs related to this Academic Term</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_School_Account_record_type</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Academic_Term__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>LearningProgram</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_School_Account_record_type</name>
        <label>Get School Account record type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Learning_Programs_found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SobjectType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Account</stringValue>
            </value>
        </filters>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>School</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>RecordType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_school_Accounts</name>
        <label>Get school Accounts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Count_found_school_Accounts</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>RecordTypeId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_School_Account_record_type.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotIn</operator>
            <value>
                <elementReference>Create_School_ID_text_collection</elementReference>
            </value>
        </filters>
        <object>Account</object>
        <outputReference>var_col_SchoolAccounts</outputReference>
        <queriedFields>Name</queriedFields>
        <queriedFields>Zeta_School_Name__c</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>Update_Previous_Year_Learning_Programs</name>
        <label>Update Previous Year Learning Programs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Success</targetReference>
        </connector>
        <inputReference>var_col_PreviousYear_LearningPrograms</inputReference>
