    <decisions>
        <name>Does_ATE_Already_Exist</name>
        <label>Does ATE Already Exist?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Contact</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_ATE_Already_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_ATE_for_Next_Year</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <label>Yes, ATE Already Exists</label>
        </rules>
    </decisions>
    <description>Creates a new Academic Term Enrollment for the upcoming school year for returning students when Intent to Return is updated to &apos;Yes&apos;.

Created by: Elevation Solutions</description>
    <environments>Default</environments>
    <formulas>
        <name>fxGradeApplied</name>
        <dataType>String</dataType>
        <expression>IF(
    $Record.Zeta_Approved_Grade__c = &quot;PK&quot;, &quot;K&quot;,
    IF(
        $Record.Zeta_Approved_Grade__c = &quot;K&quot;, &quot;1&quot;,
        IF(
            $Record.Zeta_Approved_Grade__c = &quot;1&quot;, &quot;2&quot;,
            IF(
                $Record.Zeta_Approved_Grade__c = &quot;2&quot;, &quot;3&quot;,
                IF(
                    $Record.Zeta_Approved_Grade__c = &quot;3&quot;, &quot;4&quot;,
                    IF(
                        $Record.Zeta_Approved_Grade__c = &quot;4&quot;, &quot;5&quot;,
                        IF(
                            $Record.Zeta_Approved_Grade__c = &quot;5&quot;, &quot;6&quot;,
                            IF(
                                $Record.Zeta_Approved_Grade__c = &quot;6&quot;, &quot;7&quot;,
                                IF(
                                    $Record.Zeta_Approved_Grade__c = &quot;7&quot;, &quot;8&quot;,
                                    IF(
                                        $Record.Zeta_Approved_Grade__c = &quot;8&quot;, &quot;9&quot;,
                                        IF(
                                            $Record.Zeta_Approved_Grade__c = &quot;9&quot;, &quot;10&quot;,
                                            IF(
                                                $Record.Zeta_Approved_Grade__c = &quot;10&quot;, &quot;11&quot;,
                                                IF(
                                                    $Record.Zeta_Approved_Grade__c = &quot;11&quot;, &quot;12&quot;,
                                                    NULL
                                                )
                                            )
                                        )
                                    )
                                )
                            )
                        )
                    )
                )
            )
        )
    )
)</expression>
    </formulas>
