<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_var_rec_Lead</name>
        <label>Assign var_rec_Lead</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>var_rec_Lead</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>input_LeadRecord</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Does_this_Lead_have_a_related_CBO</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Does_this_Lead_have_a_related_CBO</name>
        <label>Does this Lead have a related CBO?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CBO_is_populated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_rec_Lead.CBO_Account__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Individual_Application</targetReference>
            </connector>
            <label>CBO is populated</label>
        </rules>
    </decisions>
    <decisions>
        <description>If null, get Lead using input_LeadId</description>
        <name>input_LeadRecord_not_null</name>
        <label>input_LeadRecord not null?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Lead</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Not_null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>input_LeadRecord</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_var_rec_Lead</targetReference>
            </connector>
            <label>Not null</label>
        </rules>
    </decisions>
    <description>Created By: Elevation Solutions</description>
    <environments>Default</environments>
    <interviewLabel>Autolaunched | Populate CBO on Individual Application {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Autolaunched | Populate CBO on Individual Application</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Lead</name>
        <label>Get Lead</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Does_this_Lead_have_a_related_CBO</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>input_LeadId</elementReference>
            </value>
        </filters>
        <object>Lead</object>
        <outputReference>var_rec_Lead</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>CBO_Account__c</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>Update_Individual_Application</name>
        <label>Update Individual Application</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>input_ApplicationID</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>CBO_Account__c</field>
            <value>
                <elementReference>var_rec_Lead.CBO_Account__c</elementReference>
            </value>
        </inputAssignments>
        <object>IndividualApplication</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>input_LeadRecord_not_null</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>input_ApplicationID</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>input_LeadId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>If the Lead record has already been retrieved, we don&apos;t need to GET the Lead in this subflow</description>
        <name>input_LeadRecord</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <objectType>Lead</objectType>
    </variables>
    <variables>
        <name>var_rec_Lead</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Lead</objectType>
    </variables>
</Flow>
