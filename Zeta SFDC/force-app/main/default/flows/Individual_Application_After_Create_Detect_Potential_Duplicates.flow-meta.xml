    <decisions>
        <description>Only proceed if we found at least one match.</description>
        <name>Decision_Any_Matches_Found</name>
        <label>Decision | Any Matches Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Matches</defaultConnectorLabel>
        <rules>
            <name>Matches_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Individual_Application_Candidate_Duplicates</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Matching_Individual_Apps</targetReference>
            </connector>
            <label>Matches Found</label>
        </rules>
    </decisions>
    <description>Created By: Elevation Solutions

On create, searches for other Individual Applications for the same student account that share either the same primary guardian or same secondary guardian, then creates Duplicate Record Alert records in both directions.</description>
    <environments>Default</environments>
    <interviewLabel>Individual Application (After Create) Detect Potential Duplicates {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Individual Application (After Create) Detect Potential Duplicates</label>
    <loops>
        <name>Loop_Matching_Individual_Apps</name>
        <label>Loop | Matching Individual Apps</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Individual_Application_Candidate_Duplicates</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Duplicate_Record_Alert_Set_Field_Values</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Create_Duplicate_Record_Alerts_Batch_Insert</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>Creates all Duplicate Record Alert records in a single DML operation.</description>
        <name>Create_Duplicate_Record_Alerts_Batch_Insert</name>
        <label>Create | Duplicate Record Alerts | Batch Insert</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>colDuplicateRecordAlerts</inputReference>
    </recordCreates>
    <recordLookups>
        <description>Retrieves other Individual Applications that share either the same primary guardian or same secondary guardian, excluding the current record, so the flow can evaluate rigid duplicate matching in the loop.</description>
        <name>Get_Individual_Application_Candidate_Duplicates</name>
        <label>Get | Individual Application | Candidate Duplicates</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_Any_Matches_Found</targetReference>
        </connector>
        <filterLogic>1 AND ((2 AND 3) OR (4 AND 5)) AND 6 AND 7</filterLogic>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Primary_Guardian__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Primary_Guardian__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Primary_Guardian__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Secondary_Guardian__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Secondary_Guardian__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Secondary_Guardian__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Application_Timeline__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Application_Timeline__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>IndividualApplication</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Applied</stringValue>
            </value>
        </filters>
        <object>IndividualApplication</object>
        <recordTriggerType>Update</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Get_Individual_Application_Candidate_Duplicates</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
