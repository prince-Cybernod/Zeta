    <decisions>
        <description>This decision element checks to see if the Account selected is a Person Account. If the record is a Person Account, the end-user should not be given the choice to create an AccountAccountRelation. Conversely, if the originating record is an Organization Account, the end-user should not be given the choice to create ContactContactRelations.</description>
        <name>Was_a_Person_Account_Selected</name>
        <label>Was a Person Account Selected?</label>
        <locationX>446</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Select_an_Organization_Relationship</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No - Surface Organization Relationship Choices</defaultConnectorLabel>
        <rules>
            <name>Yes_Surface_Person_Relationship_Choices</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account_ID.IsPersonAccount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Select_a_Person_Relationship</targetReference>
            </connector>
            <label>Yes - Surface Person Relationship Choices</label>
        </rules>
    </decisions>
    <decisions>
