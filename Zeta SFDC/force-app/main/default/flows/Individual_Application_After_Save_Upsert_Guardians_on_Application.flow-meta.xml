)</expression>
    </formulas>
    <formulas>
        <name>fxPrimaryGuardianPersonContactId</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Guardian_1_Match_Guardian.Id}), {!Create_Guardian_1_Account.PersonContactId}, {!Get_Guardian_1_Match_Guardian.PersonContactId})</expression>
    </formulas>
    <formulas>
        <name>fxSecondaryGuardian_PersonContactId</name>
        <dataType>String</dataType>
        <expression>IF(
  NOT(ISBLANK({!Get_Guardian_2_Match_Guardian.Id})),
  {!Get_Guardian_2_Match_Guardian.PersonContactId},
  {!Create_Guardian_2_Account.PersonContactId}
)</expression>
    </formulas>
