        </connector>
    </assignments>
    <assignments>
        <name>Assign_District_Priority_to_TRUE</name>
        <label>Assign District Priority to TRUE</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>var_rec_SchoolApps.In_District_Priority__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_to_Collection</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Clear District Priority for all School Apps. Since the Student District Id field has changed, any that previously matched no longer will.</description>
        <name>Assign_new_School_App_values</name>
        <label>Assign new School App values</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>var_rec_SchoolApps</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_rec_SchoolApps.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_School_Apps.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_rec_SchoolApps.In_District_Priority__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Does_this_School_App_match_the_student_s_District_Priority</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Does_this_School_App_match_the_Student_District_Id</name>
        <label>Does this School App match the Student District Id?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_School_App_matches_Student_District_Id</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>input_rec_SchoolApp.fxSchool_District_Id__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>input_rec_IndividualApp.Student_District_Id__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_In_District_Priority_c_to_TRUE</targetReference>
            </connector>
            <label>Yes, School App matches Student District Id</label>
        </rules>
    </decisions>
    <decisions>
        <name>Does_this_School_App_match_the_student_s_District_Priority</name>
        <label>Does this School App match the student&apos;s District Priority?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Add_to_Collection</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Districts_match</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_School_Apps.fxSchool_District_Id__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>input_rec_IndividualApp.Student_District_Id__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_District_Priority_to_TRUE</targetReference>
            </connector>
            <label>Yes, Districts match</label>
        </rules>
    </decisions>
    <decisions>
        <description>This distinguishes the School App recs we are analyzing.</description>
        <name>Triggered_from_Individual_App_Update_or_New_School_App</name>
        <label>Triggered from Individual App Update or New School App?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Individual_App_Update</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>input_IndivAppUpdate</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_All_School_Apps_related_to_this_Individual_App</targetReference>
            </connector>
            <label>Individual App Update</label>
        </rules>
        <rules>
            <name>School_App_Create</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>input_SchoolAppCreate</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Does_this_School_App_match_the_Student_District_Id</targetReference>
            </connector>
            <label>School App Create</label>
        </rules>
    </decisions>
    <description>Created By: Elevation Solutions</description>
    <environments>Default</environments>
