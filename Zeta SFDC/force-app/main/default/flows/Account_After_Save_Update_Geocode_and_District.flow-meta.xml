    <formulas>
        <name>fxAddress</name>
        <dataType>String</dataType>
        <expression>IF(
    {!$Record.IsPersonAccount},
    TRIM(
        BLANKVALUE({!$Record.PersonMailingStreet}, &apos;&apos;) &amp;
        IF(NOT(ISBLANK({!$Record.PersonMailingStreet})), &apos;, &apos;, &apos;&apos;) &amp;
        BLANKVALUE({!$Record.PersonMailingCity}, &apos;&apos;) &amp;
        IF(NOT(ISBLANK({!$Record.PersonMailingCity})), &apos;, &apos;, &apos;&apos;) &amp;
        BLANKVALUE({!$Record.PersonMailingState}, &apos;&apos;) &amp;
        IF(NOT(ISBLANK({!$Record.PersonMailingPostalCode})), &apos; &apos;, &apos;&apos;) &amp;
        BLANKVALUE({!$Record.PersonMailingPostalCode}, &apos;&apos;) &amp;
        IF(NOT(ISBLANK({!$Record.PersonMailingCountry})), &apos;, &apos;, &apos;&apos;) &amp;
        BLANKVALUE({!$Record.PersonMailingCountry}, &apos;&apos;)
    ),
    TRIM(
        BLANKVALUE({!$Record.BillingStreet}, &apos;&apos;) &amp;
        IF(NOT(ISBLANK({!$Record.BillingStreet})), &apos;, &apos;, &apos;&apos;) &amp;
        BLANKVALUE({!$Record.BillingCity}, &apos;&apos;) &amp;
        IF(NOT(ISBLANK({!$Record.BillingCity})), &apos;, &apos;, &apos;&apos;) &amp;
        BLANKVALUE({!$Record.BillingState}, &apos;&apos;) &amp;
        IF(NOT(ISBLANK({!$Record.BillingPostalCode})), &apos; &apos;, &apos;&apos;) &amp;
        BLANKVALUE({!$Record.BillingPostalCode}, &apos;&apos;) &amp;
        IF(NOT(ISBLANK({!$Record.BillingCountry})), &apos;, &apos;, &apos;&apos;) &amp;
        BLANKVALUE({!$Record.BillingCountry}, &apos;&apos;)
    )
)</expression>
    </formulas>
    <formulas>
        <name>fxAddressComplete</name>
        <dataType>Boolean</dataType>
        <expression>OR(
    AND(
        {!$Record.IsPersonAccount},
        NOT(ISBLANK({!$Record.PersonMailingStreet})),
        NOT(ISBLANK({!$Record.PersonMailingCity})),
        NOT(ISBLANK({!$Record.PersonMailingState})),
        NOT(ISBLANK({!$Record.PersonMailingPostalCode}))
    ),
    AND(
        NOT({!$Record.IsPersonAccount}),
        NOT(ISBLANK({!$Record.BillingStreet})),
        NOT(ISBLANK({!$Record.BillingCity})),
        NOT(ISBLANK({!$Record.BillingState})),
        NOT(ISBLANK({!$Record.BillingPostalCode}))
    )
)</expression>
    </formulas>
