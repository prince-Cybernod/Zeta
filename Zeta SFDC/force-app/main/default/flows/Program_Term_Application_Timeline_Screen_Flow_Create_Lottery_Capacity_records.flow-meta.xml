    <description>Create one or more Lottery Capacity records related to a Program Term Application Timeline that is passed into this flow. Updated to use fx_PTAT_ID instead of the input_PTAT variable to allow the flow to be initiated more dynamically.

Created By: Elevation Solutions</description>
    <environments>Default</environments>
    <formulas>
        <description>Evaluates the input value and returns the variable in which the Program Term Application Timeline is NOT null</description>
        <name>fx_PTAT_ID</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!input_PTAT}), {!recordId}, {!input_PTAT})</expression>
    </formulas>
    <formulas>
        <name>fx_PTAT_SchoolName</name>
        <dataType>String</dataType>
        <expression>{!Get_Program_Term_Application_Timeline.LearningProgram.School__r.Name}</expression>
    </formulas>
    <formulas>
        <description>If this PTAT has existing LCs, include the word &quot;more&quot; in the display text since these are not the initial LCs for this PTAT.</description>
        <name>fx_text_for_existing_LCs</name>
        <dataType>String</dataType>
        <expression>IF({!cnt_LotteryCapacityRecs}&gt;0, &apos;more &apos;, &apos;&apos;)</expression>
    </formulas>
