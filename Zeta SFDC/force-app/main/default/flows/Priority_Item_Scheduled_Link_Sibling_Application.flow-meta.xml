<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Flags that we found a shared guardian.</description>
        <name>Assign_Set_Shared_Guardian_Found</name>
        <label>Assign | Set Shared Guardian Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varSharedGuardianFound</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Decision_Shared_Guardian_Exists</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>If true, skip remaining comparisons.</description>
        <name>Decision_Already_Found_Shared_Guardian</name>
        <label>Decision | Already Found Shared Guardian?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Candidate_Sibling_Guardian_CCRs</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Found</defaultConnectorLabel>
        <rules>
            <name>Already_found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varSharedGuardianFound</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <isGoTo>true</isGoTo>
                <targetReference>Decision_Shared_Guardian_Exists</targetReference>
            </connector>
            <label>Already found</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks whether the two CCR records refer to the same guardian.</description>
        <name>Decision_Guardian_Match</name>
        <label>Decision | Guardian Match</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Candidate_Sibling_Guardian_CCRs</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Match</defaultConnectorLabel>
        <rules>
            <name>Match</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Current_Student_Guardian_CCRs.RelatedContactId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Loop_Candidate_Sibling_Guardian_CCRs.RelatedContactId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Set_Shared_Guardian_Found</targetReference>
            </connector>
            <label>Match</label>
        </rules>
    </decisions>
    <decisions>
        <description>Proceeds only if at least one shared guardian was found.</description>
        <name>Decision_Shared_Guardian_Exists</name>
        <label>Decision | Shared Guardian Exists</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varSharedGuardianFound</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Sibling_Individual_Application</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>Determines whether a sibling Individual Application was successfully found before attempting to populate the Sibling Application lookup on the Priority Item.</description>
        <name>Decision_Sibling_IA_Found</name>
        <label>Decision | Sibling IA Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Sibling IA Found</defaultConnectorLabel>
        <rules>
            <name>Sibling_IA_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Sibling_Individual_Application</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Set_Sibling_Application</targetReference>
            </connector>
            <label>Sibling IA Found</label>
        </rules>
    </decisions>
    <description>Created By: Elevation Solutions
Scheduled - Daily

When a sibling-related Priority Item is created, automatically find the sibling’s Individual Application and populate Priority_Item__c.Sibling_Application__c, enforcing shared-guardian validation via CCR.</description>
    <environments>Default</environments>
    <interviewLabel>Priority Item (Scheduled): Link Sibling Application {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Priority Item (Scheduled): Link Sibling Application</label>
    <loops>
        <description>Compare candidate guardian to the current guardian</description>
        <name>Loop_Candidate_Sibling_Guardian_CCRs</name>
        <label>Loop | Candidate Sibling Guardian CCRs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Candidate_Sibling_Guardians_CCR</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Decision_Guardian_Match</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Loop_Current_Student_Guardian_CCRs</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <description>Iterate each current guardian to see if candidate has the same guardian.</description>
        <name>Loop_Current_Student_Guardian_CCRs</name>
        <label>Loop | Current Student Guardian CCRs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Current_Student_Guardians_CCR</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Decision_Already_Found_Shared_Guardian</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Decision_Shared_Guardian_Exists</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Pulls guardian CCR records for the candidate sibling student to check for overlap with the current student&apos;s guardians.</description>
        <name>Get_Candidate_Sibling_Guardians_CCR</name>
        <label>Get | Candidate Sibling Guardians (CCR)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Current_Student_Guardian_CCRs</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ContactId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Candidate_Sibling_Students_Contact.PersonContactId</elementReference>
            </value>
        </filters>
        <filters>
            <field>PartyRoleRelationId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Party_Role_Relation_Student_Guardian_CCR.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>ContactContactRelation</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Finds Student Contact(s) matching sibling demographics captured on the current Individual Application.</description>
        <name>Get_Candidate_Sibling_Students_Contact</name>
        <label>Get | Candidate Sibling Students (Contact)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Candidate_Sibling_Guardians_CCR</targetReference>
        </connector>
        <filterLogic>(1 AND 2 AND 3 AND 4) OR (5 AND 6 AND 7 AND 8)</filterLogic>
        <filters>
            <field>FirstName</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Current_Individual_Application.Sibling_Applying_First_Name__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>LastName</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Current_Individual_Application.Sibling_Applying_Last_Name__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>PersonBirthdate</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Current_Individual_Application.Sibling_Applying_Date_Of_Birth__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>PersonGenderIdentity</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Current_Individual_Application.Sibling_Applying_Gender__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>FirstName</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Current_Individual_Application.Sibling_Attending_First_Name__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>LastName</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Current_Individual_Application.Sibling_Attending_Last_Name__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>PersonBirthdate</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Current_Individual_Application.Sibling_Attending_Date_Of_Birth__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>PersonGenderIdentity</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Current_Individual_Application.Sibling_Attending_Gender__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Gets the Individual Application referenced by the Priority Item so we can read the Student Contact lookup for CCR validation.</description>
        <name>Get_Current_Individual_Application</name>
        <label>Get | Current Individual Application</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Current_Student_Guardians_CCR</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Related_Application__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>IndividualApplication</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Pulls Student→Guardian CCR records for the current student so we can enforce shared-guardian validation before linking siblings.</description>
        <name>Get_Current_Student_Guardians_CCR</name>
        <label>Get | Current Student Guardians (CCR)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Candidate_Sibling_Students_Contact</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ContactId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Current_Individual_Application.Account.PersonContactId</elementReference>
            </value>
        </filters>
        <filters>
            <field>PartyRoleRelationId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Party_Role_Relation_Student_Guardian_CCR.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>ContactContactRelation</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Retrieves the Party Role Relation record so CCR queries can filter by PartyRoleRelationId using the correct Id value.</description>
        <name>Get_Party_Role_Relation_Student_Guardian_CCR</name>
        <label>Get | Party Role Relation (Student-Guardian-CCR)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Current_Individual_Application</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Student-Guardian-CCR</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>PartyRoleRelation</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Gets the sibling’s Individual Application for the matched sibling student so we can populate Priority_Item__c.Sibling_Application__c.</description>
        <name>Get_Sibling_Individual_Application</name>
        <label>Get | Sibling Individual Application</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_Sibling_IA_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Candidate_Sibling_Students_Contact.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>IndividualApplication</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Updates the triggering Priority Item with the sibling’s Individual Application lookup once shared-guardian validation passes.</description>
        <name>Update_Set_Sibling_Application</name>
        <label>Update | Set Sibling Application</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Sibling_Application__c</field>
            <value>
                <elementReference>Get_Sibling_Individual_Application.Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Party_Role_Relation_Student_Guardian_CCR</targetReference>
        </connector>
        <filterLogic>(1 OR 2) AND 3 AND 4</filterLogic>
        <filters>
            <field>Priority_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Sibling Attending</stringValue>
            </value>
        </filters>
        <filters>
            <field>Priority_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Sibling Applying</stringValue>
            </value>
        </filters>
        <filters>
            <field>Related_Application__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Sibling_Application__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Priority_Item__c</object>
        <schedule>
            <dayOfMonthToRun>0</dayOfMonthToRun>
            <frequency>Daily</frequency>
            <frequencyNumber>0</frequencyNumber>
            <startDate>2026-02-05</startDate>
            <startTime>22:45:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <description>True once we find at least one guardian ContactId shared by both students.</description>
        <name>varSharedGuardianFound</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
</Flow>
