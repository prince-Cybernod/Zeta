    <textTemplates>
        <description>Provides clear, staff-facing guidance explaining why they are reviewing the student’s name and what action is expected. Uses the standard Yellow = Needs Review styling and matches existing Eligibility sections.</description>
        <name>TT_NeedsReview_NameCleanup</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;div style=&quot;width:100%;border:2px solid #F2B600;border-radius:10px;padding:16px;text-align:center;background-color:#FFF7D6;&quot;&gt;&lt;div style=&quot;font-size:14px;line-height:20px;&quot;&gt;&lt;strong&gt;Please review the student’s name.&lt;/strong&gt; Update the fields below to remove special characters and ensure the name matches official records. Submit updates when complete, or return without changes.&lt;/div&gt;&lt;/div&gt;</text>
    </textTemplates>
