    <description>When an Outreach # Outcome field is updated on a Lead record, evaluate and update its Status accordingly.

Created By: Elevation Solutions</description>
    <environments>Default</environments>
    <formulas>
        <description>Outcome of the latest Outreach # Outcome field to be changed (i.e. Outreach 3 Outcome value take priority over Outreach 2 Outcome which takes priority over Outreach 1 Outcome)</description>
        <name>fx_ChangedOutcomeValue</name>
        <dataType>String</dataType>
        <expression>IF(ISCHANGED({!$Record.Outreach_3_Outcome__c}), TEXT({!$Record.Outreach_3_Outcome__c}),
IF(ISCHANGED({!$Record.Outreach_2_Outcome__c}), TEXT({!$Record.Outreach_2_Outcome__c}),
IF(ISCHANGED({!$Record.Outreach_1_Outcome__c}), TEXT({!$Record.Outreach_1_Outcome__c}), &apos;&apos;)))</expression>
    </formulas>
    <formulas>
        <description>Returns &apos;Duplicate of enrolled student&apos; or &apos;Duplicate of applied student&apos; depending on the Outcome value.</description>
        <name>fx_Duplicate_ReasonNotConverted</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS(LOWER({!var_txt_Outcome}), &apos;enrolled&apos;), &apos;Duplicate – Enrolled Student&apos;, IF(CONTAINS(LOWER({!var_txt_Outcome}), &apos;applied&apos;), &apos;Duplicate – Applied Student&apos;, &apos;Duplicate – Active duplicate lead&apos;))</expression>
    </formulas>
    <formulas>
        <name>fx_next_year_txt</name>
        <dataType>String</dataType>
        <expression>TEXT(YEAR({!$Flow.CurrentDate})+1)</expression>
    </formulas>
