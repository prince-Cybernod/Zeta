    <description>SFR-179
Gives the case to the family's team member or lead owner before round robin.</description>
    <environments>Default</environments>
    <formulas>
        <name>fmLeadOwnerId</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!Get_Open_Lead.OwnerId}, {!Get_Closed_Lead.OwnerId})</expression>
    </formulas>
    <formulas>
        <name>fmNotificationBody</name>
        <dataType>String</dataType>
        <expression>&quot;Case &quot; &amp; {!$Record.CaseNumber} &amp; &quot;: &quot; &amp; {!$Record.Subject}</expression>
    </formulas>
    <formulas>
        <name>fmSlot</name>
        <dataType>Number</dataType>
        <expression>MOD({!varLastIndex} + 1, {!varUserCount})</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Case Round Robin Outreach Enrollment {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case Round Robin Outreach Enrollment</label>
