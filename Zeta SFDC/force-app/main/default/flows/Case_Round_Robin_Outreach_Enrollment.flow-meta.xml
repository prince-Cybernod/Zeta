        </rules>
    </decisions>
    <decisions>
        <name>Is_This_The_Slot</name>
        <label>Is This The Slot?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Increment_Index</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Slot</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varIndex</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>fmSlot</elementReference>
                </rightValue>
