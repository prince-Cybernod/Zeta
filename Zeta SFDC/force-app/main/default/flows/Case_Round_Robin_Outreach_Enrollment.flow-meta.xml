    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Outreach_Queue</targetReference>
        </connector>
        <filterFormula>AND(
  BEGINS({!$Record.OwnerId}, "00G"),
  LOWER(BLANKVALUE({!$Record.SuppliedEmail}, "")) &lt;&gt; "enroll@zetaschools.org"
)</filterFormula>
        <object>Case</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
