            </connector>
            <label>Yes, Proceed</label>
        </rules>
    </decisions>
    <decisions>
        <description>If 0 selected - show error screen</description>
        <name>Total_Selected_rows_0</name>
        <label>Total Selected rows &gt; 0?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>norowsselected</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Rows Selected</defaultConnectorLabel>
        <rules>
            <name>Rows_Selected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varTotalRowsSelected</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Internal_or_External</targetReference>
            </connector>
            <label>Rows Selected</label>
        </rules>
    </decisions>
    <description>Created by: Elevation Solutions

Creates tasks in bulk from list view selected records for Academic Term Enrollment and Individual Application. Allows the user to enter a task subject and choose a task type, with guardrails for Parent Portal Task creation based on user permission. Mirrors the existing Intent to Return list view task creation pattern. Based on uploaded Zeta flow metadata and current mass task creation pattern.</description>
    <dynamicChoiceSets>
        <name>taskType</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>Type</picklistField>
        <picklistObject>Task</picklistObject>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>fxDueDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 10</expression>
    </formulas>
    <formulas>
        <description>Determines the OwnerId for tasks based on whether the task is Internal or External.</description>
        <name>fxTaskOwnerId</name>
        <dataType>String</dataType>
        <expression>IF(
  {!Internal_vs_External} = &quot;Internal&quot;,
  {!varSelectedTaskOwnerId},
  {!Get_Queue_for_Assignment.Id}
)</expression>
    </formulas>
    <interviewLabel>Task (Screen Flow) Mass Create Tasks for Selected Records {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Task (Screen Flow) Mass Create Tasks for Selected Records</label>
