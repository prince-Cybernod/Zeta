    <decisions>
        <name>Decision_Parent_Portal_Task_Permission_Check</name>
        <label>Decision | Parent Portal Task Permission Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Permission_Not_Allowed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Allowed</defaultConnectorLabel>
        <rules>
            <name>Allowed_Proceed</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Type</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Parent Portal Task</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Permission.Zeta_Create_Parent_Portal_Tasks</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_ATE_Records_from_List_View</targetReference>
            </connector>
            <label>Allowed - Proceed</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks if this flow is working off of ATE or Individual App records</description>
        <name>Decision_Selected_Records_are_ATE</name>
        <label>Decision | Selected Records are ATE?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_IA_Records_from_List_View</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No, Not ATE</defaultConnectorLabel>
        <rules>
            <name>Yes_ATE_Records</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_ATE_Records_from_List_View</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_through_ATEs</targetReference>
            </connector>
            <label>Yes, ATE Records</label>
        </rules>
    </decisions>
    <decisions>
        <description>Individual App records</description>
        <name>Decision_Selection_records_are_IA</name>
        <label>Decision | Selection records are IA?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_IA_Records</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_IA_Records_from_List_View</leftValueReference>
