<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Sets the amount of records updated</description>
        <name>Assignment_Count_of_Updated_Records</name>
        <label>Assignment | Count of Updated Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varTotalRecordsUpdated</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_Applications</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>displaytotalrecordsupdated</targetReference>
        </connector>
    </assignments>
    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <description>Created by: Elevation Solutions

Manually triggered flow from the Application Timeline that sets related Individual Applications to Status = Eligible when Residency Restriction and Age Inconsistency are FALSE and Priority_Items_Pending_Review__c = 0. Designed for enrollment team bulk eligibility review.</description>
    <environments>Default</environments>
    <interviewLabel>Application Timeline (Screenflow) Auto Set Eligible {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Application Timeline (Screenflow) Auto Set Eligible</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <description>Grabs total application to be updated for count</description>
        <name>Get_Applications</name>
        <label>Get | Applications</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_Set_Eligible_For_Timeline</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Application_Timeline__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Eligible</stringValue>
            </value>
        </filters>
        <filters>
            <field>Age_Inconsistency_Flag_c__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Residency_Restriction__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Priority_Items_Pending_Review__c</field>
            <operator>EqualTo</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </filters>
        <filters>
            <field>Student_District_Id__c</field>
            <operator>NotEqualTo</operator>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>IndividualApplication</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Sets Status = Eligible for Individual Applications related to the passed Application Timeline when auto-eligible criteria are met.</description>
        <name>Update_Set_Eligible_For_Timeline</name>
        <label>Update | Set Eligible | For Timeline</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Assignment_Count_of_Updated_Records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Application_Timeline__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Eligible</stringValue>
            </value>
        </filters>
        <filters>
            <field>Age_Inconsistency_Flag_c__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Residency_Restriction__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Priority_Items_Pending_Review__c</field>
            <operator>EqualTo</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Eligible</stringValue>
            </value>
        </inputAssignments>
        <object>IndividualApplication</object>
    </recordUpdates>
    <screens>
        <name>displaytotalrecordsupdated</name>
        <label>displaytotalrecordsupdated</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>displayMessage</name>
            <fieldText>&lt;p&gt;{!tt_TotalRecordsUpdate_Msg}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Applications</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <textTemplates>
        <description>Used in the pop-up screen to let user know records were updated.</description>
        <name>tt_TotalRecordsUpdate_Msg</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;div style=&quot;width:100%;border:2px solid #4F497A;border-radius:10px;padding:18px;background-color:#F3F0FA;text-align:center;&quot;&gt;&lt;div style=&quot;font-size:18px;font-weight:600;color:#4F497A;margin-bottom:8px;&quot;&gt;Auto-Set Eligible Complete&lt;/div&gt;&lt;div style=&quot;font-size:15px;&quot;&gt;{!varTotalRecordsUpdated} Individual Application(s) were updated to &lt;strong&gt;Eligible&lt;/strong&gt;.&lt;/div&gt;&lt;/div&gt;</text>
    </textTemplates>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Used to display confirmation screen of how many records updated</description>
        <name>varTotalRecordsUpdated</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
</Flow>
