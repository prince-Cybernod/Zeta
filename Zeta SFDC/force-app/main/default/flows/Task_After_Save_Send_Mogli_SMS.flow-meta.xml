    <formulas>
        <description>Gets the Name of the Mogli Template from the subject of the task.</description>
        <name>fSMSTemplateName</name>
        <dataType>String</dataType>
        <expression>TRIM(RIGHT({!$Record.Subject}, LEN({!$Record.Subject}) - FIND(&quot;#&quot;, {!$Record.Subject})))</expression>
    </formulas>
