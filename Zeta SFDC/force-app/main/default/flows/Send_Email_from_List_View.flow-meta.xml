    <environments>Default</environments>
    <formulas>
        <description>Returns the first 3 letters in the string of IDs passed into the flow. This determines the object.</description>
        <name>fx_first3letters</name>
        <dataType>String</dataType>
        <expression>LEFT({!Convert_text_collection_to_string.csvString}, 3)</expression>
    </formulas>
    <formulas>
        <name>fx_ListViewURL</name>
        <dataType>String</dataType>
        <expression>{!$Label.CRM_List_View_Base_URL}+{!fx_Object}+&apos;/list?filterName=__Recent&apos;</expression>
    </formulas>
    <formulas>
        <description>Determined based on the object Id this flow is launched from</description>
        <name>fx_Object</name>
        <dataType>String</dataType>
        <expression>IF({!fx_first3letters} = &apos;0iT&apos;, &apos;IndividualApplication&apos;, IF({!fx_first3letters} = &apos;1EZ&apos;, &apos;AcademicInterest&apos;, IF({!fx_first3letters} = &apos;0x9&apos;, &apos;AcademicTermEnrollment&apos;, &apos;&apos;)))</expression>
    </formulas>
