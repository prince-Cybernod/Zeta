<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Marks varAllDeclined as false because at least one School Application is not Declined/Withdrawn.</description>
        <name>Set_Flag_To_False</name>
        <label>Set Flag To False</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varAllDeclined</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Through_School_Applications</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Checks whether the current School Application in the loop has Status = Declined/Withdrawn.</description>
        <name>Is_Declined</name>
        <label>Is Declined?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Through_School_Applications</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Declined</defaultConnectorLabel>
        <rules>
            <name>Not_Declined</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Through_School_Applications.Status</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Withdrawn/Declined</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Flag_To_False</targetReference>
            </connector>
            <label>Not Declined</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks whether all sibling School Applications were Declined/Withdrawn (based on varAllDeclined).</description>
        <name>Should_Update_Individual_Application</name>
        <label>Should Update Individual Application?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Do Nothing</defaultConnectorLabel>
        <rules>
            <name>All_Declined</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varAllDeclined</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Individual_Application_Status</targetReference>
            </connector>
            <label>All Declined</label>
        </rules>
    </decisions>
    <description>When a School Application (AcademicInterest) record is updated so that Status = &apos;Declined/Withdrawn&apos;, this flow evaluates all School Applications for the related Individual Application. If all are Declined/Withdrawn, it updates the Individual Application Status to Declined/Withdrawn.

Flow Designer: Elevation Solutions</description>
    <environments>Default</environments>
    <interviewLabel>School Application Sync Individual Application Status {!$Flow.CurrentDateTime}</interviewLabel>
    <label>School Application (After Save) Sync Individual Application Status</label>
    <loops>
        <description>Loops through each sibling School Application to determine if any are not Declined/Withdrawn.</description>
        <name>Loop_Through_School_Applications</name>
        <label>Loop Through School Applications</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Sibling_School_Applications</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Is_Declined</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Should_Update_Individual_Application</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Retrieves all AcademicInterest (School Application) records related to the same Individual Application as the triggering record.</description>
        <name>Get_Sibling_School_Applications</name>
        <label>Get Sibling School Applications</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Through_School_Applications</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IndividualApplicationId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.IndividualApplicationId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>AcademicInterest</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Sets the Individual Application&apos;s Status to &apos;Declined/Withdrawn&apos; when all sibling School Applications are Declined/Withdrawn.</description>
        <name>Update_Individual_Application_Status</name>
        <label>Update Individual Application Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.IndividualApplicationId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Withdrawn/Declined</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Withdrawn_Declined_Reason_Picklist__c</field>
            <value>
                <elementReference>$Record.Withdrawn_Declined_Reason_Picklist__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Withdrawn_Declined_Reason__c</field>
            <value>
                <elementReference>$Record.Declined_Withdrawn_Reason__c</elementReference>
            </value>
        </inputAssignments>
        <object>IndividualApplication</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Sibling_School_Applications</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Withdrawn/Declined</stringValue>
            </value>
        </filters>
        <object>AcademicInterest</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <description>Tracks whether ALL sibling School Applications have Status = Declined/Withdrawn. Starts as TRUE and becomes FALSE if any record does not match.</description>
        <name>varAllDeclined</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <booleanValue>true</booleanValue>
        </value>
    </variables>
</Flow>
