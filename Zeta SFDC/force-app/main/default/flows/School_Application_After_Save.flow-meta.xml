<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Sends the Seat Offered SMS template to the Primary Guardian.</description>
        <name>Send_SMS_Seat_Offered</name>
        <label>Send SMS | Seat Offered</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>Mogli_SMS__SMSSendInvocable</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Update_School_Application_Stamp_Last_SMS_Sent_c</targetReference>
        </connector>
        <flowTransactionModel>Automatic</flowTransactionModel>
        <inputParameters>
            <name>phoneNumber</name>
            <value>
                <elementReference>Get_Primary_Guardian_Account.Mogli_SMS__Mogli_Number__pc</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>smsMessage</name>
            <value>
                <elementReference>ttSMS_SeatOffered</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Mogli_SMS__SMSSendInvocable</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <actionCalls>
        <description>Sends a SMS to the primary guardian to inform them of the seat being rescinded due to seat optimization.</description>
        <name>Send_SMS_Seat_Rescinded_due_to_Seat_Optimization</name>
        <label>Send SMS | Seat Rescinded due to Seat Optimization</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>Mogli_SMS__SMSSendInvocable</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Update_School_Application_Stamp_Last_SMS_Sent_c</targetReference>
        </connector>
        <flowTransactionModel>Automatic</flowTransactionModel>
        <inputParameters>
            <name>phoneNumber</name>
            <value>
                <elementReference>Get_Primary_Guardian_Account.Mogli_SMS__Mogli_Number__pc</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>smsMessage</name>
            <value>
                <elementReference>ttSMS_OfferRescindedOptimization</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Mogli_SMS__SMSSendInvocable</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Confirms the related Individual Application has a Guardian lookup populated before attempting to send Mogli SMS.</description>
        <name>Decision_Guardian_Found</name>
        <label>Decision | Guardian Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Not Found</defaultConnectorLabel>
        <rules>
            <name>Guardian_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Primary_Guardian_Account</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Decision_Which_SMS_Message</targetReference>
            </connector>
            <label>Guardian Found</label>
        </rules>
    </decisions>
    <decisions>
        <description>Chooses which SMS body to send based on the School Application Status.</description>
        <name>Decision_Which_SMS_Message</name>
        <label>Decision | Which SMS Message?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Send_SMS_Seat_Rescinded_due_to_Seat_Optimization</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Offer Rescinded (Optimization)</defaultConnectorLabel>
        <rules>
            <name>Seat_Offered</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Seat Offered</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_SMS_Seat_Offered</targetReference>
            </connector>
            <label>Seat Offered</label>
        </rules>
    </decisions>
    <description>Created by: Elevation Solutions

When a School Application status changes to Seat Offered or Offer Rescinded due to Seat Optimization, send a Mogli SMS to the Guardian Person Account and stamp Last_SMS_Sent__c on the School Application only after a successful send.</description>
    <environments>Default</environments>
    <interviewLabel>School Application (After Save) {!$Flow.CurrentDateTime}</interviewLabel>
    <label>School Application (After Save) Send Status SMS (Mogli)</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Gets the Guardian Person Account record that should receive Mogli SMS for this School Application, so we can pass the correct record context + phone to Mogli.</description>
        <name>Get_Primary_Guardian_Account</name>
        <label>Get | Primary Guardian Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_Guardian_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.IndividualApplication.Primary_Guardian__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Stamps Last_SMS_Sent__c after a successful Mogli send.</description>
        <name>Update_School_Application_Stamp_Last_SMS_Sent_c</name>
        <label>Update | School Application | Stamp Last_SMS_Sent__c</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Last_SMS_Sent__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Primary_Guardian_Account</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Seat Offered</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Offer Rescinded due to Seat Optimization</stringValue>
            </value>
        </filters>
        <object>AcademicInterest</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <textTemplates>
        <description>SMS body for offer canceled due to seat optimization.</description>
        <name>ttSMS_OfferRescindedOptimization</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;A previous seat offer was canceled due to seat optimization. Please check the Zeta portal for your updated status.&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>ttSMS_SeatOffered</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>You have a new seat offer for your student at Zeta. Please log into the enrollment portal to review the offer and next steps.</text>
    </textTemplates>
</Flow>
