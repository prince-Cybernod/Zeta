    <description>Created by: Elevation Solutions

Sends a confirmation email when an Individual Application is submitted (Application Status = Applied).</description>
    <environments>Default</environments>
    <formulas>
        <name>fxEmailTemplateName</name>
        <dataType>String</dataType>
        <expression>CASE(
    TEXT({!$Record.Primary_Guardian__r.Language_Preference__pc}),
    &quot;es&quot;, &quot;Application Submission Confirmation - Spanish&quot;,
    &quot;zh_CN&quot;, &quot;Application Submission Confirmation - Chinese&quot;,
    &quot;Application Submission Confirmation&quot;
)</expression>
    </formulas>
    <formulas>
        <name>fxSMSTemplate</name>
        <dataType>String</dataType>
        <expression>CASE(
    TEXT({!$Record.Primary_Guardian__r.Language_Preference__pc}),
    &quot;es&quot;, &quot;Application Submission Confirmation - Spanish&quot;,
    &quot;zh_CN&quot;, &quot;Application Submission Confirmation - Chinese&quot;,
    &quot;Application Submission Confirmation&quot;
)</expression>
    </formulas>
