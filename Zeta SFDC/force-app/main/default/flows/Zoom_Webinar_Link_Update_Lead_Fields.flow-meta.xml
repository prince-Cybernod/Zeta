<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Lead_Created_via_Zoom</name>
        <label>Lead Created via Zoom?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fx_LeadCreatedViaZoom</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Lead</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>When a Zoom Webinar Link is created and related to a Lead, update the Campaign on the Lead to match that of the Webinar. Update the current Name to the Guardian Name and populate &apos;[BLANK] Unknown&apos; for the Student First and Last Name. Do not update Lead Campaign on Lead unless the Lead was created via Zoom</description>
    <environments>Default</environments>
    <formulas>
        <description>Using the Guardian First Name field as a proxy to determine if this Lead was created via Zoom. This field is blank for recs that come from Zoom, but required by CRM-created Leads</description>
        <name>fx_LeadCreatedViaZoom</name>
        <dataType>Boolean</dataType>
        <expression>ISBLANK({!$Record.ZVC__Lead__r.Guardian_First_Name__c})</expression>
    </formulas>
    <interviewLabel>Zoom Webinar Link | Update Lead Fields {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Zoom Webinar Link | Update Lead Fields</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Campaign</name>
        <label>Get Campaign</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Lead_Created_via_Zoom</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ZVC__Zoom_Webinar__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ZVC__Zoom_Webinar__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Campaign</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Lead</name>
        <label>Update Lead</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ZVC__Lead__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>FirstName</field>
        </inputAssignments>
        <inputAssignments>
            <field>Guardian_First_Name__c</field>
            <value>
                <elementReference>$Record.ZVC__Lead__r.FirstName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Guardian_Last_Name__c</field>
            <value>
                <elementReference>$Record.ZVC__Lead__r.LastName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>LastName</field>
            <value>
                <stringValue>Unknown</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Lead_Campaign__c</field>
            <value>
                <elementReference>Get_Campaign.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Lead_Source__c</field>
            <value>
                <stringValue>Attended or RSVPd to event</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Unmatched_Lead__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Lead</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ZVC__Lead__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>ZVC__Zoom_Webinar_Link__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Get_Campaign</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
