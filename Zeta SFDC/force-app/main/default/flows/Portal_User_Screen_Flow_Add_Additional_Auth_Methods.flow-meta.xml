    <description>Displayed in the Zeta Portal. Enables Users to add the ability to authorize another contact method after their initial user registration.
Created by: Elevation Solutions</description>
    <environments>Default</environments>
    <formulas>
        <name>fx_authmeth</name>
        <dataType>String</dataType>
        <expression>IF({!Email}, &apos;Email&apos;, IF({!SMS}, &apos;text message&apos;, &apos;&apos;))</expression>
    </formulas>
    <formulas>
        <name>fx_UserEmailContainsInvalid</name>
        <dataType>Boolean</dataType>
        <expression>CONTAINS({!Get_logged_in_User.Email}, &quot;invalid&quot;)</expression>
    </formulas>
