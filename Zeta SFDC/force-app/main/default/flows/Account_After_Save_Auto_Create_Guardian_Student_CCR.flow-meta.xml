    <decisions>
        <description>Determines whether a CCR record already links the Student and Secondary Guardian.
If none exists, proceeds to create it.</description>
        <name>Secondary_CCR_Found</name>
        <label>Secondary CCR Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Found existing CCR</defaultConnectorLabel>
        <rules>
            <name>No_not_found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Secondary_Guardian_Student_CCR</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Secondary_Student_Guardian_CCR</targetReference>
            </connector>
            <label>No, not found</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks if a Secondary Guardian is populated on the Student record.
If blank, skips this entire branch to avoid unnecessary CCR creation.</description>
        <name>Secondary_Guardian_Exists</name>
        <label>Secondary Guardian Exists?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Does not exist</defaultConnectorLabel>
        <rules>
            <name>Yes_Secondary_Guardian_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Secondary_Guardian__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Existing_Secondary_Guardian_Student_CCR</targetReference>
            </connector>
            <label>Yes, Secondary Guardian Exists</label>
        </rules>
    </decisions>
    <description>Automatically creates Contact Contact Relationship (CCR) records between a Student (Person Account) and their Guardian Person Accounts when the guardian lookups are populated or changed.

Prevents duplicate relationships by first checking for an existing CCR of type “Parent/Guardian.”

Runs only for Student record type Person Accounts.

Flow Designer: Elevation Solutions</description>
    <environments>Default</environments>
    <interviewLabel>Account (After Save) Auto-Create Guardian/Student CCR {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account (After Save) Auto-Create Guardian/Student CCR</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
