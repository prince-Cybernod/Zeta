    <recordCreates>
        <description>Creates a new Contact–Contact Relationship record linking the Student to their Secondary Guardian.
Uses “Parent/Guardian” as the relationship Type for consistent family mapping.</description>
        <name>Create_Secondary_Student_Guardian_CCR</name>
        <label>Create Secondary Student-Guardian CCR</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
