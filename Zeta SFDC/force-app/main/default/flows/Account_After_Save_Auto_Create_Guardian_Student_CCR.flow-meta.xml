    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Student_Guardian_CCR_ID</targetReference>
        </connector>
        <filterFormula>AND(
  {!$Record.RecordType.DeveloperName} = &quot;Student&quot;,
  OR(
    ISNEW(),
    ISCHANGED({!$Record.Primary_Guardian__c}),
    ISCHANGED({!$Record.Secondary_Guardian__c})
  )
)</filterFormula>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
