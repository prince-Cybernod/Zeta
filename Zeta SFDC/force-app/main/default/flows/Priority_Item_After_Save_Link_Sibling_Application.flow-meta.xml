<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Flags that we found a shared guardian.</description>
        <name>Assign_Set_Shared_Guardian_Found</name>
        <label>Assign | Set Shared Guardian Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varSharedGuardianFound</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Decision_Shared_Guardian_Exists</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Sets Sibling Application lookup on the staging Priority Item record.</description>
        <name>Assign_Set_Sibling_Application_Staging</name>
        <label>Assign | Set Sibling Application (Staging)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varPriorityItemToUpdate.Sibling_Application__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Sibling_Individual_Application.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varPriorityItemToUpdate.Sibling_Academic_Term_Enrollment__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Sibling_Academic_Term_Enrollment_ATE.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varPriorityItemToUpdate.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Set_Sibling_Application</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Stages the sibling application lookup for non-attending sibling priorities.</description>
        <name>Assign_Stage_Sibling_Applying_IA_No_ATE</name>
        <label>Assign | Stage Sibling Applying IA (No ATE)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varPriorityItemToUpdate.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varPriorityItemToUpdate.Sibling_Application__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Sibling_Individual_Application.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Set_Sibling_Application</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>If true, skip remaining comparisons.</description>
        <name>Decision_Already_Found_Shared_Guardian</name>
        <label>Decision | Already Found Shared Guardian?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Candidate_Sibling_Guardian_CCRs</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Found</defaultConnectorLabel>
        <rules>
            <name>Already_found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varSharedGuardianFound</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <isGoTo>true</isGoTo>
                <targetReference>Decision_Shared_Guardian_Exists</targetReference>
            </connector>
            <label>Already found</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks whether the two CCR records refer to the same guardian.</description>
        <name>Decision_Guardian_Match</name>
        <label>Decision | Guardian Match</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Candidate_Sibling_Guardian_CCRs</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Match</defaultConnectorLabel>
        <rules>
            <name>Match</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Current_Student_Guardian_CCRs.RelatedContactId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Loop_Candidate_Sibling_Guardian_CCRs.RelatedContactId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Set_Shared_Guardian_Found</targetReference>
            </connector>
            <label>Match</label>
        </rules>
    </decisions>
    <decisions>
        <description>Routes to the Sibling Attending-only stamping path (ATE + sibling IA) vs the standard path (sibling IA only).</description>
        <name>Decision_Priority_Type_Sibling_Attending</name>
        <label>Decision | Priority Type = Sibling Attending?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_Stage_Sibling_Applying_IA_No_ATE</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Sibling Attending</defaultConnectorLabel>
        <rules>
            <name>Sibling_Attending</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Priority_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Sibling Attending</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Sibling_Academic_Term_Enrollment_ATE</targetReference>
            </connector>
            <label>Sibling Attending</label>
        </rules>
    </decisions>
    <decisions>
        <description>Proceeds only if at least one shared guardian was found.</description>
        <name>Decision_Shared_Guardian_Exists</name>
        <label>Decision | Shared Guardian Exists</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Party_Role_Relation_Student_Sibling_CCR</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varSharedGuardianFound</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Sibling_Individual_Application</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>If a sibling-sibling CCR exists between the two students, allow sibling IA stamping even though no shared guardian was found.</description>
        <name>Decision_Sibling_CCR_Found_Fallback</name>
        <label>Decision | Sibling CCR Found? (Fallback)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Not Found</defaultConnectorLabel>
        <rules>
            <name>Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Sibling_CCR_Between_Students</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Sibling_Individual_Application</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <decisions>
        <description>Determines whether a sibling Individual Application was successfully found before attempting to populate the Sibling Application lookup on the Priority Item.</description>
        <name>Decision_Sibling_IA_Found</name>
        <label>Decision | Sibling IA Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Sibling IA Found</defaultConnectorLabel>
        <rules>
            <name>Sibling_IA_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Sibling_Individual_Application</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Decision_Priority_Type_Sibling_Attending</targetReference>
            </connector>
            <label>Sibling IA Found</label>
        </rules>
    </decisions>
    <description>Created By: Elevation Solutions

When a sibling-related Priority Item is created, automatically find the sibling’s Individual Application and populate Priority_Item__c.Sibling_Application__c, enforcing shared-guardian validation via CCR.</description>
    <environments>Default</environments>
    <interviewLabel>After Save | Priority Item | Link Sibling Application {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Priority Item (After Save): Link Sibling Application</label>
    <loops>
        <description>Compare candidate guardian to the current guardian</description>
        <name>Loop_Candidate_Sibling_Guardian_CCRs</name>
        <label>Loop | Candidate Sibling Guardian CCRs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Candidate_Sibling_Guardians_CCR</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Decision_Guardian_Match</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Loop_Current_Student_Guardian_CCRs</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <description>Iterate each current guardian to see if candidate has the same guardian.</description>
        <name>Loop_Current_Student_Guardian_CCRs</name>
        <label>Loop | Current Student Guardian CCRs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Current_Student_Guardians_CCR</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Decision_Already_Found_Shared_Guardian</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Decision_Shared_Guardian_Exists</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Pulls guardian CCR records for the candidate sibling student to check for overlap with the current student&apos;s guardians.</description>
        <name>Get_Candidate_Sibling_Guardians_CCR</name>
        <label>Get | Candidate Sibling Guardians (CCR)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Current_Student_Guardian_CCRs</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ContactId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Candidate_Sibling_Students_Contact.PersonContactId</elementReference>
            </value>
        </filters>
        <filters>
            <field>PartyRoleRelationId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Party_Role_Relation_Student_Guardian_CCR.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>ContactContactRelation</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Finds Student Contact(s) matching sibling demographics captured on the current Individual Application.</description>
        <name>Get_Candidate_Sibling_Students_Contact</name>
        <label>Get | Candidate Sibling Students (Contact)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Candidate_Sibling_Guardians_CCR</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>FirstName</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.First_Name__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>LastName</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Last_Name__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>PersonBirthdate</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Date_of_Birth__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>PersonContactId</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Related_Application__r.Account.PersonContact.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Grabs the Current Active Term to be used for matching Academic Term Enrollment</description>
        <name>Get_Current_Active_Term</name>
        <label>Get | Current Active Term</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Party_Role_Relation_Student_Guardian_CCR</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>AcademicTerm</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Pulls Student→Guardian CCR records for the current student so we can enforce shared-guardian validation before linking siblings.</description>
        <name>Get_Current_Student_Guardians_CCR</name>
        <label>Get | Current Student Guardians (CCR)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Candidate_Sibling_Students_Contact</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ContactId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Related_Application__r.ContactId</elementReference>
            </value>
        </filters>
        <filters>
            <field>PartyRoleRelationId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Party_Role_Relation_Student_Guardian_CCR.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>ContactContactRelation</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Retrieves the Party Role Relation record so CCR queries can filter by PartyRoleRelationId using the correct Id value.</description>
        <name>Get_Party_Role_Relation_Student_Guardian_CCR</name>
        <label>Get | Party Role Relation (Student-Guardian-CCR)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Current_Student_Guardians_CCR</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Student-Guardian-CCR</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>PartyRoleRelation</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Retrieves the PartyRoleRelation Id used to query sibling CCRs between students for fallback validation.</description>
        <name>Get_Party_Role_Relation_Student_Sibling_CCR</name>
        <label>Get | Party Role Relation (Student-Sibling-CCR)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Sibling_CCR_Between_Students</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Sibling-Sibling-CCR</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>PartyRoleRelation</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Retrieves the sibling student’s Academic Term Enrollment record to stamp on the Priority Item when Priority Type is Sibling Attending.</description>
        <name>Get_Sibling_Academic_Term_Enrollment_ATE</name>
        <label>Get | Sibling Academic Term Enrollment (ATE)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_Set_Sibling_Application_Staging</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>LearnerAccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Candidate_Sibling_Students_Contact.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>AcademicTermId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Current_Active_Term.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>AcademicTermEnrollment</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Fallback validation. Finds an existing sibling CCR between the current student and the matched sibling student when no shared guardian was found.</description>
        <name>Get_Sibling_CCR_Between_Students</name>
        <label>Get | Sibling CCR Between Students</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_Sibling_CCR_Found_Fallback</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PartyRoleRelationId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Party_Role_Relation_Student_Sibling_CCR.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>ContactId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Related_Application__r.ContactId</elementReference>
            </value>
        </filters>
        <filters>
            <field>RelatedContactId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Candidate_Sibling_Students_Contact.PersonContactId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>ContactContactRelation</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Gets the sibling’s Individual Application for the matched sibling student so we can populate Priority_Item__c.Sibling_Application__c.</description>
        <name>Get_Sibling_Individual_Application</name>
        <label>Get | Sibling Individual Application</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_Sibling_IA_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Candidate_Sibling_Students_Contact.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>IndividualApplication</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Updates the triggering Priority Item with the sibling’s Individual Application lookup once shared-guardian validation passes.</description>
        <name>Update_Set_Sibling_Application</name>
        <label>Update | Set Sibling Application</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>varPriorityItemToUpdate</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Current_Active_Term</targetReference>
        </connector>
        <filterFormula>AND(
  OR(
    ISPICKVAL({!$Record.Priority_Type__c}, &quot;Sibling Attending&quot;),
    ISPICKVAL({!$Record.Priority_Type__c}, &quot;Sibling Applying&quot;)
  ),
  NOT(ISBLANK({!$Record.Related_Application__c})),
  ISBLANK({!$Record.Sibling_Application__c})
)</filterFormula>
        <object>Priority_Item__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <description>Staging record for updates to the triggering Priority Item; populated via Assignments and updated once at the end.</description>
        <name>varPriorityItemToUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Priority_Item__c</objectType>
    </variables>
    <variables>
        <description>True once we find at least one guardian ContactId shared by both students.</description>
        <name>varSharedGuardianFound</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
</Flow>
