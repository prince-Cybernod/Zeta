                    <value>&lt;p style=&quot;line-height:1.2; margin-top:2px&quot;&gt;&lt;span style=&quot;font-size:11pt; font-variant:normal; white-space:pre-wrap&quot;&gt;&lt;span style=&quot;font-family:Lato,sans-serif&quot;&gt;&lt;span style=&quot;color:#000000&quot;&gt;&lt;span style=&quot;font-weight:400&quot;&gt;&lt;span style=&quot;font-style:normal&quot;&gt;&lt;span style=&quot;text-decoration:none&quot;&gt;Hola,&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;

&lt;p style=&quot;line-height:1.3800000000000001; margin-right:28px&quot;&gt;&lt;span style=&quot;font-size:11pt; font-variant:normal; white-space:pre-wrap&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;span style=&quot;font-style: normal;&quot;&gt;&lt;span style=&quot;text-decoration: none;&quot;&gt;&lt;font face=&quot;Lato, sans-serif&quot;&gt;Fue un placer conocerle en Zeta! &lt;/font&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;font-family:Lato,sans-serif&quot;&gt;&lt;span style=&quot;color:#000000&quot;&gt;&lt;span style=&quot;font-weight:400&quot;&gt;&lt;span style=&quot;font-style:normal&quot;&gt;&lt;span style=&quot;text-decoration:none&quot;&gt;Gracias por su inter&amp;eacute;s en Zeta Charter School y por ser parte de la experiencia Zeta. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;

&lt;p style=&quot;color:#333333;font-family:Arial;font-size:16px;font-weight:normal;margin:0;&quot;&gt;&lt;span style=&quot;font-weight: normal; font-size: 11pt; font-variant: normal; white-space: pre-wrap;&quot;&gt;&lt;span style=&quot;font-family:Lato,sans-serif&quot;&gt;&lt;span style=&quot;color:#000000;&quot;&gt;&lt;span style=&quot;font-weight:700&quot;&gt;&lt;span style=&quot;font-style:normal&quot;&gt;&lt;span style=&quot;text-decoration:none&quot;&gt;Las solicitudes para el a&amp;ntilde;o escolar 2027-2028 ya est&amp;aacute;n abiertas. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;font-size:11pt; font-variant:normal; white-space:pre-wrap&quot;&gt;&lt;span style=&quot;font-family:Lato,sans-serif&quot;&gt;&lt;span style=&quot;color:#000000&quot;&gt;&lt;span style=&quot;font-weight:400&quot;&gt;&lt;span style=&quot;font-style:normal&quot;&gt;&lt;span style=&quot;text-decoration:none&quot;&gt;Por favor, t&amp;oacute;mese unos minutos para&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;font-weight: normal; font-size: 11pt; font-variant: normal; white-space: pre-wrap;&quot;&gt;&lt;span style=&quot;font-family:Lato,sans-serif&quot;&gt;&lt;span style=&quot;color:#000000&quot;&gt;&lt;span style=&quot;font-weight:700&quot;&gt;&lt;span style=&quot;font-style:normal&quot;&gt;&lt;span style=&quot;text-decoration:none&quot;&gt; &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;a href=&quot;https://myportal.zetaschools.org/&quot; style=&quot;font-weight: normal; text-decoration: none;&quot;&gt;&lt;span style=&quot;font-size:11pt; font-variant:normal; white-space:pre-wrap&quot;&gt;&lt;span style=&quot;font-family:Lato,sans-serif&quot;&gt;&lt;span style=&quot;color:#1154cc&quot;&gt;&lt;span style=&quot;font-weight:700&quot;&gt;&lt;span style=&quot;font-style:normal&quot;&gt;&lt;span style=&quot;text-decoration:underline&quot;&gt;&lt;span style=&quot;-webkit-text-decoration-skip:none&quot;&gt;&lt;span style=&quot;text-decoration-skip-ink:none&quot;&gt;postularse&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;&lt;span style=&quot;font-weight: normal; font-size: 11pt; font-variant: normal; white-space: pre-wrap;&quot;&gt;&lt;span style=&quot;font-family:Lato,sans-serif&quot;&gt;&lt;span style=&quot;color:#000000&quot;&gt;&lt;span style=&quot;font-weight:700&quot;&gt;&lt;span style=&quot;font-style:normal&quot;&gt;&lt;span style=&quot;text-decoration:none&quot;&gt; &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;a href=&quot;https://myportal.zetaschools.org/&quot; style=&quot;font-weight: normal; text-decoration: none;&quot;&gt;&lt;span style=&quot;font-size:11pt; font-variant:normal; white-space:pre-wrap&quot;&gt;&lt;span style=&quot;font-family:Lato,sans-serif&quot;&gt;&lt;span style=&quot;color:#1154cc&quot;&gt;&lt;span style=&quot;font-weight:700&quot;&gt;&lt;span style=&quot;font-style:normal&quot;&gt;&lt;span style=&quot;text-decoration:underline&quot;&gt;&lt;span style=&quot;-webkit-text-decoration-skip:none&quot;&gt;&lt;span style=&quot;text-decoration-skip-ink:none&quot;&gt;hoy&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;&lt;span style=&quot;font-weight: normal; font-size: 11pt; font-variant: normal; white-space: pre-wrap;&quot;&gt;&lt;span style=&quot;font-family:Lato,sans-serif&quot;&gt;&lt;span style=&quot;color:#000000&quot;&gt;&lt;span style=&quot;font-weight:400&quot;&gt;&lt;span style=&quot;font-style:normal&quot;&gt;&lt;span style=&quot;text-decoration:none&quot;&gt;!&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;

&lt;p style=&quot;line-height:1.365; margin-right:75px; margin-top:16px&quot;&gt;&lt;span style=&quot;font-size:11pt; font-variant:normal; white-space:pre-wrap&quot;&gt;&lt;span style=&quot;font-family:Lato,sans-serif&quot;&gt;&lt;span style=&quot;color:#000000&quot;&gt;&lt;span style=&quot;font-weight:400&quot;&gt;&lt;span style=&quot;font-style:normal&quot;&gt;&lt;span style=&quot;text-decoration:none&quot;&gt;Una vez que lo haga, su familia ser&amp;aacute; invitada a unirse a los pr&amp;oacute;ximos eventos para obtener m&amp;aacute;s informaci&amp;oacute;n sobre la educaci&amp;oacute;n de pr&amp;oacute;xima generaci&amp;oacute;n de Zeta.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;

&lt;p style=&quot;line-height:1.365; margin-right:18px; margin-top:16px&quot;&gt;&lt;span style=&quot;font-size:11pt; font-variant:normal; white-space:pre-wrap&quot;&gt;&lt;span style=&quot;font-family:Lato,sans-serif&quot;&gt;&lt;span style=&quot;color:#000000&quot;&gt;&lt;span style=&quot;font-weight:400&quot;&gt;&lt;span style=&quot;font-style:normal&quot;&gt;&lt;span style=&quot;text-decoration:none&quot;&gt;Zeta es una red de escuelas p&amp;uacute;blicas ch&amp;aacute;rter que ofrece un recorrido educativo gratuito desde el prek&amp;iacute;nder hasta la escuela secundaria en el Bronx, Manhattan y Queens. Nuestro enfoque integral combina un riguroso nivel acad&amp;eacute;mico, clases especializadas dirigidas por expertos y una comunidad alegre donde los estudiantes son conocidos y queridos. En Zeta, los estudiantes descubren sus fortalezas y pasiones mientras se preparan para la universidad y m&amp;aacute;s all&amp;aacute;.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;

&lt;p style=&quot;line-height:1.365; margin-right:18px; margin-top:16px&quot;&gt;&lt;span style=&quot;font-size:11pt; font-variant:normal; white-space:pre-wrap&quot;&gt;&lt;span style=&quot;font-family:Lato,sans-serif&quot;&gt;&lt;span style=&quot;color:#000000&quot;&gt;&lt;span style=&quot;font-weight:400&quot;&gt;&lt;span style=&quot;font-style:normal&quot;&gt;&lt;span style=&quot;text-decoration:none&quot;&gt;Puede enviar una solicitud para el a&amp;ntilde;o escolar 2027-2028 utilizando cualquiera de las siguientes opciones:&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;

&lt;ul&gt;
	&lt;li style=&quot;line-height: 1.365; margin-right: 18px; margin-top: 16px;&quot;&gt;Post&amp;uacute;lese en l&amp;iacute;nea: complete &lt;a href=&quot;https://https://myportal.zetaschools.org/&quot;&gt;la solicitud en nuestro sitio web.&lt;/a&gt; .&lt;/li&gt;
&lt;/ul&gt;

&lt;p style=&quot;line-height: 1.365; margin-right: 18px; margin-top: 16px;&quot;&gt;O&lt;/p&gt;

&lt;ul&gt;
	&lt;li aria-level=&quot;1&quot;&gt;Responda a este correo electr&amp;oacute;nico con la siguiente informaci&amp;oacute;n:
	&lt;ul&gt;
		&lt;li aria-level=&quot;2&quot;&gt;Nombre y apellido completos del estudiante&lt;/li&gt;
		&lt;li aria-level=&quot;2&quot;&gt;Fecha de nacimiento del estudiante (mes/d&amp;iacute;a/a&amp;ntilde;o)&lt;/li&gt;
		&lt;li aria-level=&quot;2&quot;&gt;Grado del estudiante para el ciclo 2027-2028&lt;/li&gt;
		&lt;li aria-level=&quot;2&quot;&gt;Direcci&amp;oacute;n completa del domicilio del estudiante&lt;/li&gt;
		&lt;li aria-level=&quot;2&quot;&gt;N&amp;uacute;mero de tel&amp;eacute;fono&lt;/li&gt;
		&lt;li aria-level=&quot;2&quot;&gt;Escuela(s) Zeta de preferencia&lt;/li&gt;
	&lt;/ul&gt;
	&lt;/li&gt;
&lt;/ul&gt;
&amp;nbsp;

&lt;p&gt;Si tiene alguna pregunta mientras &lt;a href=&quot;https://myportal.zetaschools.org/&quot;&gt;&amp;nbsp;completa su solicitud&lt;/a&gt;, comun&amp;iacute;quese con nosotros a &lt;a href=&quot;mailto:enroll@zetaschools.org&quot;&gt;enroll@zetaschools.org&lt;/a&gt; o ll&amp;aacute;menos al (646) 480-1654.&amp;nbsp;&lt;/p&gt;
&amp;nbsp;

&lt;p&gt;&amp;iexcl;Esperamos llegar a conocer a su familia!&amp;nbsp;&lt;/p&gt;

&lt;p style=&quot;line-height:1.365; margin-right:18px; margin-top:16px&quot;&gt;&lt;br /&gt;
Atentamente,&lt;br /&gt;
&lt;strong&gt;El equipo de admisiones de Zeta&lt;/strong&gt;&lt;br /&gt;
Zeta Charter Schools&lt;/p&gt;

