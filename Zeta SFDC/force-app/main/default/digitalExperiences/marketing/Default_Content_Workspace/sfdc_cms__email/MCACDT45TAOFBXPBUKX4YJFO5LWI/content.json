              "lightning:padding" : "{!$brand.spacing.none}",
              "lightning:typography" : "{!$brand.typography.paragraph.paragraph1}",
              "text" : "<span dir=\"ltr\" style=\"display: block;\">Zeta High students benefit from:<br /></span><ul dir=\"ltr\" style=\"display: block; padding-inline-start: 2.5rem; margin: 0.5rem 0px; list-style-position: outside; list-style-type: disc;\"><li style=\"display: list-item; margin: 0.35rem 0px;\"><strong>Advanced and AP courses</strong> that challenge them to reach their highest potential</li><li style=\"display: list-item; margin: 0.35rem 0px;\"><strong>Free SAT preparation, SAT School Day, and one-on-one college advising</strong></li><li style=\"display: list-item; margin: 0.35rem 0px;\">A dedicated <strong>Z Coach </strong>and<strong> </strong>close-knit <strong>Z House</strong> that provide guidance and belonging</li><li style=\"display: list-item; margin: 0.35rem 0px;\">Hands-on learning through <strong>Z Lab, internships, and Z Journeys</strong></li><li style=\"display: list-item; margin: 0.35rem 0px;\">Opportunities to explore their interests through <strong>Z Teams, Z Clubs, athletics, and the arts</strong></li><li style=\"display: list-item; margin: 0.35rem 0px;\">A <strong>tuition-free public charter education</strong> open to all students</li></ul>"
