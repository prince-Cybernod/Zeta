          "stackOnMobile" : true
        },
        "definition" : "lightning/section",
        "id" : "c07f380e-bc03-4a60-b5cb-215d99cb33f5",
        "type" : "block",
        "children" : [ {
          "attributes" : {
            "columnWidth" : 12.0,
            "lightning:backgroundImage" : {
              "position" : "center center",
              "repeat" : "no-repeat",
              "size" : "cover"
            },
            "lightning:borderRadius" : "{!$brand.borderRadius.square}",
            "lightning:borderWidth" : "{!$brand.borderWeight.none}",
            "lightning:colorScheme" : "{!$brand.colorScheme}",
            "lightning:margin" : "{!$brand.spacing.none}",
            "lightning:padding" : "{!$brand.spacing.xSmall}",
            "lightning:verticalAlignment" : "top"
          },
          "definition" : "lightning/column",
          "id" : "9af07a8f-aa74-4c30-aa64-58446531dbd5",
          "type" : "block",
          "children" : [ {
            "attributes" : {
              "align" : "start",
              "lightning:borderRadius" : "{!$brand.borderRadius.square}",
              "lightning:borderWidth" : "{!$brand.borderWeight.none}",
              "lightning:colorGroup" : {
                "backgroundColor" : "{!$brand.colorScheme.root}",
                "borderColor" : "{!$brand.colorScheme.neutral}",
                "linkColor" : "#0054A6",
                "textColor" : "{!$brand.colorScheme.contrast}"
              },
              "lightning:margin" : "{!$brand.spacing.none}",
              "lightning:padding" : "{!$brand.spacing.none}",
              "lightning:typography" : "{!$brand.typography.paragraph.paragraph1}",
              "text" : "<font face=\"Tahoma\">Our commitment is to provide your child with a world-class educational experience grounded in love, from pre-kindergarten through twelfth grade. That commitment shows up in the results: across Zeta's testing schools last year, 92% of students passed the New York State Math exams, with nearly half earning the highest score of 4. In English Language Arts, 86% passed—50 percentage points above local district averages and 36 percentage points above New York City's average. In Science, 92% passed, Zeta's strongest result since the state introduced its more rigorous next generation assessment. <br /><br />At Zeta Middle School, students prepare for high school by taking on advanced academics, discovering their interests, and taking greater ownership of their learning. They receive personalized support through daily advisory sessions, participate in programs including Taekwondo, soccer, music, and chess, and design, build, and experiment in Z Lab.<br /><br />Zeta eighth graders achieved a 97.5% pass rate on the Algebra I Regents and a 98.3% pass rate on the Biology Regents—exams New York students typically do not take until high school!<br /><br />These results are testament to what an education driven by love can achieve.<br /><br />In the months ahead, you will discover the many possibilities for your child at Zeta. <br /><br />To learn more, <a href=\"https://zetaschools.org/events-for-prospective-families/\" target=\"_blank\" part=\"link\" rel=\"noopener noreferrer noopener noreferrer noopener noreferrer\"><u>come visit us at Zeta</u></a>.<br /><br />I am thrilled to welcome you and your student into the Zeta community!<br /><br /><strong>With warmth &amp; gratitude,<br /><br />Emily Kim<br />Founder, CEO &amp; Zeta Mom<br />Zeta Charter Schools</strong><strong><br /></strong><br /><em></em><em>Please reach out if you have any questions about Zeta. Our Enrollment Team is here for you every step of the way:<br /></em>✉︎ <a href=\"mailto:enroll&#64;zetaschools.org\" target=\"_blank\" part=\"link\" rel=\"noopener noreferrer noopener noreferrer noopener noreferrer noopener noreferrer noopener noreferrer noopener noreferrer\"><u>enroll&#64;zetaschools.org</u></a><br />&#x1f4de;<a href=\"tel:16464801654\" target=\"_blank\" part=\"link\" rel=\"noopener noreferrer noopener noreferrer noopener noreferrer noopener noreferrer noopener noreferrer noopener noreferrer\">(646) 480-1654</a></font><a href=\"tel:16464801654\" target=\"_blank\" part=\"link\" rel=\"noopener noreferrer noopener noreferrer noopener noreferrer noopener noreferrer noopener noreferrer noopener noreferrer\"></a><br />"
            },
