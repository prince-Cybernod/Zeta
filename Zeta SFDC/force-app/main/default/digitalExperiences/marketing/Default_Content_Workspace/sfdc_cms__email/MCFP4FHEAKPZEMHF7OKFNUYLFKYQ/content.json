              },
              "text" : "&#x1f49c;<strong>&#x1faf6;<font face=\"Tahoma\">Will my child be known in a way that builds real confidence?</font></strong><br />"
            },
            "definition" : "lightning/paragraph",
            "id" : "0eb9ab09-9fc6-456c-a258-ec9e9fbdbbb6",
            "type" : "block"
          }, {
            "attributes" : {
              "align" : "start",
              "lightning:borderRadius" : "{!$brand.borderRadius.square}",
              "lightning:borderWidth" : "{!$brand.borderWeight.none}",
              "lightning:colorGroup" : {
                "backgroundColor" : "{!$brand.colorScheme.root}",
                "borderColor" : "{!$brand.colorScheme.neutral}",
                "linkColor" : "{!$brand.colorScheme.primaryAccent}",
                "textColor" : "{!$brand.colorScheme.contrast}"
              },
              "lightning:margin" : "{!$brand.spacing.none}",
              "lightning:padding" : "{!$brand.spacing.none}",
              "lightning:typography" : {
                "fontFamily" : "{!$cms.BrandonGrotesque_Medium}",
                "fontSize" : "{!$brand.fontSize.medium}",
                "fontWeight" : "{!$brand.fontWeight.normal}",
                "letterSpacing" : "normal",
                "lineHeight" : 1.5,
                "textTransform" : "none"
              },
              "text" : "<font face=\"Tahoma\">Young children need adults who notice when they need help, recognize what excites them, and celebrate their progress. At Zeta, teachers build close relationships with every student. Children also gather regularly with classmates and teachers to share, listen to one another, build friendships, and learn how to work through challenges together.</font><br /><br />"
            },
