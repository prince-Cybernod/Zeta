                "linkColor" : "{!$brand.colorScheme.primaryAccent}",
                "textColor" : "{!$brand.colorScheme.contrast}"
              },
              "lightning:margin" : "{!$brand.spacing.none}",
              "lightning:padding" : "{!$brand.spacing.none}",
              "lightning:typography" : {
                "fontFamily" : "{!$cms.BrandonGrotesque_Medium}",
                "fontSize" : "{!$brand.fontSize.medium}",
                "fontWeight" : "{!$brand.fontWeight.normal}",
                "letterSpacing" : "normal",
                "lineHeight" : 1.5,
                "textTransform" : "none"
              },
              "text" : "<font data-custom-font=\"{!$cms.BrandonGrotesque_Medium.name}\" face=\"Brandon Grotesque Medium, Arial, sans-serif, sans-serif\">Young children need adults who notice when they need help, recognize what excites them, and celebrate their progress. At Zeta, teachers build close relationships with every student. Children also gather regularly with classmates and teachers to share, listen to one another, build friendships, and learn how to work through challenges together.</font><br /><br />"
