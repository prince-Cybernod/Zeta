            "lightning:colorScheme" : "{!$brand.colorScheme}",
            "lightning:margin" : "{!$brand.spacing.none}",
            "lightning:padding" : "{!$brand.spacing.xSmall}",
            "lightning:verticalAlignment" : "top"
          },
          "definition" : "lightning/column",
          "id" : "54d7d0c6-9dc5-4d0c-81ce-324d3872cbfb",
          "type" : "block",
          "children" : [ {
            "attributes" : {
              "align" : "left",
              "lightning:borderRadius" : "{!$brand.borderRadius.square}",
              "lightning:borderWidth" : "{!$brand.borderWeight.none}",
              "lightning:colorGroup" : {
                "backgroundColor" : "{!$brand.colorScheme.root}",
                "borderColor" : "{!$brand.colorScheme.neutral}",
                "linkColor" : "{!$brand.colorScheme.primaryAccent}",
                "textColor" : "{!$brand.colorScheme.contrast}"
              },
              "lightning:margin" : "{!$brand.spacing.none}",
              "lightning:padding" : "{!$brand.spacing.none}",
              "lightning:typography" : "{!$brand.typography.paragraph.paragraph1}",
              "text" : "<strong>At Zeta</strong>, our next generation education model focuses on empowering the whole child. Students are exposed to rigorous academics, Specialties that range from chess to soccer, socio-emotional learning practices and all of that in partnership with families. Through it all, we remain committed to our core belief: <strong>every child deserves an extraordinary education driven by love.</strong><br /><br />At <strong>Zeta Elementary Schools, that starts with building a foundation for everything that comes nex</strong>t. Rigorous academics meet joyful, hands-on learning, while expert-led Specialties in art, music, chess, dance, sports, and more help children discover what they love and what they can do.<br /><br />In <strong>Z Labs, our state-of-the-art innovation centers, students learn by creating</strong>. They think like builders, scientists, and entrepreneurs, developing ideas and learning how to bring them to life. These experiences grow with students, all the way to developing and pitching ideas in high school.<br /><br />And the results speak for themselves:<strong> Zeta students rank among the very best in the state. Our results in Math, Science and ELA consistently meet or exceed New York State and NYC averages. </strong><br /><br />Elementary school is only the beginning.<br /><br />At Zeta Middle School, students build independence and discover more about who they are while taking on increasingly rigorous academics. Experiential journeys bridge classroom learning with real-life lessons. At Zeta High School, the focus expands to <strong>purpose, passion, and power</strong>, with college preparation and opportunities to experience the world beyond school through Z Journeys. Z Houses and small Z Pods (learning groups) create a strong sense of belonging along the way.<br /><br /><br />"
            },
            "definition" : "lightning/paragraph",
            "id" : "c185f74c-2ace-41a9-b6f1-193ca60db472",
            "type" : "block"
          } ]
