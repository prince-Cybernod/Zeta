<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Response_Past_Due__c</fullName>
    <description>Checks if response due date is past due</description>
    <formula>AND(
    NOT(ISBLANK(Response_Due_Date__c)),
    Response_Due_Date__c &lt; NOW()
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Response Past Due</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
