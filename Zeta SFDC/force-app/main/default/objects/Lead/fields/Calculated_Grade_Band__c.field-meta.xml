<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Calculated_Grade_Band__c</fullName>
    <description>Expected birthdate based on the Lead&apos;s Date of Birth</description>
    <externalId>false</externalId>
    <formula>CASE(
FLOOR( ( DATE(YEAR(TODAY()),12,31) -  Date_of_Birth__c  ) / 365.2425 ),
4, &quot;PK&quot;,
5, &quot;K&quot;,
6, &quot;1&quot;,
7, &quot;2&quot;,
8, &quot;3&quot;,
9, &quot;4&quot;,
10, &quot;5&quot;,
11, &quot;6&quot;,
12, &quot;7&quot;,
13, &quot;8&quot;,
14, &quot;9&quot;,
15, &quot;10&quot;,
16, &quot;11&quot;,
17, &quot;12&quot;,
/* Default when not matched */
IF(
FLOOR( ( DATE(YEAR(TODAY()),12,31) - Date_of_Birth__c) / 365.2425 ) &gt;= 18,
&quot;College&quot;,
&quot;N/A&quot;
)
)</formula>
    <inlineHelpText>Expected birthdate based on the Lead&apos;s Date of Birth</inlineHelpText>
    <label>Calculated Grade Band</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
