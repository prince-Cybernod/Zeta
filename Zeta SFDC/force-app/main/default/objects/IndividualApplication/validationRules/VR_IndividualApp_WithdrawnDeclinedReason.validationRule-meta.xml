<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_IndividualApp_WithdrawnDeclinedReason</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  ISPICKVAL(Status, &quot;Withdrawn/Declined&quot;),    
  ISPICKVAL(Withdrawn_Declined_Reason_Picklist__c, &quot;&quot;)
)</errorConditionFormula>
    <errorDisplayField>Withdrawn_Declined_Reason_Picklist__c</errorDisplayField>
    <errorMessage>Withdrawn/Declined Reason is required when Status is Withdrawn/Declined.</errorMessage>
</ValidationRule>
