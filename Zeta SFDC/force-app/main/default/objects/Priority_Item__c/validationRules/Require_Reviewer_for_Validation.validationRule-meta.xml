<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Reviewer_for_Validation</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISPICKVAL(Review_Status__c, &quot;Pending&quot;)),
    OR(
        ISBLANK(Validated_By__c),
        ISBLANK(Validated_On__c)
    )
)</errorConditionFormula>
    <errorDisplayField>Validated_By__c</errorDisplayField>
    <errorMessage>Validated By and Validated On must be completed when Review Status is not Pending</errorMessage>
</ValidationRule>
