<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>School_URL__c</fullName>
    <description>Clickable link to the related School Account from the School Application.</description>
    <externalId>false</externalId>
    <formula>IF(
  NOT(ISBLANK(LearningProgramId)),
  HYPERLINK(
    &quot;/&quot; &amp; LearningProgramId,
    LearningProgram.Name,
    &quot;_blank&quot;
  ),
  &quot;&quot;
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>School URL</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
