<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Network_IEP_Approval__c</fullName>
    <description>Captures the approval status of the student’s IEP from the network-level special services or enrollment review team. Used to indicate whether the IEP has been reviewed and approved by network staff, if the family declined the seat, or if network-level approval is not applicable for the student’s case.</description>
    <label>Network IEP Approval</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Not yet done</fullName>
                <default>true</default>
                <label>Not yet done</label>
            </value>
            <value>
                <fullName>Approved</fullName>
                <default>false</default>
                <label>Approved</label>
            </value>
            <value>
                <fullName>Family will decline seat</fullName>
                <default>false</default>
                <label>Family will decline seat</label>
            </value>
            <value>
                <fullName>N/A</fullName>
                <default>false</default>
                <label>N/A</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
